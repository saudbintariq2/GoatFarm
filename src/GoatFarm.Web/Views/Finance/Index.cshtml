@model GoatFarm.Application.ViewModels.Finance.FinancePageViewModel
@using GoatFarm.Application.Common
@using System.Globalization
@{ var incomeTypes = (string[])ViewBag.IncomeTypes!; var expenseTypes = (string[])ViewBag.ExpenseTypes!; var assetTypes = (string[])ViewBag.AssetTypes!; }

<div class="bignum @(Model.IsLoss ? "loss" : "")" id="profitBanner">
    <div><div class="lbl">Profit this month (income − running costs)</div>
        <div class="big" id="profitVal">@(Model.IsLoss ? "– " : "")@DisplayHelper.FormatRs(Math.Abs(Model.Profit))</div>
        <div class="lbl" id="profitNote">@Model.ProfitNote</div></div>
    <div class="side"><span class="lbl">Capital invested</span><b id="capSide">@DisplayHelper.FormatRs(Model.Capital)</b>
        <span class="lbl">goats + machinery + land</span></div>
</div>

<div class="filterbar" style="margin-bottom:14px">
    <div class="field"><label class="hide-sm">Month</label><input type="month" id="finMonth" value="@Model.Month"></div>
</div>

<div class="fin3">
    <div class="fincard"><div class="v" id="cIncome">@DisplayHelper.FormatRs(Model.TotalIncome)</div>
        <div class="k"><span class="dot" style="background:var(--green)"></span>Cash received this month</div></div>
    <div class="fincard"><div class="v" id="cExpense">@DisplayHelper.FormatRs(Model.TotalExpense)</div>
        <div class="k"><span class="dot" style="background:var(--red)"></span>Running costs this month</div></div>
    <div class="fincard"><div class="v" id="cCapital">@DisplayHelper.FormatRs(Model.Capital)</div>
        <div class="k"><span class="dot" style="background:var(--blue)"></span>Total capital (assets owned)</div></div>
    <div class="fincard"><div class="v" id="cOwner">@DisplayHelper.FormatRs(Model.OwnerInvestmentTotal)</div>
        <div class="k"><span class="dot" style="background:var(--amber)"></span>Your money put in (total)</div></div>
</div>

<div class="note"><b>Capital vs running cost:</b> things you <b>own</b> (goats you bought, machinery, land,
    sheds) are <b>capital</b> — added once. Things you <b>use up</b> each month (feed, salaries, cultivation)
    are <b>running costs</b>. Profit = cash received − running costs. Capital is your investment, kept separate.
    <b>Owner investment</b> is money you put in from your own pocket — it is not income and not profit.</div>

<div class="panel">
    <div class="panel-head"><h2 id="ownerFormTitle">Owner investment — money you put in</h2><span class="sub">your own money funding the farm</span></div>
    <div class="panel-body">
        <div class="note" style="margin:0 0 14px 0"><b>Keep this separate:</b> money you put in from your own
            pocket is <b>not income and not profit</b> — it's your investment keeping the farm going until it
            earns enough on its own. The card above shows the total you've put in so far.</div>
        <table class="tbl"><thead><tr><th>Note</th><th class="hide-sm">Date</th>
            <th class="num-cell">Amount</th></tr></thead>
            <tbody id="ownerRows">
            @if (Model.OwnerInvestments.Count == 0)
            {
                <tr class="owner-empty-row"><td colspan="3" class="empty">No money added this month.</td></tr>
            }
            @foreach (var o in Model.OwnerInvestments)
            {
                <tr class="fin-row fin-owner-row" data-id="@o.Id" data-note="@o.Note" data-date="@o.DateDisplay"
                    data-amount="@o.Amount.ToString(CultureInfo.InvariantCulture)">
                    <td><b>@o.Note</b></td>
                    <td class="hide-sm"><span class="breed">@o.DateDisplay</span></td>
                    <td class="num-cell">@DisplayHelper.FormatRs(o.Amount)</td>
                </tr>
            }
            <tr style="background:var(--amber-tint)"><td style="font-weight:800">PUT IN THIS MONTH</td><td class="hide-sm"></td>
                <td class="num-cell" style="font-weight:800;color:#8a5b13">@DisplayHelper.FormatRs(Model.OwnerInvestmentMonthTotal)</td></tr>
            <tr style="background:var(--amber-tint)"><td style="font-weight:800">TOTAL TO DATE</td><td class="hide-sm"></td>
                <td class="num-cell" style="font-weight:800;color:#8a5b13">@DisplayHelper.FormatRs(Model.OwnerInvestmentTotal)</td></tr>
            </tbody></table>
        <div class="add-grid" style="margin-top:14px;grid-template-columns:1fr 1fr">
            <div class="field field-comment"><label>Note</label><input id="o-note" placeholder="e.g. Monthly top-up"></div>
            <div class="field"><label>Date</label><input type="date" id="o-date" value="@DateTime.Today.ToString("yyyy-MM-dd")"></div>
            <div class="field"><label>Amount (Rs)</label><input type="number" id="o-amt" min="0"></div>
        </div>
        <div class="goat-form-actions">
            <div class="goat-form-actions-left">
                <button type="button" class="btn btn-green" id="addOwner">+ Add</button>
                <button type="button" class="btn btn-ghost" id="cancelOwnerBtn" style="display:none">Cancel</button>
            </div>
            <button type="button" class="btn btn-danger" id="deleteOwnerBtn" style="display:none">Delete</button>
        </div>
    </div>
</div>

<div class="panel">
    <div class="panel-head"><h2 id="assetFormTitle">Capital — what the farm owns</h2><span class="sub">added once, not monthly</span></div>
    <div class="panel-body">
        <table class="tbl"><thead><tr><th>Asset</th><th class="hide-sm">Type</th>
            <th class="num-cell">Value</th></tr></thead>
            <tbody id="assetRows">
            <tr><td><b>Livestock (goats)</b><div class="name">@Model.BoughtGoatCount bought · auto from herd</div></td>
                <td class="hide-sm"><span class="chip chip-cap">Livestock</span></td>
                <td class="num-cell">@DisplayHelper.FormatRs(Model.LivestockValue)</td></tr>
            @foreach (var a in Model.Assets)
            {
                <tr class="fin-row fin-asset-row" data-id="@a.Id" data-name="@a.Name" data-type="@a.Type"
                    data-cost="@a.Cost.ToString(CultureInfo.InvariantCulture)" data-comment="@a.Comment">
                    <td>@a.Name@if(!string.IsNullOrEmpty(a.Comment)){<div class="name">@a.Comment</div>}</td>
                    <td class="hide-sm"><span class="chip chip-cap">@a.Type</span></td>
                    <td class="num-cell">@DisplayHelper.FormatRs(a.Cost)</td>
                </tr>
            }
            <tr style="background:var(--blue-tint)"><td style="font-weight:800">TOTAL CAPITAL</td>
                <td class="hide-sm"></td><td class="num-cell" style="font-weight:800">@DisplayHelper.FormatRs(Model.Capital)</td></tr>
            </tbody></table>
        <div class="add-grid" style="margin-top:14px;grid-template-columns:2fr 1fr 1fr">
            <div class="field"><label>Asset name</label><input id="a-name" placeholder="e.g. Chaff cutter"></div>
            <div class="field"><label>Type</label><select id="a-type" data-lookup="Lookup.AssetTypes">@foreach(var t in assetTypes){<option>@t</option>}</select></div>
            <div class="field"><label>Cost (Rs)</label><input type="number" id="a-cost" min="0"></div>
            <div class="field field-comment"><label>Comment</label><input id="a-comment" placeholder="optional"></div>
        </div>
        <div class="goat-form-actions">
            <div class="goat-form-actions-left">
                <button type="button" class="btn btn-green" id="addAsset">+ Add</button>
                <button type="button" class="btn btn-ghost" id="cancelAssetBtn" style="display:none">Cancel</button>
            </div>
            <button type="button" class="btn btn-danger" id="deleteAssetBtn" style="display:none">Delete</button>
        </div>
    </div>
</div>

<div class="panel">
    <div class="panel-head"><h2 id="incomeFormTitle">Cash received</h2><span class="sub">milk, meat, ghee, paneer, sales</span></div>
    <div class="panel-body">
        <table class="tbl"><thead><tr><th>Source</th><th class="hide-sm">Date</th>
            <th class="num-cell">Amount</th></tr></thead>
            <tbody id="incomeRows">
            <tr><td><span class="chip chip-inc">Milk sales</span><div class="name">@Model.MilkLitersSold.ToString("N0") L · auto from Milk tab</div></td>
                <td class="hide-sm"><span class="breed">this month</span></td>
                <td class="num-cell">@DisplayHelper.FormatRs(Model.MilkIncome)</td></tr>
            @foreach (var i in Model.Incomes)
            {
                <tr class="fin-row fin-income-row" data-id="@i.Id" data-type="@i.Type" data-date="@i.DateDisplay"
                    data-amount="@i.Amount.ToString(CultureInfo.InvariantCulture)" data-comment="@i.Comment">
                    <td><span class="chip chip-inc">@i.Type</span>@if(!string.IsNullOrEmpty(i.Comment)){<div class="name">@i.Comment</div>}</td>
                    <td class="hide-sm"><span class="breed">@i.DateDisplay</span></td>
                    <td class="num-cell">@DisplayHelper.FormatRs(i.Amount)</td>
                </tr>
            }
            <tr style="background:var(--green-tint)"><td style="font-weight:800">TOTAL RECEIVED</td><td class="hide-sm"></td>
                <td class="num-cell" style="font-weight:800;color:var(--green-dark)">@DisplayHelper.FormatRs(Model.TotalIncome)</td></tr>
            </tbody></table>
        <div class="add-grid" style="margin-top:14px;grid-template-columns:2fr 1fr 1fr">
            <div class="field"><label>Source</label><select id="i-type" data-lookup="Lookup.IncomeTypes">@foreach(var t in incomeTypes){<option>@t</option>}</select></div>
            <div class="field"><label>Date</label><input type="date" id="i-date" value="@DateTime.Today.ToString("yyyy-MM-dd")"></div>
            <div class="field"><label>Amount (Rs)</label><input type="number" id="i-amt" min="0"></div>
            <div class="field field-comment"><label>Comment</label><input id="i-comment" placeholder="optional"></div>
        </div>
        <div class="goat-form-actions">
            <div class="goat-form-actions-left">
                <button type="button" class="btn btn-green" id="addIncome">+ Add</button>
                <button type="button" class="btn btn-ghost" id="cancelIncomeBtn" style="display:none">Cancel</button>
            </div>
            <button type="button" class="btn btn-danger" id="deleteIncomeBtn" style="display:none">Delete</button>
        </div>
    </div>
</div>

<div class="panel">
    <div class="panel-head"><h2 id="empFormTitle">Employees &amp; salaries</h2><span class="sub">counted in running costs every month</span></div>
    <div class="panel-body">
        <div class="note" style="margin:0 0 14px 0">Add each worker and their monthly salary. Edit a salary any
            time — just type the new number. The total is added to your running costs automatically each month.</div>
        <table class="tbl"><thead><tr><th>Name</th><th class="hide-sm">Role</th>
            <th class="num-cell">Monthly salary</th></tr></thead>
            <tbody id="empRows">
            @foreach (var e in Model.Employees)
            {
                <tr class="fin-row fin-emp-row" data-id="@e.Id" data-name="@e.Name" data-role="@e.Role"
                    data-salary="@e.MonthlySalary.ToString(CultureInfo.InvariantCulture)">
                    <td><b>@e.Name</b></td>
                    <td class="hide-sm"><span class="breed">@(e.Role ?? "—")</span></td>
                    <td class="num-cell">
                        <span class="pre" style="color:var(--ink-soft);font-size:12px">Rs</span>
                        <input type="number" min="0" data-empsal="@e.Id" value="@e.MonthlySalary.ToString("0.##", CultureInfo.InvariantCulture)"
                            style="width:96px;text-align:right;font-family:inherit;font-size:14px;padding:5px 7px;border:1px solid var(--line);border-radius:7px;font-variant-numeric:tabular-nums">
                    </td>
                </tr>
            }
            @if (!Model.Employees.Any()) {<tr class="emp-empty-row"><td colspan="3" class="empty">No staff added yet.</td></tr>}
            <tr style="background:var(--red-tint)"><td style="font-weight:800">TOTAL / MONTH</td><td class="hide-sm"></td>
                <td class="num-cell" style="font-weight:800;color:#8a261c" id="empTotal">@DisplayHelper.FormatRs(Model.StaffSalaryMonthly)</td></tr>
            </tbody></table>
        <div class="add-grid" style="margin-top:14px;grid-template-columns:1.4fr 1.2fr 1fr">
            <div class="field"><label>Name</label><input id="emp-name" placeholder="e.g. Aslam"></div>
            <div class="field"><label>Role (optional)</label><input id="emp-role" placeholder="e.g. Herd worker"></div>
            <div class="field"><label>Monthly salary (Rs)</label><input type="number" id="emp-salary" min="0"></div>
        </div>
        <div class="goat-form-actions">
            <div class="goat-form-actions-left">
                <button type="button" class="btn btn-green" id="addEmp">+ Add</button>
                <button type="button" class="btn btn-ghost" id="cancelEmpBtn" style="display:none">Cancel</button>
            </div>
            <button type="button" class="btn btn-danger" id="deleteEmpBtn" style="display:none">Delete</button>
        </div>
    </div>
</div>

<div class="panel">
    <div class="panel-head"><h2 id="recurFormTitle">Fixed &amp; recurring costs</h2><span class="sub">rent and fixed costs — spread into monthly running costs (salaries come from Employees)</span></div>
    <div class="panel-body">
        <table class="tbl"><thead><tr><th>Cost</th><th class="hide-sm">Period</th>
            <th class="num-cell">Amount</th><th class="num-cell">Per month</th></tr></thead>
            <tbody id="recurRows">
            @foreach (var r in Model.RecurringCosts)
            {
                <tr class="fin-row fin-recur-row" data-id="@r.Id" data-name="@r.Name"
                    data-amount="@r.Amount.ToString(CultureInfo.InvariantCulture)" data-period="@r.Period">
                    <td><b>@r.Name</b></td>
                    <td class="hide-sm"><span class="breed">@r.Period</span></td>
                    <td class="num-cell">@DisplayHelper.FormatRs(r.Amount)</td>
                    <td class="num-cell">@DisplayHelper.FormatRs(r.MonthlyAmount)</td>
                </tr>
            }
            @if (!Model.RecurringCosts.Any()) {<tr class="recur-empty-row"><td colspan="4" class="empty">No recurring costs set up.</td></tr>}
            <tr style="background:var(--red-tint)"><td style="font-weight:800">TOTAL / MONTH</td><td class="hide-sm"></td>
                <td class="num-cell"></td><td class="num-cell" style="font-weight:800;color:#8a261c">@DisplayHelper.FormatRs(Model.RecurringMonthly)</td></tr>
            </tbody></table>
        <div class="add-grid" style="margin-top:14px;grid-template-columns:2fr 1fr 1fr">
            <div class="field"><label>Name</label><input id="rc-name" placeholder="e.g. Land rent"></div>
            <div class="field"><label>Amount (Rs)</label><input type="number" id="rc-amt" min="0"></div>
            <div class="field"><label>Period</label><select id="rc-period"><option value="month">Monthly</option><option value="year">Yearly</option></select></div>
        </div>
        <div class="goat-form-actions">
            <div class="goat-form-actions-left">
                <button type="button" class="btn btn-green" id="addRecur">+ Add</button>
                <button type="button" class="btn btn-ghost" id="cancelRecurBtn" style="display:none">Cancel</button>
            </div>
            <button type="button" class="btn btn-danger" id="deleteRecurBtn" style="display:none">Delete</button>
        </div>
    </div>
</div>

<div class="panel">
    <div class="panel-head"><h2 id="expenseFormTitle">Running costs</h2><span class="sub">cultivation, feed bought, medicine, vaccines — salaries come from Employees</span></div>
    <div class="panel-body">
        <table class="tbl"><thead><tr><th>Cost</th><th class="hide-sm">Date</th>
            <th class="num-cell">Amount</th></tr></thead>
            <tbody id="expenseRows">
            <tr><td><span class="chip chip-exp">Feed bought</span><div class="name">@Model.FeedBoughtKg.ToString("N1") kg · auto from Feed tab</div></td>
                <td class="hide-sm"><span class="breed">this month</span></td>
                <td class="num-cell">@DisplayHelper.FormatRs(Model.FeedBoughtMonthly)</td></tr>
            <tr><td><span class="chip chip-exp">Medicine (plan)</span><div class="name">from feed plan estimate</div></td>
                <td class="hide-sm"><span class="breed">every month</span></td>
                <td class="num-cell">@DisplayHelper.FormatRs(Model.MedicineMonthly)</td></tr>
            <tr><td><span class="chip chip-exp">Staff salaries</span><div class="name">@Model.Employees.Count staff · from roster</div></td>
                <td class="hide-sm"><span class="breed">every month</span></td>
                <td class="num-cell" id="expStaffSal">@DisplayHelper.FormatRs(Model.StaffSalaryMonthly)</td></tr>
            <tr><td><span class="chip chip-exp">Recurring costs</span><div class="name">rent, fixed costs, etc.</div></td>
                <td class="hide-sm"><span class="breed">every month</span></td>
                <td class="num-cell">@DisplayHelper.FormatRs(Model.RecurringMonthly)</td></tr>
            <tr><td><span class="chip chip-exp">Vaccines bought</span><div class="name">auto from Vaccines tab</div></td>
                <td class="hide-sm"><span class="breed">this month</span></td>
                <td class="num-cell">@DisplayHelper.FormatRs(Model.VaccineBoughtMonthly)</td></tr>
            @foreach (var e in Model.Expenses)
            {
                <tr class="fin-row fin-expense-row" data-id="@e.Id" data-type="@e.Type" data-date="@e.DateDisplay"
                    data-amount="@e.Amount.ToString(CultureInfo.InvariantCulture)" data-comment="@e.Comment">
                    <td><span class="chip chip-exp">@e.Type</span>@if (SalaryExpenseRules.Classify(e.Type) != SalaryExpenseKind.None)
                        {<span class="chip chip-legacy" title="Salary types are no longer accepted as expenses — see the salary check below">old type · may be counted twice</span>}@if(!string.IsNullOrEmpty(e.Comment)){<div class="name">@e.Comment</div>}</td>
                    <td class="hide-sm"><span class="breed">@e.DateDisplay</span></td>
                    <td class="num-cell">@DisplayHelper.FormatRs(e.Amount)</td>
                </tr>
            }
            <tr style="background:var(--red-tint)"><td style="font-weight:800">TOTAL COSTS</td><td class="hide-sm"></td>
                <td class="num-cell" style="font-weight:800;color:#8a261c">@DisplayHelper.FormatRs(Model.TotalExpense)</td></tr>
            </tbody></table>
        <div class="add-grid" style="margin-top:14px;grid-template-columns:2fr 1fr 1fr">
            <div class="field"><label>Cost type</label><select id="e-type" data-lookup="Lookup.ExpenseTypes">@foreach(var t in expenseTypes){<option>@t</option>}</select></div>
            <div class="field"><label>Date</label><input type="date" id="e-date" value="@DateTime.Today.ToString("yyyy-MM-dd")"></div>
            <div class="field"><label>Amount (Rs)</label><input type="number" id="e-amt" min="0"></div>
            <div class="field field-comment"><label>Comment</label><input id="e-comment" placeholder="optional"></div>
        </div>
        <div class="goat-form-actions">
            <div class="goat-form-actions-left">
                <button type="button" class="btn btn-green" id="addExpense">+ Add</button>
                <button type="button" class="btn btn-ghost" id="cancelExpenseBtn" style="display:none">Cancel</button>
            </div>
            <button type="button" class="btn btn-danger" id="deleteExpenseBtn" style="display:none">Delete</button>
        </div>
    </div>
</div>

@{ var recon = (GoatFarm.Application.ViewModels.Finance.SalaryReconciliationViewModel)ViewBag.SalaryReconciliation!; }
@if (!recon.HasFindings)
{
<div class="panel" id="salaryReconciliationEmpty">
    <div class="panel-head"><h2>Salary check</h2><span class="sub">read-only · nothing is changed automatically</span></div>
    <div class="panel-body">
        <div class="alldone">No salary-type expenses or recurring costs were found. New salary advances are blocked because salaries already come from Employees.</div>
    </div>
</div>
}
@if (recon.HasFindings)
{
<div class="panel" id="salaryReconciliation">
    <div class="panel-head"><h2>Salary check</h2><span class="sub">read-only · nothing is changed automatically</span></div>
    <div class="panel-body">
        <div class="note" style="margin-top:0">Staff salaries are counted every month from the Employees list
            (@recon.EmployeeCount staff, @DisplayHelper.FormatRs(recon.AutoSalaryMonthly) a month, at today's salaries).
            The entries below look like salary or advance payments, so the totals may count the same money twice.
            <b>Counted twice:</b> @DisplayHelper.FormatRs(recon.ConfirmedTotal) ·
            <b>Needs review:</b> @DisplayHelper.FormatRs(recon.NeedsReviewTotal) ·
            <b>Not counted twice:</b> @DisplayHelper.FormatRs(recon.NotDoubleCountedTotal)
            @if (recon.RecurringFlaggedMonthly > 0) {<text> · <b>Recurring salary costs:</b> @DisplayHelper.FormatRs(recon.RecurringFlaggedMonthly) every month</text>}</div>
        <table class="tbl"><thead><tr><th>Entry</th><th class="hide-sm">Date</th><th>Finding</th><th class="num-cell">Amount</th></tr></thead>
            <tbody id="salaryReconRows">
            @foreach (var r in recon.Rows)
            {
                <tr data-outcome="@r.Outcome" data-source="@r.Source" data-id="@r.Id">
                    <td><span class="chip chip-exp">@r.Type</span><div class="name">@r.Source@(string.IsNullOrEmpty(r.Comment) ? "" : " · " + r.Comment)</div></td>
                    <td class="hide-sm"><span class="breed">@r.DateDisplay</span></td>
                    <td><b>@r.OutcomeLabel</b><div class="name">@r.Reason</div></td>
                    <td class="num-cell">@DisplayHelper.FormatRs(r.Amount)</td>
                </tr>
            }
            </tbody></table>
        <div class="rule" style="margin-top:10px">To correct an entry that is counted twice, the owner can delete it above
            (export a backup first — deleting removes the record). Entries marked "Needs review" must be checked by hand.
            A correction that keeps the record but leaves it out of totals needs the accounting ledger, which is not built yet.</div>
    </div>
</div>
}

@{
    var ledger = ViewBag.LedgerPage as GoatFarm.Application.ViewModels.Ledger.LedgerPageViewModel;
    var statements = ViewBag.Statements as GoatFarm.Application.ViewModels.Ledger.FinancialStatementsViewModel;
}
@if (ledger is not null)
{
<div class="panel" style="margin-top:18px">
    <div class="panel-head"><h2>Accounting ledger</h2><span class="sub">AR/AP, cash flow, budget, profit sharing</span></div>
    <div class="panel-body">
        <div class="fin3">
            <div class="fincard"><div class="v">@DisplayHelper.FormatRs(ledger.Receivables)</div><div class="k">Receivables</div></div>
            <div class="fincard"><div class="v">@DisplayHelper.FormatRs(ledger.Payables)</div><div class="k">Payables</div></div>
            <div class="fincard"><div class="v">@DisplayHelper.FormatRs(ledger.CashOnHand)</div><div class="k">Cash accounts</div></div>
            @if (statements is not null)
            {
                <div class="fincard"><div class="v">@DisplayHelper.FormatRs(statements.NetProfit)</div><div class="k">P&amp;L (month)</div></div>
            }
        </div>
        <div class="tabs" id="ledger-tabs" style="margin-top:14px">
            <button type="button" class="tab active" data-ledger-tab="summary">Summary</button>
            <button type="button" class="tab" data-ledger-tab="accounts">Accounts &amp; tx</button>
            <button type="button" class="tab" data-ledger-tab="receivables">Receivables</button>
            <button type="button" class="tab" data-ledger-tab="payables">Payables</button>
            <button type="button" class="tab" data-ledger-tab="budget">Budget</button>
            <button type="button" class="tab" data-ledger-tab="profit">Profit share</button>
        </div>
        <div data-ledger-pane="summary">
            @if (statements is not null)
            {
                <table class="tbl" style="margin-top:12px"><thead><tr><th>Cash flow (month)</th><th class="num-cell">Amount</th></tr></thead>
                <tbody>
                    <tr><td>Cash in (ledger)</td><td class="num-cell">@DisplayHelper.FormatRs(statements.CashIn)</td></tr>
                    <tr><td>Cash out (ledger)</td><td class="num-cell">@DisplayHelper.FormatRs(statements.CashOut)</td></tr>
                    <tr><td>Revenue (farm + ledger)</td><td class="num-cell">@DisplayHelper.FormatRs(statements.Revenue)</td></tr>
                    <tr><td>Expenses</td><td class="num-cell">@DisplayHelper.FormatRs(statements.Expenses)</td></tr>
                    <tr style="background:var(--green-tint)"><td style="font-weight:800">Net profit</td><td class="num-cell" style="font-weight:800">@DisplayHelper.FormatRs(statements.NetProfit)</td></tr>
                    <tr><td>Assets (est.)</td><td class="num-cell">@DisplayHelper.FormatRs(statements.AssetsTotal)</td></tr>
                    <tr><td>Liabilities (AP)</td><td class="num-cell">@DisplayHelper.FormatRs(statements.LiabilitiesTotal)</td></tr>
                </tbody></table>
            }
        </div>
        <div data-ledger-pane="accounts" hidden>
            <table class="tbl" style="margin-top:12px"><thead><tr><th>Account</th><th>Type</th><th class="num-cell">Balance</th></tr></thead>
            <tbody>@foreach(var a in ledger.Accounts){<tr><td>@a.Name</td><td>@a.Kind</td><td class="num-cell">@DisplayHelper.FormatRs(a.Balance)</td></tr>}</tbody></table>
            <h3 style="margin:16px 0 8px">Recent transactions</h3>
            <table class="tbl"><thead><tr><th>Date</th><th>Kind</th><th>Account</th><th class="num-cell">Amount</th><th>Category</th></tr></thead>
            <tbody>@foreach(var t in ledger.Transactions){<tr><td>@t.DateDisplay</td><td>@t.Kind</td><td>@t.Account</td><td class="num-cell">@DisplayHelper.FormatRs(t.Amount)</td><td>@t.Category</td></tr>}</tbody></table>
            <div class="add-grid" style="margin-top:12px;grid-template-columns:repeat(5,1fr)">
                <div class="field"><label>Date</label><input type="date" id="tx-date" value="@DateTime.Today.ToString("yyyy-MM-dd")"></div>
                <div class="field"><label>Kind</label><select id="tx-kind"><option value="Income">Income</option><option value="Expense">Expense</option><option value="InvoicePayment">Invoice payment</option><option value="PayablePayment">Payable payment</option></select></div>
                <div class="field"><label>Account</label><select id="tx-account">@foreach(var a in ledger.Accounts){<option value="@a.Id">@a.Name</option>}</select></div>
                <div class="field"><label>Amount</label><input type="number" id="tx-amt" min="0"></div>
                <div class="field"><label>Category</label><input id="tx-cat"></div>
                <div class="field field-comment"><label>Notes</label><input id="tx-note"></div>
            </div>
            <button type="button" class="btn btn-green" id="tx-save">Post transaction</button>
        </div>
        <div data-ledger-pane="receivables" hidden>
            <div class="add-grid" style="margin-top:12px;grid-template-columns:2fr 1fr 1fr auto">
                <div class="field"><label>New customer</label><input id="cust-name" placeholder="Shop name"></div>
                <div class="field"><label>Phone</label><input id="cust-phone"></div>
                <button type="button" class="btn btn-ghost" id="cust-save" style="align-self:end">Add customer</button>
            </div>
            <table class="tbl" style="margin-top:12px"><thead><tr><th>Customer</th><th>Date</th><th>Description</th><th class="num-cell">Due</th><th>Status</th></tr></thead>
            <tbody>@foreach(var i in ledger.Invoices){<tr><td>@i.Customer</td><td>@i.DateDisplay</td><td>@i.Description</td><td class="num-cell">@DisplayHelper.FormatRs(i.Amount - i.PaidAmount)</td><td>@i.Status</td></tr>}</tbody></table>
            <div class="add-grid" style="margin-top:12px;grid-template-columns:repeat(6,1fr)">
                <div class="field"><label>Customer</label><select id="inv-customer"><option value="">—</option>@foreach(var c in ledger.Customers){<option value="@c.Id">@c.Name</option>}</select></div>
                <div class="field"><label>Date</label><input type="date" id="inv-date" value="@DateTime.Today.ToString("yyyy-MM-dd")"></div>
                <div class="field"><label>Due</label><input type="date" id="inv-due" value="@DateTime.Today.AddDays(14).ToString("yyyy-MM-dd")"></div>
                <div class="field"><label>Description</label><input id="inv-desc"></div>
                <div class="field"><label>Amount</label><input type="number" id="inv-amt" min="0"></div>
                <div class="field"><label>Paid</label><input type="number" id="inv-paid" min="0" value="0"></div>
            </div>
            <button type="button" class="btn btn-green" id="inv-save">Add invoice</button>
        </div>
        <div data-ledger-pane="payables" hidden>
            <table class="tbl" style="margin-top:12px"><thead><tr><th>Supplier</th><th>Date</th><th>Description</th><th class="num-cell">Due</th><th>Status</th></tr></thead>
            <tbody>@foreach(var p in ledger.PayablesList){<tr><td>@p.SupplierName</td><td>@p.DateDisplay</td><td>@p.Description</td><td class="num-cell">@DisplayHelper.FormatRs(p.Amount - p.PaidAmount)</td><td>@p.Status</td></tr>}</tbody></table>
            <div class="add-grid" style="margin-top:12px;grid-template-columns:repeat(5,1fr)">
                <div class="field"><label>Supplier</label><input id="pay-supplier"></div>
                <div class="field"><label>Date</label><input type="date" id="pay-date" value="@DateTime.Today.ToString("yyyy-MM-dd")"></div>
                <div class="field"><label>Due</label><input type="date" id="pay-due" value="@DateTime.Today.AddDays(14).ToString("yyyy-MM-dd")"></div>
                <div class="field"><label>Description</label><input id="pay-desc"></div>
                <div class="field"><label>Amount</label><input type="number" id="pay-amt" min="0"></div>
                <div class="field"><label>Paid</label><input type="number" id="pay-paid" min="0" value="0"></div>
            </div>
            <button type="button" class="btn btn-green" id="pay-save">Add payable</button>
        </div>
        <div data-ledger-pane="budget" hidden>
            <table class="tbl" style="margin-top:12px"><thead><tr><th>Year</th><th>Month</th><th>Category</th><th class="num-cell">Planned</th></tr></thead>
            <tbody>@foreach(var b in ledger.Budget){<tr><td>@b.Year</td><td>@b.Month</td><td>@b.Category</td><td class="num-cell">@DisplayHelper.FormatRs(b.PlannedAmount)</td></tr>}</tbody></table>
            <div class="add-grid" style="margin-top:12px;grid-template-columns:2fr 1fr auto">
                <div class="field"><label>Category</label><input id="bud-cat" placeholder="Feed, salaries…"></div>
                <div class="field"><label>Planned (Rs)</label><input type="number" id="bud-amt" min="0"></div>
                <button type="button" class="btn btn-green" id="bud-save" style="align-self:end">Add budget line</button>
            </div>
        </div>
        <div data-ledger-pane="profit" hidden>
            <table class="tbl" style="margin-top:12px"><thead><tr><th>Partner</th><th class="num-cell">Share %</th></tr></thead>
            <tbody>@foreach(var p in ledger.Partners){<tr><td>@p.Name</td><td class="num-cell">@p.SharePercent</td></tr>}</tbody></table>
            <div class="add-grid" style="margin-top:12px;grid-template-columns:2fr 1fr auto">
                <div class="field"><label>Name</label><input id="part-name"></div>
                <div class="field"><label>Share %</label><input type="number" id="part-pct" min="0" max="100" step="0.1"></div>
                <button type="button" class="btn btn-green" id="part-save" style="align-self:end">Add partner</button>
            </div>
        </div>
    </div>
</div>
}

@section Scripts {
<script src="~/js/finance-ledger.js" asp-append-version="true"></script>
<script>GoatRecords.initFinance();</script>
}
