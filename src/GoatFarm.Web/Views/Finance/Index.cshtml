@model GoatFarm.Application.ViewModels.Finance.FinancePageViewModel
@using GoatFarm.Application.Common
@using System.Globalization
@{ var incomeTypes = (string[])ViewBag.IncomeTypes!; var expenseTypes = (string[])ViewBag.ExpenseTypes!; var assetTypes = (string[])ViewBag.AssetTypes!; }

<div class="bignum @(Model.IsLoss ? "loss" : "")" id="profitBanner">
    <div><div class="lbl">Profit this month (income − running costs)</div>
        <div class="big" id="profitVal">@(Model.IsLoss ? "– " : "")@DisplayHelper.FormatRs(Math.Abs(Model.Profit))</div>
        <div class="lbl" id="profitNote">@Model.ProfitNote</div></div>
    <div class="side"><span class="lbl">Capital invested</span><b id="capSide">@DisplayHelper.FormatRs(Model.Capital)</b>
        <span class="lbl">goats + machinery + land</span></div>
</div>

<div class="filterbar" style="margin-bottom:14px">
    <div class="field"><label class="hide-sm">Month</label><input type="month" id="finMonth" value="@Model.Month"></div>
</div>

<div class="fin3">
    <div class="fincard"><div class="v" id="cIncome">@DisplayHelper.FormatRs(Model.TotalIncome)</div>
        <div class="k"><span class="dot" style="background:var(--green)"></span>Cash received this month</div></div>
    <div class="fincard"><div class="v" id="cExpense">@DisplayHelper.FormatRs(Model.TotalExpense)</div>
        <div class="k"><span class="dot" style="background:var(--red)"></span>Running costs this month</div></div>
    <div class="fincard"><div class="v" id="cCapital">@DisplayHelper.FormatRs(Model.Capital)</div>
        <div class="k"><span class="dot" style="background:var(--blue)"></span>Total capital (assets owned)</div></div>
    <div class="fincard"><div class="v" id="cOwner">@DisplayHelper.FormatRs(Model.OwnerInvestmentTotal)</div>
        <div class="k"><span class="dot" style="background:var(--amber)"></span>Your money put in (total)</div></div>
</div>

<div class="note"><b>Capital vs running cost:</b> things you <b>own</b> (goats you bought, machinery, land,
    sheds) are <b>capital</b> — added once. Things you <b>use up</b> each month (feed, salaries, cultivation)
    are <b>running costs</b>. Profit = cash received − running costs. Capital is your investment, kept separate.
    <b>Owner investment</b> is money you put in from your own pocket — it is not income and not profit.</div>

<div class="panel">
    <div class="panel-head"><h2 id="ownerFormTitle">Owner investment — money you put in</h2><span class="sub">your own money funding the farm</span></div>
    <div class="panel-body">
        <div class="note" style="margin:0 0 14px 0"><b>Keep this separate:</b> money you put in from your own
            pocket is <b>not income and not profit</b> — it's your investment keeping the farm going until it
            earns enough on its own. The card above shows the total you've put in so far.</div>
        <table class="tbl"><thead><tr><th>Note</th><th class="hide-sm">Date</th>
            <th class="num-cell">Amount</th></tr></thead>
            <tbody id="ownerRows">
            @if (Model.OwnerInvestments.Count == 0)
            {
                <tr class="owner-empty-row"><td colspan="3" class="empty">No money added this month.</td></tr>
            }
            @foreach (var o in Model.OwnerInvestments)
            {
                <tr class="fin-row fin-owner-row" data-id="@o.Id" data-note="@o.Note" data-date="@o.DateDisplay"
                    data-amount="@o.Amount.ToString(CultureInfo.InvariantCulture)">
                    <td><b>@o.Note</b></td>
                    <td class="hide-sm"><span class="breed">@o.DateDisplay</span></td>
                    <td class="num-cell">@DisplayHelper.FormatRs(o.Amount)</td>
                </tr>
            }
            <tr style="background:var(--amber-tint)"><td style="font-weight:800">PUT IN THIS MONTH</td><td class="hide-sm"></td>
                <td class="num-cell" style="font-weight:800;color:#8a5b13">@DisplayHelper.FormatRs(Model.OwnerInvestmentMonthTotal)</td></tr>
            <tr style="background:var(--amber-tint)"><td style="font-weight:800">TOTAL TO DATE</td><td class="hide-sm"></td>
                <td class="num-cell" style="font-weight:800;color:#8a5b13">@DisplayHelper.FormatRs(Model.OwnerInvestmentTotal)</td></tr>
            </tbody></table>
        <div class="add-grid" style="margin-top:14px;grid-template-columns:1fr 1fr">
            <div class="field field-comment"><label>Note</label><input id="o-note" placeholder="e.g. Monthly top-up"></div>
            <div class="field"><label>Date</label><input type="date" id="o-date" value="@DateTime.Today.ToString("yyyy-MM-dd")"></div>
            <div class="field"><label>Amount (Rs)</label><input type="number" id="o-amt" min="0"></div>
        </div>
        <div class="goat-form-actions">
            <div class="goat-form-actions-left">
                <button type="button" class="btn btn-green" id="addOwner">+ Add</button>
                <button type="button" class="btn btn-ghost" id="cancelOwnerBtn" style="display:none">Cancel</button>
            </div>
            <button type="button" class="btn btn-danger" id="deleteOwnerBtn" style="display:none">Delete</button>
        </div>
    </div>
</div>

<div class="panel">
    <div class="panel-head"><h2 id="assetFormTitle">Capital — what the farm owns</h2><span class="sub">added once, not monthly</span></div>
    <div class="panel-body">
        <table class="tbl"><thead><tr><th>Asset</th><th class="hide-sm">Type</th>
            <th class="num-cell">Value</th></tr></thead>
            <tbody id="assetRows">
            <tr><td><b>Livestock (goats)</b><div class="name">@Model.BoughtGoatCount bought · auto from herd</div></td>
                <td class="hide-sm"><span class="chip chip-cap">Livestock</span></td>
                <td class="num-cell">@DisplayHelper.FormatRs(Model.LivestockValue)</td></tr>
            @foreach (var a in Model.Assets)
            {
                <tr class="fin-row fin-asset-row" data-id="@a.Id" data-name="@a.Name" data-type="@a.Type"
                    data-cost="@a.Cost.ToString(CultureInfo.InvariantCulture)" data-comment="@a.Comment">
                    <td>@a.Name@if(!string.IsNullOrEmpty(a.Comment)){<div class="name">@a.Comment</div>}</td>
                    <td class="hide-sm"><span class="chip chip-cap">@a.Type</span></td>
                    <td class="num-cell">@DisplayHelper.FormatRs(a.Cost)</td>
                </tr>
            }
            <tr style="background:var(--blue-tint)"><td style="font-weight:800">TOTAL CAPITAL</td>
                <td class="hide-sm"></td><td class="num-cell" style="font-weight:800">@DisplayHelper.FormatRs(Model.Capital)</td></tr>
            </tbody></table>
        <div class="add-grid" style="margin-top:14px;grid-template-columns:2fr 1fr 1fr">
            <div class="field"><label>Asset name</label><input id="a-name" placeholder="e.g. Chaff cutter"></div>
            <div class="field"><label>Type</label><select id="a-type" data-lookup="Lookup.AssetTypes">@foreach(var t in assetTypes){<option>@t</option>}</select></div>
            <div class="field"><label>Cost (Rs)</label><input type="number" id="a-cost" min="0"></div>
            <div class="field field-comment"><label>Comment</label><input id="a-comment" placeholder="optional"></div>
        </div>
        <div class="goat-form-actions">
            <div class="goat-form-actions-left">
                <button type="button" class="btn btn-green" id="addAsset">+ Add</button>
                <button type="button" class="btn btn-ghost" id="cancelAssetBtn" style="display:none">Cancel</button>
            </div>
            <button type="button" class="btn btn-danger" id="deleteAssetBtn" style="display:none">Delete</button>
        </div>
    </div>
</div>

<div class="panel">
    <div class="panel-head"><h2 id="incomeFormTitle">Cash received</h2><span class="sub">milk, meat, ghee, paneer, sales</span></div>
    <div class="panel-body">
        <table class="tbl"><thead><tr><th>Source</th><th class="hide-sm">Date</th>
            <th class="num-cell">Amount</th></tr></thead>
            <tbody id="incomeRows">
            <tr><td><span class="chip chip-inc">Milk sales</span><div class="name">@Model.MilkLitersSold.ToString("N0") L · auto from Milk tab</div></td>
                <td class="hide-sm"><span class="breed">this month</span></td>
                <td class="num-cell">@DisplayHelper.FormatRs(Model.MilkIncome)</td></tr>
            @foreach (var i in Model.Incomes)
            {
                <tr class="fin-row fin-income-row" data-id="@i.Id" data-type="@i.Type" data-date="@i.DateDisplay"
                    data-amount="@i.Amount.ToString(CultureInfo.InvariantCulture)" data-comment="@i.Comment">
                    <td><span class="chip chip-inc">@i.Type</span>@if(!string.IsNullOrEmpty(i.Comment)){<div class="name">@i.Comment</div>}</td>
                    <td class="hide-sm"><span class="breed">@i.DateDisplay</span></td>
                    <td class="num-cell">@DisplayHelper.FormatRs(i.Amount)</td>
                </tr>
            }
            <tr style="background:var(--green-tint)"><td style="font-weight:800">TOTAL RECEIVED</td><td class="hide-sm"></td>
                <td class="num-cell" style="font-weight:800;color:var(--green-dark)">@DisplayHelper.FormatRs(Model.TotalIncome)</td></tr>
            </tbody></table>
        <div class="add-grid" style="margin-top:14px;grid-template-columns:2fr 1fr 1fr">
            <div class="field"><label>Source</label><select id="i-type" data-lookup="Lookup.IncomeTypes">@foreach(var t in incomeTypes){<option>@t</option>}</select></div>
            <div class="field"><label>Date</label><input type="date" id="i-date" value="@DateTime.Today.ToString("yyyy-MM-dd")"></div>
            <div class="field"><label>Amount (Rs)</label><input type="number" id="i-amt" min="0"></div>
            <div class="field field-comment"><label>Comment</label><input id="i-comment" placeholder="optional"></div>
        </div>
        <div class="goat-form-actions">
            <div class="goat-form-actions-left">
                <button type="button" class="btn btn-green" id="addIncome">+ Add</button>
                <button type="button" class="btn btn-ghost" id="cancelIncomeBtn" style="display:none">Cancel</button>
            </div>
            <button type="button" class="btn btn-danger" id="deleteIncomeBtn" style="display:none">Delete</button>
        </div>
    </div>
</div>

<div class="panel">
    <div class="panel-head"><h2 id="recurFormTitle">Fixed &amp; recurring costs</h2><span class="sub">rent, salaries — spread into monthly running costs</span></div>
    <div class="panel-body">
        <table class="tbl"><thead><tr><th>Cost</th><th class="hide-sm">Period</th>
            <th class="num-cell">Amount</th><th class="num-cell">Per month</th></tr></thead>
            <tbody id="recurRows">
            @foreach (var r in Model.RecurringCosts)
            {
                <tr class="fin-row fin-recur-row" data-id="@r.Id" data-name="@r.Name"
                    data-amount="@r.Amount.ToString(CultureInfo.InvariantCulture)" data-period="@r.Period">
                    <td><b>@r.Name</b></td>
                    <td class="hide-sm"><span class="breed">@r.Period</span></td>
                    <td class="num-cell">@DisplayHelper.FormatRs(r.Amount)</td>
                    <td class="num-cell">@DisplayHelper.FormatRs(r.MonthlyAmount)</td>
                </tr>
            }
            @if (!Model.RecurringCosts.Any()) {<tr class="recur-empty-row"><td colspan="4" class="empty">No recurring costs set up.</td></tr>}
            <tr style="background:var(--red-tint)"><td style="font-weight:800">TOTAL / MONTH</td><td class="hide-sm"></td>
                <td class="num-cell"></td><td class="num-cell" style="font-weight:800;color:#8a261c">@DisplayHelper.FormatRs(Model.RecurringMonthly)</td></tr>
            </tbody></table>
        <div class="add-grid" style="margin-top:14px;grid-template-columns:2fr 1fr 1fr">
            <div class="field"><label>Name</label><input id="rc-name" placeholder="e.g. Land rent"></div>
            <div class="field"><label>Amount (Rs)</label><input type="number" id="rc-amt" min="0"></div>
            <div class="field"><label>Period</label><select id="rc-period"><option value="month">Monthly</option><option value="year">Yearly</option></select></div>
        </div>
        <div class="goat-form-actions">
            <div class="goat-form-actions-left">
                <button type="button" class="btn btn-green" id="addRecur">+ Add</button>
                <button type="button" class="btn btn-ghost" id="cancelRecurBtn" style="display:none">Cancel</button>
            </div>
            <button type="button" class="btn btn-danger" id="deleteRecurBtn" style="display:none">Delete</button>
        </div>
    </div>
</div>

<div class="panel">
    <div class="panel-head"><h2 id="expenseFormTitle">Running costs</h2><span class="sub">salaries, cultivation, feed bought, medicine, vaccines</span></div>
    <div class="panel-body">
        <table class="tbl"><thead><tr><th>Cost</th><th class="hide-sm">Date</th>
            <th class="num-cell">Amount</th></tr></thead>
            <tbody id="expenseRows">
            <tr><td><span class="chip chip-exp">Feed bought</span><div class="name">@Model.FeedBoughtKg.ToString("N1") kg · auto from Feed tab</div></td>
                <td class="hide-sm"><span class="breed">this month</span></td>
                <td class="num-cell">@DisplayHelper.FormatRs(Model.FeedBoughtMonthly)</td></tr>
            <tr><td><span class="chip chip-exp">Medicine (plan)</span><div class="name">from feed plan estimate</div></td>
                <td class="hide-sm"><span class="breed">every month</span></td>
                <td class="num-cell">@DisplayHelper.FormatRs(Model.MedicineMonthly)</td></tr>
            <tr><td><span class="chip chip-exp">Recurring costs</span><div class="name">rent, salaries, etc.</div></td>
                <td class="hide-sm"><span class="breed">every month</span></td>
                <td class="num-cell">@DisplayHelper.FormatRs(Model.RecurringMonthly)</td></tr>
            <tr><td><span class="chip chip-exp">Vaccines bought</span><div class="name">auto from Vaccines tab</div></td>
                <td class="hide-sm"><span class="breed">this month</span></td>
                <td class="num-cell">@DisplayHelper.FormatRs(Model.VaccineBoughtMonthly)</td></tr>
            @foreach (var e in Model.Expenses)
            {
                <tr class="fin-row fin-expense-row" data-id="@e.Id" data-type="@e.Type" data-date="@e.DateDisplay"
                    data-amount="@e.Amount.ToString(CultureInfo.InvariantCulture)" data-comment="@e.Comment">
                    <td><span class="chip chip-exp">@e.Type</span>@if(!string.IsNullOrEmpty(e.Comment)){<div class="name">@e.Comment</div>}</td>
                    <td class="hide-sm"><span class="breed">@e.DateDisplay</span></td>
                    <td class="num-cell">@DisplayHelper.FormatRs(e.Amount)</td>
                </tr>
            }
            <tr style="background:var(--red-tint)"><td style="font-weight:800">TOTAL COSTS</td><td class="hide-sm"></td>
                <td class="num-cell" style="font-weight:800;color:#8a261c">@DisplayHelper.FormatRs(Model.TotalExpense)</td></tr>
            </tbody></table>
        <div class="add-grid" style="margin-top:14px;grid-template-columns:2fr 1fr 1fr">
            <div class="field"><label>Cost type</label><select id="e-type" data-lookup="Lookup.ExpenseTypes">@foreach(var t in expenseTypes){<option>@t</option>}</select></div>
            <div class="field"><label>Date</label><input type="date" id="e-date" value="@DateTime.Today.ToString("yyyy-MM-dd")"></div>
            <div class="field"><label>Amount (Rs)</label><input type="number" id="e-amt" min="0"></div>
            <div class="field field-comment"><label>Comment</label><input id="e-comment" placeholder="optional"></div>
        </div>
        <div class="goat-form-actions">
            <div class="goat-form-actions-left">
                <button type="button" class="btn btn-green" id="addExpense">+ Add</button>
                <button type="button" class="btn btn-ghost" id="cancelExpenseBtn" style="display:none">Cancel</button>
            </div>
            <button type="button" class="btn btn-danger" id="deleteExpenseBtn" style="display:none">Delete</button>
        </div>
    </div>
</div>

@section Scripts {<script>GoatRecords.initFinance();</script>}
