</nav>

<!-- ============ RECORD MILKING ============ -->
<section class="panel sl-sub" data-sl-sub-pane="milking">
<div class="panel-head"><h2>Record milking</h2><span class="sub">one entry per milking — the usable litres go straight into the tank</span></div>
<div class="panel-body">
<div class="sl-grid sl-grid-3">
  <div class="field"><label for="mp-date">Date</label><input type="date" id="mp-date"></div>
  <div class="field"><label for="mp-session">Milking</label><select id="mp-session"></select></div>
  <div class="field"><label for="mp-warehouse">Put the milk into</label><select id="mp-warehouse"></select></div>
</div>
<div class="sl-howto">
  <span class="sl-howto-l">How will you count the milk?</span>
  <div class="sl-seg" role="radiogroup" aria-label="Counting method">
    <button type="button" role="radio" data-sl-mode="breed">By breed</button>
    <button type="button" role="radio" data-sl-mode="goat">Goat by goat</button>
    <button type="button" role="radio" data-sl-mode="total">One total</button>
  </div>
</div>

<div data-sl-mode-pane="breed">
  <p class="sl-hint">One line per breed. All lines together make this one milking. Leave “Goats” blank to use the number of milking goats of that breed in the Herd.</p>
  <div class="table-wrap"><table class="tbl sl-entry-tbl"><thead><tr><th>Breed</th><th class="num-cell">Goats</th><th class="num-cell">Milk (L)</th><th class="num-cell">Rejected (L)</th><th class="num-cell">Usable</th><th></th></tr></thead><tbody id="sl-mg-breed-rows"></tbody></table></div>
  <div class="sl-row-actions"><button type="button" class="btn btn-ghost btn-sm" id="sl-mg-add-breed">+ Add breed</button></div>
</div>
<div data-sl-mode-pane="goat" hidden>
  <p class="sl-hint">Every goat marked “milking” in the Herd is listed. Type her litres; leave blank if not milked. Totals per breed are worked out for you.</p>
  <div class="sl-goat-tools"><input id="sl-mg-goat-find" list="sl-mg-goat-tags" placeholder="Scan or type a tag to add a goat" autocomplete="off"><datalist id="sl-mg-goat-tags"></datalist><button type="button" class="btn btn-ghost btn-sm" id="sl-mg-goat-add">+ Add goat</button></div>
  <div class="table-wrap"><table class="tbl sl-entry-tbl"><thead><tr><th>Goat</th><th>Breed</th><th class="num-cell">Milk (L)</th><th class="num-cell">Rejected (L)</th><th></th></tr></thead><tbody id="sl-mg-goat-rows"></tbody></table></div>
</div>
<div data-sl-mode-pane="total" hidden>
  <div class="sl-grid sl-grid-3">
    <div class="field"><label for="mp-goats">Goats milked</label><input type="number" id="mp-goats" min="0" step="1"></div>
    <div class="field"><label for="mp-total">Milk (L)</label><input type="number" id="mp-total" min="0" step="0.1" inputmode="decimal"></div>
    <div class="field"><label for="mp-reject">Rejected (L)</label><input type="number" id="mp-reject" min="0" step="0.1" value="0" inputmode="decimal"></div>
  </div>
</div>
<div class="sl-total-bar" id="sl-mg-summary" aria-live="polite"></div>
<div class="sl-grid sl-grid-3"><div class="field sl-span-2"><label for="mp-note">Note</label><input id="mp-note" placeholder="milker, smell / colour check, reason for rejected milk"></div><div class="field"><label>&nbsp;</label><button class="btn btn-green sl-btn-wide" id="sl-mg-save" data-needs="milk:create">Save milking</button></div></div>

<div class="sl-day">
  <div class="sl-day-h"><h3>Milking on <span id="sl-mg-day-label"></span></h3><span id="sl-mg-day-total"></span></div>
  <div class="table-wrap"><table class="tbl"><thead><tr><th>Milking</th><th>Counted</th><th class="num-cell">Goats</th><th class="num-cell">Milk</th><th class="num-cell">Rejected</th><th class="num-cell">Usable</th><th>Tank</th><th class="hide-sm">By</th><th></th></tr></thead><tbody id="sl-mg-day-rows"></tbody></table></div>
</div>
</div></section>

<!-- ============ PASTEURIZE ============ -->
<section class="panel sl-sub" data-sl-sub-pane="pasteurize" hidden>
<div class="panel-head"><h2>Pasteurize</h2><span class="sub">raw tank → pasteurizer → pasteurized tank</span></div>
<div class="panel-body">
<div class="sl-move">
  <div class="sl-move-side raw"><label for="sl-pz-src">From raw tank</label><select id="sl-pz-src"></select><div class="sl-move-bal" id="sl-pz-src-bal"></div></div>
  <div class="sl-move-mid">
    <div class="field"><label for="sl-pz-in">Raw milk taken (L)</label><div class="sl-inline"><input type="number" id="sl-pz-in" min="0" step="0.1" inputmode="decimal"><button type="button" class="btn btn-ghost btn-sm" id="sl-pz-all">All</button></div></div>
    <div class="sl-move-arrow" aria-hidden="true">🔥 ➜</div>
    <div class="field"><label for="sl-pz-out">Pasteurized milk obtained (L)</label><input type="number" id="sl-pz-out" min="0" step="0.1" inputmode="decimal"></div>
  </div>
  <div class="sl-move-side past"><label for="sl-pz-dst">Into pasteurized tank</label><select id="sl-pz-dst"></select><div class="sl-move-bal" id="sl-pz-dst-bal"></div></div>
</div>
<div class="sl-preview" id="sl-pz-preview" aria-live="polite"></div>
<div class="sl-grid">
<div class="field"><label for="sl-pz-date">Date</label><input type="date" id="sl-pz-date"></div>
<div class="field"><label for="sl-pz-temp">Heated to (°C)</label><input type="number" id="sl-pz-temp" step="0.1" placeholder="e.g. 72"></div>
<div class="field"><label for="sl-pz-cool">Cooled to (°C)</label><input type="number" id="sl-pz-cool" step="0.1" placeholder="e.g. 4"></div>
<div class="field"><label for="sl-pz-ref">Run no.</label><input id="sl-pz-ref" placeholder="automatic"></div>
</div>
<details class="sl-more"><summary>Cost of this run (optional)</summary><div class="sl-grid sl-grid-3">
<div class="field"><label for="sl-pz-cost">Gas / power / labour (Rs)</label><input type="number" id="sl-pz-cost" min="0" step="1"></div>
<div class="field"><label for="sl-pz-acct">Paid from</label><select id="sl-pz-acct"></select></div>
<div class="field"><label for="sl-pz-note">Note</label><input id="sl-pz-note" placeholder="operator, remarks"></div>
</div></details>
<label class="sl-check"><input type="checkbox" id="sl-pz-qc"> Pasteurization and cooling are done and this milk passed the check. <small>Milk that failed goes to Spoilage, not into the pasteurized tank.</small></label>
<div class="sl-submit"><button class="btn btn-green" id="sl-pz-save" data-needs="milk:create">Save pasteurization</button></div>
</div></section>

<!-- ============ MOVE MILK ============ -->
<section class="panel sl-sub" data-sl-sub-pane="move" hidden>
<div class="panel-head"><h2>Move milk between tanks</h2><span class="sub">raw → raw, pasteurized → pasteurized</span></div>
<div class="panel-body">
<div class="sl-move">
  <div class="sl-move-side" id="sl-mv-from-box"><label for="sl-mvm-from">From tank</label><select id="sl-mvm-from"></select><div class="sl-move-bal" id="sl-mvm-from-bal"></div></div>
  <div class="sl-move-mid">
    <div class="field"><label for="sl-mvm-qty">Litres to move</label><div class="sl-inline"><input type="number" id="sl-mvm-qty" min="0" step="0.1" inputmode="decimal"><button type="button" class="btn btn-ghost btn-sm" id="sl-mvm-all">All</button></div></div>
    <div class="sl-move-arrow" aria-hidden="true">➜</div>
  </div>
  <div class="sl-move-side" id="sl-mv-to-box"><label for="sl-mvm-to">To tank</label><select id="sl-mvm-to"></select><div class="sl-move-bal" id="sl-mvm-to-bal"></div></div>
</div>
<div class="sl-grid sl-grid-3">
<div class="field"><label for="sl-mvm-date">Date</label><input type="date" id="sl-mvm-date"></div>
<div class="field sl-span-2"><label for="sl-mvm-note">Note</label><input id="sl-mvm-note" placeholder="why it was moved (tank cleaning, full tank…)"></div>
</div>
<div class="sl-submit"><button class="btn btn-green" id="sl-mvm-save" data-needs="milk:create">Move milk</button></div>
<p class="sl-hint">Raw and pasteurized milk are never mixed: a raw tank only sends to another raw tank. To turn raw milk into pasteurized milk, use Pasteurize.</p>
</div></section>

<!-- ============ BOTTLES & PRODUCTS ============ -->
<section class="sl-sub" data-sl-sub-pane="make" hidden>
<div class="panel">
<div class="panel-head"><h2>Bottle milk or make a product</h2><span class="sub">milk comes out of a tank · finished product goes into the cold store</span></div>
<div class="panel-body">
<div class="sl-move">
  <div class="sl-move-side"><label for="sl-mk-src">Take milk from</label><select id="sl-mk-src"></select><div class="sl-move-bal" id="sl-mk-src-bal"></div></div>
  <div class="sl-move-mid">
    <div class="field"><label for="sl-mk-in">Milk used (L)</label><input type="number" id="sl-mk-in" min="0" step="0.1" inputmode="decimal"></div>
    <div class="sl-move-arrow" aria-hidden="true">🍼 ➜</div>
  </div>
  <div class="sl-move-side prod">
    <label for="sl-mk-prod">Product made</label><select id="sl-mk-prod"></select>
    <div class="field"><label for="sl-mk-out">How many made (<span id="sl-mk-unit">units</span>)</label><input type="number" id="sl-mk-out" min="0" step="1" inputmode="decimal"></div>
    <div class="sl-move-bal" id="sl-mk-expect"></div>
  </div>
</div>
<div class="sl-preview" id="sl-mk-preview" aria-live="polite"></div>
<div class="sl-grid">
<div class="field"><label for="sl-mk-date">Date</label><input type="date" id="sl-mk-date"></div>
<div class="field"><label for="sl-mk-dst">Store in</label><select id="sl-mk-dst"></select></div>
<div class="field"><label for="sl-mk-exp">Use by</label><input type="date" id="sl-mk-exp"></div>
<div class="field"><label for="sl-mk-heat">Heat treatment</label><select id="sl-mk-heat"><option value="pasteurized-source">Made from pasteurized milk</option><option value="heat-in-process">Heated during this process</option><option value="raw-product">Raw-milk product (no heat)</option></select></div>
</div>
<details class="sl-more"><summary>Costs of this batch (optional)</summary><div class="sl-grid">
<div class="field"><label for="sl-mk-pack">Bottles / caps / labels (Rs)</label><input type="number" id="sl-mk-pack" min="0" step="1"></div>
<div class="field"><label for="sl-mk-ingr">Cultures / ingredients (Rs)</label><input type="number" id="sl-mk-ingr" min="0" step="1"></div>
<div class="field"><label for="sl-mk-proc">Processing / labour (Rs)</label><input type="number" id="sl-mk-proc" min="0" step="1"></div>
<div class="field"><label for="sl-mk-acct">Paid from</label><select id="sl-mk-acct"></select></div>
<div class="field"><label for="sl-mk-lot">Lot no.</label><input id="sl-mk-lot" placeholder="automatic"></div>
<div class="field sl-span-3"><label for="sl-mk-note">Note</label><input id="sl-mk-note" placeholder="optional"></div>
</div></details>
<div class="sl-submit"><button class="btn btn-green" id="sl-mk-save" data-needs="milk:create">Save production</button></div>
</div></div>
<div class="panel"><div class="panel-head"><h2>Bottles &amp; products in the cold store</h2><span class="sub">finished goods ready to sell · they come only from “Bottle milk or make a product”</span></div><div class="panel-body"><div class="sl-prod-cards" id="sl-dairy-cards"></div></div></div>
</section>

<!-- ============ SPOILAGE ============ -->
<section class="panel sl-sub" data-sl-sub-pane="spoil" hidden>
<div class="panel-head"><h2>Spoilage &amp; corrections</h2><span class="sub">milk or products that went bad, spilled, or a tank count that is different</span></div>
<div class="panel-body">
<div class="sl-grid">
<div class="field"><label for="sl-sp2-date">Date</label><input type="date" id="sl-sp2-date"></div>
<div class="field"><label for="sl-sp2-item">What</label><select id="sl-sp2-item"></select></div>
<div class="field"><label for="sl-sp2-dir">Change</label><select id="sl-sp2-dir"><option value="out">Remove (spoiled / spilled / failed)</option><option value="in">Add (count found more)</option></select></div>
<div class="field"><label for="sl-sp2-qty">Quantity (<span id="sl-sp2-unit">L</span>)</label><input type="number" id="sl-sp2-qty" min="0" step="0.1" inputmode="decimal"></div>
<div class="field"><label for="sl-sp2-reason">Reason</label><select id="sl-sp2-reason"><option>Spoiled / soured</option><option>Spilled / leaked</option><option>Failed quality check</option><option>Expired</option><option>Fed to kids</option><option>Stock count correction</option><option>Other</option></select></div>
<div class="field sl-span-3"><label for="sl-sp2-note">Note</label><input id="sl-sp2-note" placeholder="what happened"></div>
</div>
<div class="sl-preview" id="sl-sp2-preview"></div>
<div class="sl-submit"><button class="btn btn-green" id="sl-sp2-save" data-needs="milk:create">Save</button></div>
</div></section>

<!-- ============ TANKS & STORES ============ -->
<section class="sl-sub" data-sl-sub-pane="tanks" hidden>
<div class="panel"><div class="panel-head"><h2>Tanks &amp; cold stores</h2><span class="sub">rename, set capacity and temperature, add more</span></div><div class="panel-body">
<div class="sl-tank-admin" id="sl-tank-admin"></div>
<div class="sl-row-actions">
<button type="button" class="btn btn-ghost btn-sm" data-sl-addloc="raw_tank">+ Add raw milk tank</button>
<button type="button" class="btn btn-ghost btn-sm" data-sl-addloc="past_tank">+ Add pasteurized tank</button>
<button type="button" class="btn btn-ghost btn-sm" data-sl-addloc="dairy_store">+ Add cold store for products</button>
</div>
<p class="sl-hint">Renaming keeps all history. A tank that still holds milk can be switched off but not deleted.</p>
</div></div>
</section>

<!-- ============ RECORDS ============ -->
<section class="sl-sub" data-sl-sub-pane="records" hidden>
<div class="panel"><div class="panel-head"><h2>Milk &amp; dairy movements</h2><span class="sub">every litre in and out, newest first</span></div><div class="panel-body table-wrap"><table class="tbl sl-moves"><thead><tr><th>Date</th><th>Operation</th><th>What moved</th><th class="hide-sm">By</th><th></th></tr></thead><tbody id="sl-milk-moves"></tbody></table></div></div>
<div class="panel"><div class="panel-head"><h3>Milk by breed</h3><span class="sub">daily and monthly</span></div><div class="panel-body"><div class="sl-grid sl-grid-3" style="margin-bottom:12px"><div class="field"><label for="mp-report-date">Report date</label><input type="date" id="mp-report-date"/></div><div class="field"><label for="mp-report-breed">Breed</label><select id="mp-report-breed"><option value="">All breeds</option></select></div></div><div id="mp-breed-report"></div></div></div>
<div class="panel"><div class="panel-head"><h3>All milkings</h3><span class="sub">delete a wrong entry here — its litres are taken back out of the tank</span></div><div class="panel-body table-wrap"><table class="tbl"><thead><tr><th>Date</th><th>Session</th><th class="num-cell">Goats</th><th class="num-cell">Total L</th><th class="num-cell">Rejected</th><th class="num-cell">Usable L</th><th class="hide-sm">Tank</th><th></th></tr></thead><tbody id="milkingSessionRows"></tbody></table></div></div>
<details class="panel sl-details" id="sl-old-entries"><summary>Older single milk entries (before sessions)</summary><div class="panel-body table-wrap"><table class="tbl"><thead><tr><th>Date</th><th class="hide-sm">Breed</th><th class="num-cell">Litres</th><th class="hide-sm">Comment</th><th style="width:30px"></th></tr></thead><tbody id="prodRows"></tbody></table></div></details>
</section>
</div>

<div class="prod-pane" data-ppane="performance" id="breedPerformancePane">
<div class="section-intro"><div><span class="prod-badge">FARM ANALYTICS</span><h2>Breed Performance — Milk &amp; Meat</h2><p>Compare breed production using recorded milk, live-goat sales and carcass intake. No duplicate inventory or accounting entries.</p></div></div>
<div class="panel"><div class="panel-body" style="display:flex;gap:14px;flex-wrap:wrap;align-items:end">
<div class="field"><label>Month</label><input type="month" id="bp-month"></div>
<div class="field"><label>Breed</label><select id="bp-breed"><option value="">All breeds</option></select></div>
<div class="field"><label>Result</label><select id="bp-mode"><option value="milk">🥛 Milk performance</option><option value="meat">🥩 Meat performance</option></select></div>
<div class="field"><label>&nbsp;</label><button type="button" class="btn btn-ghost btn-sm" id="bp-export">Export CSV</button></div>
</div></div>
<div id="bp-kpis" class="product-kpi-grid" style="margin-bottom:16px"></div>
<div class="panel"><div class="panel-head"><h2 id="bp-chart-title">Milk by breed</h2><span class="sub">Recorded data only · no estimated production</span></div><div class="panel-body"><div id="bp-chart"></div></div></div>
<div class="panel"><div class="panel-head"><h2>Breed comparison</h2><span class="sub">Month selected above</span></div><div class="panel-body table-wrap" id="bp-table"></div></div>
<div class="note" id="bp-methodology"></div>
</div>

<div class="prod-pane" data-ppane="meat">
<div class="section-intro"><div><span class="prod-badge meat">MEAT LINE</span><h2>Meat</h2><p>Live goat → slaughter → whole carcass → halves or cuts → sale. Carcasses are kept by actual weight and count, never as 1 kg packs.</p></div></div>
<div class="sl-kpis" id="sl-meat-kpis"></div>
<div class="sl-flow sl-flow-4" id="sl-meat-flow"></div>
<div class="sl-actions" role="toolbar" aria-label="Meat operations">
  <button type="button" class="sl-act active" data-sl-action="slaughter"><b>1</b> Slaughter / carcass in</button>
  <button type="button" class="sl-act" data-sl-action="split"><b>2</b> Split into halves</button>
  <button type="button" class="sl-act" data-sl-action="cut"><b>3</b> Cut into pieces</button>
  <button type="button" class="sl-act" data-sl-sell="whole"><b>₨</b> Sell carcass</button>
  <button type="button" class="sl-act" data-sl-sell="cut"><b>₨</b> Sell cuts</button>
</div>

<section class="panel sl-form" data-sl-form="slaughter">
<div class="panel-head"><h2>Slaughter / carcass intake</h2><span class="sub">one goat → one carcass batch</span></div>
<div class="panel-body">
<div class="sl-grid">
<div class="field"><label for="sl-sg-date">Date</label><input type="date" id="sl-sg-date"></div>
<div class="field"><label for="sl-sg-tag">Goat tag</label><input id="sl-sg-tag" list="sl-sg-tags" autocomplete="off" placeholder="scan or type tag"><datalist id="sl-sg-tags"></datalist></div>
<div class="field sl-wide"><label>Herd check</label><div class="sl-lookup" id="sl-sg-lookup">Scan or type the goat tag.</div></div>
<div class="field"><label for="sl-sg-live">Live weight (kg)</label><input type="number" id="sl-sg-live" min="0" step="0.1"></div>
<div class="field"><label for="sl-sg-kg">Carcass weight (kg)</label><input type="number" id="sl-sg-kg" min="0" step="0.01"></div>
<div class="field"><label for="sl-sg-store">Hang in</label><select id="sl-sg-store"></select></div>
<div class="field"><label for="sl-sg-acost">Animal cost (Rs)</label><input type="number" id="sl-sg-acost" min="0" step="1" placeholder="auto from herd"></div>
<div class="field"><label for="sl-sg-fee">Slaughter fee (Rs)</label><input type="number" id="sl-sg-fee" min="0" step="1"></div>
<div class="field"><label for="sl-sg-labour">Butcher labour (Rs)</label><input type="number" id="sl-sg-labour" min="0" step="1"></div>
<div class="field"><label for="sl-sg-other">Other costs (Rs)</label><input type="number" id="sl-sg-other" min="0" step="1" placeholder="transport, ice…"></div>
<div class="field"><label for="sl-sg-acct">Paid from</label><select id="sl-sg-acct"></select></div>
<div class="field sl-wide"><label for="sl-sg-note">Note</label><input id="sl-sg-note" placeholder="vet check, by-products kept…"></div>
</div>
<label class="sl-check"><input type="checkbox" id="sl-sg-herd" checked> Remove this goat from the live herd (marked “slaughtered”)</label>
<div class="sl-submit"><button class="btn btn-green" id="sl-sg-save" data-needs="milk:create">Save carcass</button></div>
<p class="sub">Animal cost is for cost-per-kg only — the goat was already paid for and fed through Accounting, so it is not booked as a new expense. Fees and labour you enter here are posted once to Accounting.</p>
</div></section>

<section class="panel sl-form" data-sl-form="split" hidden>
<div class="panel-head"><h2>Split a whole carcass into two halves</h2><span class="sub">weight and cost carried over exactly</span></div>
<div class="panel-body">
<div class="sl-grid">
