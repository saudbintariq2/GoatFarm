  <button type="button" role="tab" data-sl-sub="milking"><span>🥛</span>Record milking</button>
  <button type="button" role="tab" data-sl-sub="pasteurize"><span>🔥</span>Pasteurize</button>
  <button type="button" role="tab" data-sl-sub="move"><span>⇄</span>Move milk</button>
  <button type="button" role="tab" data-sl-sub="make"><span>🍼</span>Bottles &amp; products</button>
  <button type="button" role="tab" data-sl-sub="spoil"><span>⚠</span>Spoilage</button>
  <button type="button" role="tab" data-sl-sub="tanks"><span>🛢</span>Tanks &amp; stores</button>
  <button type="button" role="tab" data-sl-sub="records"><span>📋</span>Milk records</button>
