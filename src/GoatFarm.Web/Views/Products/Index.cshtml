@model GoatFarm.Application.ViewModels.Products.ProductsPageViewModel
@using GoatFarm.Application.Common
@using System.Text.Json

@section Head {
    <link rel="stylesheet" href="~/css/products.css" asp-append-version="true" />
}

<div id="view-milk">
    @await Html.PartialAsync("_ProductsShell")
</div>

<script type="application/json" id="products-page-json">@Html.Raw(JsonSerializer.Serialize(new {
    month = Model.Month,
    stockValue = Model.StockValue,
    monthSalesTotal = Model.MonthSalesTotal,
    milkInTanksLiters = Model.MilkInTanksLiters,
    catalog = Model.Catalog,
    warehouses = Model.Warehouses,
    customers = Model.Customers,
    sessions = Model.Sessions,
    slaughters = Model.Slaughters,
    sales = Model.Sales,
    movements = Model.Movements,
    milk = Model.Milk,
    meat = Model.Meat,
    customMilkingSessions = Model.CustomMilkingSessions,
    recentSessions = Model.RecentSessions,
    herdGoats = Model.HerdGoats,
    moneyAccounts = Model.MoneyAccounts,
    legacyMilkEntries = Model.LegacyMilkEntries
}, new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase }))</script>

@section Scripts {
    <script src="~/js/products-module.js" asp-append-version="true"></script>
}
