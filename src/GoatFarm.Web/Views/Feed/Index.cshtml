@model GoatFarm.Application.ViewModels.Feed.FeedPageViewModel
@using GoatFarm.Application.Common
@using System.Globalization

<div id="view-feed">
<div class="bignum">
    <div><div class="lbl">Feed cost per day</div><div class="big" id="grandDay">@DisplayHelper.FormatRs(Model.GrandDaily)</div>
        <div class="lbl" id="grandHead">@Model.GrandHeadText</div></div>
    <div class="side">
        <span class="lbl">Per month</span><b id="grandMonth">@DisplayHelper.FormatRs(Model.GrandMonthly)</b>
        <span class="lbl" id="grandPerL">@Model.FeedCostPerLitreText</span></div>
</div>

<div class="v195-feed-flow">
  <span>🛒 BUY</span><b>→</b><span>📦 STOCK</span><b>→</b><span>🥣 RECIPE</span><b>→</b><span>🍽 FEED PLAN</span><b>→</b><span>🔄 AUTO USE</span><b>→</b><span>₨ ANIMAL COST</span>
</div>

<div class="tabs v195-feed-tabs feed-subtabs" style="margin-top:0">
    <button type="button" class="tab feed-subtab @(Model.ActiveSubTab == "store" ? "active" : "")" data-feedtab="store">📦 Stock</button>
    <button type="button" class="tab feed-subtab @(Model.ActiveSubTab == "purchases" ? "active" : "")" data-feedtab="purchases">🛒 Purchases</button>
    <button type="button" class="tab feed-subtab @(Model.ActiveSubTab == "recipes" ? "active" : "")" data-feedtab="recipes">🥣 Recipes</button>
    <button type="button" class="tab feed-subtab @(Model.ActiveSubTab == "plan" ? "active" : "")" data-feedtab="plan">🍽 Feeding Plans</button>
    <button type="button" class="tab feed-subtab @(Model.ActiveSubTab == "order" ? "active" : "")" data-feedtab="order">🧾 Order List</button>
    <button type="button" class="tab feed-subtab @(Model.ActiveSubTab == "kiddiet" ? "active" : "")" data-feedtab="kiddiet" id="v182KidTab">🍼 Kid Milk Diet</button>
</div>

<div class="feedview" id="feed-store" style="@(Model.ActiveSubTab is "store" or "" or null ? "" : "display:none")">
<div id="lowAlert"></div>
<div class="panel">
<div class="panel-head"><h2>Feed management</h2>
<div class="filterbar">
<button type="button" class="btn btn-ghost btn-sm" id="jumpPurchase">+ Purchase</button>
<button type="button" class="btn btn-ghost btn-sm" id="jumpCheck">+ Stock check</button>
</div>
</div>
<div class="panel-body">
<div class="stats" id="feedStats" style="grid-template-columns:repeat(4,1fr);margin-bottom:18px"></div>
<div class="v205-feed-scroll"><table class="tbl"><thead><tr><th>Feed</th>
<th class="num-cell hide-sm">Purchased</th><th class="num-cell hide-sm">Used</th>
<th class="num-cell">In Stock</th><th class="num-cell">Daily Use</th>
<th class="num-cell">Days Left</th><th class="num-cell hide-sm">Avg Cost/kg</th>
<th class="num-cell hide-sm">Status</th></tr></thead>
<tbody id="stockRows"></tbody></table></div>
<div id="reorderNote" style="margin-top:14px"></div>
<div class="rule" id="autoInfo" style="margin-top:10px">@Html.Raw(Model.FeedSettings.AutoInfoHtml)</div>
<span class="sub" id="autoState" style="display:none"></span>
</div>
</div>
<details class="panel v195-stock-check"><summary class="v195-summary">🧮 Monthly Stock Check <span>Reconcile physical stock with the software</span></summary><div class="v195-details-body">
<div class="panel-head"><h2>Monthly stock check</h2><span class="sub">count the store, correct the books</span></div>
<div class="panel-body">
<div class="note" style="margin:0 0 14px 0">Once a month, weigh what is actually in the store and type
            it here. The app shows the <b>difference</b> against its own figure — that gap is real feeding above
            or below your plan, and it tells you whether your plan needs adjusting.</div>
<div id="checkList"></div>
<div style="margin-top:12px">
<button type="button" class="btn btn-green" id="saveCheck">Save stock check</button>
<button type="button" class="btn btn-ghost" id="fillCheck">Fill with book figures</button></div>
<div class="rule" id="checkMsg" style="margin-top:10px"></div></div></details>
</div>

<div class="feedview" id="feed-purchases" style="@(Model.ActiveSubTab == "purchases" ? "" : "display:none")">
<div class="v195-help"><b>Simple purchase flow:</b> Date → Feed → Quantity → Rate → Payment → Supplier → Save. Use <b>＋ Add new feed…</b> inside the Feed dropdown when needed.</div>
<div class="panel">
<div class="panel-head"><h2>New Feed Purchase</h2><span class="sub">one entry updates stock, Cash/Bank and supplier payable</span>
<div class="filterbar"><div class="field"><label class="hide-sm">Month</label><input type="month" id="feedMonth" value="@Model.FeedMonth"></div></div>
</div>
<div class="panel-body">
<div class="v205-feed-scroll"><table class="tbl"><thead><tr><th>Date</th><th>Feed</th><th class="num-cell">Qty</th>
<th class="num-cell hide-sm">Rate/kg</th><th class="num-cell">Total</th>
<th class="hide-sm">Supplier</th><th class="hide-sm">Payment</th><th class="hide-sm">Cash / Bank</th><th class="hide-sm">Allocation</th><th class="hide-sm">Comment</th><th style="width:30px"></th></tr></thead>
<tbody id="buyLogRows"></tbody></table></div>
<div class="v170-feed-buy-form" style="margin-top:14px">
  <div class="v170-feed-row v170-feed-purchase-row">
    <div class="field"><label>Date</label><input id="fb-date" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" /></div>
    <div class="field"><label>Feed</label><select id="fb-feed"></select></div>
    <div class="field"><label>Use as</label><select id="fb-use"><option value="recipe">Mix ingredient (goes in recipes)</option><option value="direct">Bulk feed (fed directly — shows in Feeding Plan)</option></select></div>
    <div class="field"><label>Quantity (kg)</label><input id="fb-kg" min="0" step="0.5" type="number" /></div>
    <div class="field"><label>Rate / kg (Rs)</label><input id="fb-rate" min="0" type="number" /></div>
    <div class="field v170-total-field"><label>Total (Rs)</label><input disabled="" id="fb-total" placeholder="Auto calculated" type="number" /></div>
  </div>
  <div class="v170-feed-row v170-feed-payment-row">
    <div class="field"><label>Payment status</label><select id="fb-payment"><option value="paid">Paid</option><option value="partial">Part paid</option><option value="credit">Credit / unpaid</option></select></div>
    <div class="field"><label>Paid now (Rs)</label><input id="fb-paid" min="0" type="number" placeholder="Auto if paid" /></div>
    <div class="field"><label>Paid from</label><select id="fb-account"></select></div>
    <div class="field"><label>Supplier</label><input id="fb-supplier" placeholder="Supplier name" /></div>
    <div class="field"><label>Due date</label><input id="fb-due" type="date" /></div>
    <div class="field"><label>Accounting allocation <span class="v195-advanced-tag">Advanced</span></label><select id="fb-alloc-months"><option value="1">1 month</option><option value="2">2 months</option><option value="3">3 months</option><option value="4">4 months</option><option value="5">5 months</option><option value="6">6 months</option><option value="12">12 months</option></select></div>
  </div>
  <div class="v170-feed-row v170-feed-note-row">
    <div class="field v170-feed-note"><label>Comment / note</label><input id="fb-note" placeholder="Invoice reference, delivery details or optional note" /></div>
    <div class="field v170-feed-submit"><label>&nbsp;</label><button type="button" class="btn btn-green" id="addFeedBuy">+ Record purchase</button></div>
  </div>
</div>
<div class="goat-form-actions">
    <button type="button" class="btn btn-ghost" id="cancelFeedBuyBtn" style="display:none">Cancel</button>
    <button type="button" class="btn btn-danger" id="deleteFeedBuyBtn" style="display:none">Delete</button>
</div>
<div class="rule" style="margin-top:8px"><b>Save once only:</b> quantity enters Feed Stock immediately. Paid amount goes to the selected Cash/Bank account; unpaid balance goes to Supplier Payables. Daily feeding reduces stock automatically. Do not enter the same payment again in Accounting.</div>
</div>
</div>
</div>

<div class="feedview" id="feed-recipes" style="@(Model.ActiveSubTab == "recipes" ? "" : "display:none")">
<div class="v195-help"><b>Recipe = what is inside the mix.</b> Choose 50 kg, 100 kg or another batch size. Ingredient prices come from Feed Stock / purchase costing — do not type the same price twice.</div>
<div class="panel" id="recipePanel" style="display:block">
<div class="panel-head"><h2>Recipe Builder — <span id="recipeGroupName">@(Model.ActiveRecipe?.StatusDisplay ?? "Milking")</span></h2>
<div class="filterbar">
<div class="field"><label class="hide-sm">Recipe</label><select id="masterRecipeSelect">
    @foreach (var opt in Model.RecipeOptions)
    {
        if (string.Equals(opt.Key, Model.ActiveRecipeStatusKey, StringComparison.OrdinalIgnoreCase))
        {
            <option value="@opt.Key" selected>@opt.Name</option>
        }
        else
        {
            <option value="@opt.Key">@opt.Name</option>
        }
    }
</select></div>
<div class="field"><label class="hide-sm">Batch</label>
<select id="mixBatch">
<option value="50">50 kg</option><option value="100">100 kg</option>
<option value="150">150 kg</option><option value="200">200 kg</option>
<option value="250">250 kg</option><option value="500">500 kg</option>
<option value="custom">Custom</option></select></div>
<button type="button" class="btn btn-ghost btn-sm" id="scaleBatch">Scale</button>
</div>
</div>
<div class="panel-body">
<div id="mixList"></div>
<div class="result" id="mixResult"></div>
<div class="rule" id="mixCompare" style="margin-top:12px"></div>
</div>
</div>
<div class="panel">
<div class="panel-head"><h2>Feed Master &amp; Prices</h2><span class="sub">ingredients come from here; purchase history updates costing</span></div>
<div class="panel-body"><div class="price-grid" id="priceGrid"></div>
<div style="margin-top:16px;padding-top:14px;border-top:1px solid var(--line);display:flex;gap:8px;align-items:flex-end;flex-wrap:wrap">
<div class="field" style="flex:1;min-width:150px"><label>Add a new feed type</label>
<input id="nf-name" placeholder="e.g. Silage / Corn gluten" /></div>
<div class="field"><label>Price (Rs/kg)</label><input id="nf-price" min="0" style="width:110px" type="number" /></div>
<div class="field"><label>Use in plan</label><select id="nf-use"><option value="recipe">Recipe ingredient</option><option value="direct">Direct / bulk roughage</option></select></div>
<button type="button" class="btn btn-green" id="addFeedType">+ Add feed</button>
</div>
</div>
</div>
</div>

<div class="feedview" id="feed-plan" style="@(Model.ActiveSubTab == "plan" ? "" : "display:none")">
<div class="v195-help"><b>Feeding Plan = how much each animal group eats per day.</b> Keep recipe ingredients in Recipes; here you only set finished mix, green fodder, dry/direct feeds and quantities.</div>
<div class="panel">
<div class="panel-head"><h2>Green fodder cost</h2><span class="sub">cost the land, not the kilos</span></div>
<div class="panel-body">
<div class="note" style="margin:0 0 14px 0"><b>You cannot weigh fresh-cut fodder — so don't try.</b>
            Enter each green-fodder cost once, including the <b>actual payment date</b> and how many months it should cover. Cash Flow records the full payment on the paid date, while P&amp;L spreads it across the allocation months. <b>Nothing is charged twice.</b></div>
<div class="price-grid" id="fodderInputs"></div>
<div style="margin-top:14px;padding-top:14px;border-top:1px solid var(--line);display:flex;gap:8px;align-items:flex-end;flex-wrap:wrap">
<div class="field" style="flex:1;min-width:170px"><label>Add another fodder cost</label>
<input id="nf-fodname" placeholder="e.g. Fertiliser, Tractor diesel, Seed transport" /></div>
<div class="field"><label>Amount / year (Rs)</label><input id="nf-fodamt" min="0" style="width:120px" type="number" /></div>
<button type="button" class="btn btn-green" id="addFodderLine">+ Add cost</button>
</div>
<div class="filterbar" style="margin-top:14px">
<div class="field"><label class="hide-sm">Split between goats</label>
<select id="fodderMode">
@if (Model.FodderPool.Mode == "equal")
{
    <option value="share">By how much each group eats</option>
    <option value="equal" selected>Equally per goat</option>
}
else
{
    <option value="share" selected>By how much each group eats</option>
    <option value="equal">Equally per goat</option>
}
</select></div>
<div class="field"><label class="hide-sm">Acres under fodder</label>
<input id="fodderAcres" min="0" step="0.5" style="width:90px" type="number" value="@Model.FodderPool.Acres.ToString(CultureInfo.InvariantCulture)" /></div>
</div>
<div id="fodderCheck"></div>
<div class="result" id="fodderResult"></div>
<div class="rule" id="fodderNote" style="margin-top:12px">@Html.Raw(Model.FodderPool.NoteHtml)</div>
</div>
</div>
<div class="panel">
<div class="panel-head"><h2>Group Feeding Plan</h2><span class="sub">who gets how much per goat per day</span></div>
<div class="panel-body">
<div class="note" style="margin:0 0 14px 0">One row per group — set what <b>one goat</b> in that group
            eats per day, and the cost works itself out. Press <b>Recipe</b> to change what goes into that group's mix.
            <div style="margin-top:8px">
<b>Mix kg</b> — concentrate you buy; priced from that group's recipe.<br/>
<b>Green kg</b> — an estimate, not a price. It does two jobs: tells you how much to cut each day, and
              splits the fodder-land cost fairly (a doe on 2 kg carries four times what a kid on 0.5 kg does).<br/>
<b>Dry kg</b> — toori/bhoosa you buy; priced per kg.<br/>
<b>Fodder Rs/day</b> — that group's share of the land cost, worked out for you.<br/>
              Medicine and vaccines are <b>not planned here</b> — you buy them as needed, so they are recorded
              as real purchases on the Vaccines tab or as a Running cost. A month with none costs nothing.</div></div>
<div class="v205-feed-scroll"><table class="tbl"><thead><tr><th>Group</th><th class="num-cell">Goats</th>
<th class="num-cell">Mix kg/goat</th><th class="num-cell hide-sm">Green kg <span style="font-weight:400;text-transform:none">(share)</span></th>
<th class="num-cell hide-sm">Dry kg</th>
<th class="num-cell hide-sm">Fodder Rs/day</th>
<th class="num-cell">Rs/goat/day</th><th class="num-cell">Cost / month</th>
<th style="width:90px"></th></tr></thead>
<tbody id="groupPlanRows"></tbody></table></div>
<div style="margin-top:12px;display:flex;gap:8px;flex-wrap:wrap;align-items:center"><button type="button" class="btn btn-ghost btn-sm" id="fgAdd">+ Add feeding group</button><span class="sub">e.g. "Show goats", "High-yield milkers" — then move animals into it from Herd → Move to</span></div>
<div id="directFeedPlanBox" style="margin-top:16px"></div>
<div class="rule" id="planFodderMode" style="margin-top:12px">@Html.Raw(Model.PlanFodderModeHtml)</div>
<div class="note" style="margin-top:14px"><b>Adjusting rations:</b> type straight into any box — the cost,
            buying list and stock all follow immediately. A rough starting point for Beetal-type goats, to change
            against your own vet's advice and what the animals actually clear up:
            <div style="margin-top:8px">
<b>Kids</b> — very little concentrate, mostly milk and soft green · <b>Milking</b> — the heaviest
              ration; feed to yield · <b>Pregnant</b> — moderate, then increase in the last 6 weeks (more again for
              twins) · <b>Dry</b> — the leanest; mostly fodder to hold condition · <b>Bucks</b> — moderate, lift
              before the breeding season · <b>For sale</b> — push concentrate to finish them.</div>
<div style="margin-top:8px">Feed refused in the trough means the ration is too high; hungry animals and
            falling milk mean it is too low.</div></div>
</div>
</div>
</div>

<div class="feedview" id="feed-order" style="@(Model.ActiveSubTab == "order" ? "" : "display:none")">
<div class="panel">
<div class="panel-head"><h2>Automatic Order List</h2><span class="sub">calculated from recipes, feeding plans and current stock</span></div>
<div class="panel-body">
<div class="note" style="margin:0 0 12px 0">Worked out from each group's recipe and how many goats you
            have. Green fodder shows in kg only — you cut that from your own land.</div>
<div class="v205-feed-scroll"><table class="tbl"><thead><tr>
<th>Feed</th><th class="num-cell hide-sm">kg / day</th><th class="num-cell">kg / month</th>
<th class="num-cell">Rs / month</th></tr></thead><tbody id="buyRows"></tbody></table></div>
</div>
</div>
</div>

<div class="feedview" id="feed-kiddiet" style="@(Model.ActiveSubTab == "kiddiet" ? "" : "display:none")">
 <div class="panel"><div class="panel-head"><h2>Kid Milk Diet</h2><span class="sub">birth → month-wise milk feeding → weaning</span></div><div class="panel-body">
  <div class="v182-help"><b>How it works:</b> Save the ration once for Month 1, Month 2 and Month 3. The software uses each kid's date of birth and records the calculated consumption automatically every day. If the software is closed, missed days are caught up the next time you open it. You do not need to press a daily feeding button. Once the kid is marked <b>Weaned</b>, this milk diet stops and the kid moves into <b>Feed Plan → Weaned Kids</b>. Powder milk purchases can also be recorded here and still update Feed Stock + Accounting once.</div>
  <div class="v182-grid" style="margin-top:14px"><div class="v182-kpi"><span>Unweaned kids</span><b id="v182Un">0</b></div><div class="v182-kpi"><span>Powder milk today</span><b id="v182Pow">0 kg</b></div><div class="v182-kpi"><span>Powder milk stock</span><b id="v182Stock">0 kg</b></div></div>
 </div></div>
 <div class="panel"><div class="panel-head"><h2>Milk Diet by Age</h2><span class="sub">daily amount per kid — editable</span></div><div class="panel-body">
  <div class="v182-months" id="v182Months"></div>
  <div style="margin-top:14px;display:flex;gap:12px;align-items:center;flex-wrap:wrap"><button type="button" class="btn btn-green" id="v189SaveMonthlyDiet">💾 Save Monthly Kid Diet</button><span id="v189SaveMsg" class="muted">Enter Month 1–3 amounts, then save once.</span></div>
  <div class="rule" id="v182Req" style="margin-top:14px"></div>
  <div class="rule" id="v188AutoStatus" style="margin-top:12px"><b>Automatic daily recording:</b> starts when you save a monthly ration.</div>
 </div></div>
 <div class="panel"><div class="panel-head"><h2>Kid Starter Mix Recipe</h2><span class="sub">synced with Feed ingredients &amp; master recipes</span></div><div class="panel-body">
  <div class="v182-help">This is the same <b>Kid Starter Mix</b> stored in the main Feed recipe master. Every ingredient you add in Feed appears here automatically with the same current price. Edit the recipe here or in Feed — both use one recipe, so there is no duplicate ingredient or price entry.</div>
  <div style="margin-top:10px;display:flex;gap:10px;align-items:end;flex-wrap:wrap"><div class="field" style="margin:0;min-width:180px"><label>Recipe batch size</label><select id="v185BatchKg"><option value="50">50 kg</option><option value="100" selected>100 kg</option><option value="custom">Custom</option></select></div><div class="field" id="v185CustomWrap" style="margin:0;min-width:150px;display:none"><label>Custom kg</label><input id="v185CustomKg" type="number" min="1" step="1" value="100"></div><button type="button" class="btn btn-ghost btn-sm" id="v184OpenMasterRecipe">Open in Feed Recipe Master</button></div><div id="v183StarterRecipe" style="margin-top:12px"></div>
  <div class="rule" id="v183StarterRecipeTotal" style="margin-top:10px"></div>
 </div></div>
 <div class="panel"><div class="panel-head"><h2>Buy Powder Milk</h2><span class="sub">purchase here → powder milk stock + Accounting</span></div><div class="panel-body">
  <div class="v182-buy"><div class="field"><label>Date</label><input id="v182BuyDate" type="date"></div><div class="field"><label>Quantity (kg)</label><input id="v182BuyKg" type="number" min="0" step="0.1"></div><div class="field"><label>Rate / kg (Rs)</label><input id="v182BuyRate" type="number" min="0"></div><div class="field"><label>Total (Rs)</label><input id="v182BuyTotal" disabled></div><div class="field"><label>Payment</label><select id="v182BuyStatus"><option value="paid">Paid</option><option value="partial">Part paid</option><option value="credit">Credit / unpaid</option></select></div></div>
  <div class="v182-buy" style="margin-top:10px"><div class="field"><label>Paid now (Rs)</label><input id="v182BuyPaid" type="number" min="0"></div><div class="field"><label>Paid from</label><select id="v182BuyAccount"></select></div><div class="field"><label>Supplier</label><input id="v182BuySupplier" placeholder="Supplier name"></div><div class="field"><label>Due date</label><input id="v182BuyDue" type="date"></div><div class="field"><label>&nbsp;</label><button type="button" class="btn btn-green" id="v182BuyBtn">+ Record Powder Milk Purchase</button></div></div>
  <div class="rule" style="margin-top:10px">Do not enter this purchase again in Accounting. Paid amount reduces the selected Cash/Bank account; unpaid balance goes to Supplier Payables automatically.</div>
 </div></div>
 <div class="panel"><div class="panel-head"><h2>Recent Kid Milk Feeding</h2><span class="sub">actual feed issued before weaning</span></div><div class="panel-body"><div style="overflow:auto"><table class="tbl"><thead><tr><th>Date</th><th>Kids</th><th>Powder milk</th><th>Mother milk</th><th>Starter mix</th><th>Green</th><th>Dry</th></tr></thead><tbody id="v182Logs"></tbody></table></div></div></div>
</div>
</div>

@section Scripts {<script>GoatRecords.initFeed();</script>}
