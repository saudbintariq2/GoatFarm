@model GoatFarm.Application.ViewModels.Dashboard.DashboardViewModel
@using GoatFarm.Application.Common

<div class="note"><b>Dashboard</b> — a quick read across the farm. Open any section for full details and editing.</div>

<div class="panel dash-panel">
    <div class="panel-head dash-head">
        <h2>Herd</h2>
        <a class="dash-link" asp-controller="Goat" asp-action="Index">Open Herd →</a>
    </div>
    <div class="panel-body">
        <div class="stats dash-stats">
            <div class="stat"><div class="num">@Model.HerdStats.Total</div><div class="lbl"><span class="dot" style="background:var(--green)"></span>Total goats</div></div>
            <div class="stat"><div class="num">@Model.HerdStats.Kids</div><div class="lbl"><span class="dot" style="background:var(--amber)"></span>Kids</div></div>
            <div class="stat"><div class="num">@Model.HerdStats.Milking</div><div class="lbl"><span class="dot" style="background:var(--green)"></span>Milking</div></div>
            <div class="stat"><div class="num">@Model.HerdStats.Pregnant</div><div class="lbl"><span class="dot" style="background:var(--pink)"></span>Pregnant</div></div>
            <div class="stat"><div class="num">@Model.HerdStats.Dry</div><div class="lbl"><span class="dot" style="background:var(--ink-soft)"></span>Dry</div></div>
            <div class="stat"><div class="num">@Model.HerdStats.Bucks</div><div class="lbl"><span class="dot" style="background:var(--blue)"></span>Bucks</div></div>
        </div>
    </div>
</div>

<div class="panel dash-panel">
    <div class="panel-head dash-head">
        <h2>Breeding</h2>
        <a class="dash-link" asp-controller="Breeding" asp-action="Index">Open Breeding →</a>
    </div>
    <div class="panel-body">
        <div class="breed3 dash-breed3">
            <div class="fincard"><div class="v">@Model.BreedingExpectingCount</div>
                <div class="k"><span class="dot" style="background:var(--pink)"></span>Expecting (in-kid)</div></div>
            <div class="fincard"><div class="v">@Model.BreedingPrepCount</div>
                <div class="k"><span class="dot" style="background:var(--amber)"></span>Getting ready for cross</div></div>
            <div class="fincard"><div class="v dash-breed-due">@Model.BreedingNextDueText</div>
                <div class="k"><span class="dot" style="background:var(--green)"></span>Next kidding</div></div>
        </div>
        @if (Model.BreedingUpcoming.Any())
        {
            <div class="dash-subhead">Upcoming kidding</div>
            <table class="tbl dash-tbl"><thead><tr><th>Doe</th><th>Expected</th><th class="num-cell">Due in</th></tr></thead>
                <tbody>
                @foreach (var row in Model.BreedingUpcoming)
                {
                    <tr>
                        <td><span class="tag">@row.Tag</span>@if (!string.IsNullOrEmpty(row.Name)) {<div class="name">@row.Name</div>}</td>
                        <td><b>@row.ExpectedKidding</b></td>
                        <td class="num-cell" style="font-weight:700;@row.DueColor">@row.DueText</td>
                    </tr>
                }
                </tbody></table>
        }
    </div>
</div>

<div class="panel dash-panel">
    <div class="panel-head dash-head">
        <h2>Feed &amp; Cost</h2>
        <a class="dash-link" asp-controller="Feed" asp-action="Index">Open Feed →</a>
    </div>
    <div class="panel-body">
        <div class="dash-feed-top">
            <div class="fincard"><div class="v">@DisplayHelper.FormatRs(Model.FeedCostMonthly)</div>
                <div class="k"><span class="dot" style="background:var(--red)"></span>Total feed + medicine bill (monthly)</div></div>
            @if (Model.FeedStockLowCount > 0)
            {
                <div class="fincard dash-stock-alert"><div class="v">@Model.FeedStockLowCount</div>
                    <div class="k"><span class="dot" style="background:var(--amber)"></span>Feed type@(Model.FeedStockLowCount == 1 ? "" : "s") low on stock (&lt; 7 days)</div></div>
            }
        </div>
        @if (Model.FeedStock.Any())
        {
            <div class="dash-subhead">Feed stock</div>
            <table class="tbl dash-tbl"><thead><tr><th>Feed</th><th class="num-cell">In store</th><th class="num-cell">Days left</th></tr></thead>
                <tbody>
                @foreach (var s in Model.FeedStock)
                {
                    <tr>
                        <td><b>@s.DisplayName</b></td>
                        <td class="num-cell">@s.StockKg.ToString("N1") kg</td>
                        <td class="num-cell" style="font-weight:700;@s.DaysLeftColor">@s.DaysLeftText</td>
                    </tr>
                }
                </tbody></table>
        }
    </div>
</div>

<div class="panel dash-panel">
    <div class="panel-head dash-head">
        <div class="dash-title"><h2>Milk</h2><span class="sub">this month</span></div>
        <a class="dash-link" asp-controller="Milk" asp-action="Index">Open Milk →</a>
    </div>
    <div class="panel-body">
        <div class="milk4 dash-milk4">
            <div class="fincard"><div class="v">@Model.LitersProduced.ToString("N0") L</div>
                <div class="k"><span class="dot" style="background:var(--green)"></span>Collected</div></div>
            <div class="fincard"><div class="v">@Model.LitersSold.ToString("N0") L</div>
                <div class="k"><span class="dot" style="background:var(--blue)"></span>Sold</div></div>
            <div class="fincard"><div class="v">@Model.LitersWasted.ToString("N0") L</div>
                <div class="k"><span class="dot" style="background:var(--red)"></span>Wasted</div></div>
            <div class="fincard"><div class="v">@Model.LitersLeft.ToString("N0") L</div>
                <div class="k"><span class="dot" style="background:var(--green-dark)"></span>Milk left</div></div>
        </div>
    </div>
</div>

<div class="panel dash-panel">
    <div class="panel-head dash-head">
        <div class="dash-title"><h2>Finance</h2><span class="sub">@Model.Month</span></div>
        <a class="dash-link" asp-controller="Finance" asp-action="Index" asp-route-month="@Model.Month">Open Finance →</a>
    </div>
    <div class="panel-body">
        <div class="fin3 dash-fin4">
            <div class="fincard"><div class="v">@DisplayHelper.FormatRs(Model.TotalIncome)</div>
                <div class="k"><span class="dot" style="background:var(--green)"></span>Cash received this month</div></div>
            <div class="fincard"><div class="v">@DisplayHelper.FormatRs(Model.TotalExpense)</div>
                <div class="k"><span class="dot" style="background:var(--red)"></span>Running costs this month</div></div>
            <div class="fincard"><div class="v">@DisplayHelper.FormatRs(Model.Capital)</div>
                <div class="k"><span class="dot" style="background:var(--blue)"></span>Total capital (assets owned)</div></div>
        </div>
        <div class="bignum dash-profit @(Model.IsLoss ? "loss" : "")" style="margin-top:12px;margin-bottom:0">
            <div><div class="lbl">Profit this month (income − running costs)</div>
                <div class="big">@(Model.IsLoss ? "– " : "")@DisplayHelper.FormatRs(Math.Abs(Model.Profit))</div></div>
        </div>
    </div>
</div>

<div class="panel dash-panel">
    <div class="panel-head dash-head">
        <h2>Vaccines</h2>
        <a class="dash-link" asp-controller="Vaccine" asp-action="Index">Open Vaccines →</a>
    </div>
    <div class="panel-body">
        <div class="dash-vacc-top">
            <div class="fincard dash-due-card">
                <div class="v">@Model.DueNowCount</div>
                <div class="k"><span class="dot" style="background:var(--red)"></span>Due now · @Model.DueNowNote</div>
            </div>
        </div>
        @if (Model.DueNow.Any())
        {
            <div class="dash-subhead">Due now</div>
            <table class="tbl dash-tbl"><thead><tr><th>Vaccine</th><th>Scope</th><th class="num-cell">Goats</th></tr></thead>
                <tbody>
                @foreach (var d in Model.DueNow)
                {
                    <tr><td><b>@d.VaccineName</b></td><td><span class="scopechip">@d.ScopeDisplay</span></td>
                        <td class="num-cell">@d.DueCount</td></tr>
                }
                </tbody></table>
        }
        <div class="dash-subhead">My reminders</div>
        <table class="tbl dash-tbl"><thead><tr><th>Reminder</th><th class="hide-sm">Date</th><th class="num-cell">When</th></tr></thead>
            <tbody>
            @if (Model.Reminders.Any())
            {
                @foreach (var r in Model.Reminders)
                {
                    <tr><td><b>@r.Title</b>@if(!string.IsNullOrEmpty(r.ScopeDisplay)){<span class="scopechip">@r.ScopeDisplay</span>}</td>
                        <td class="hide-sm"><span class="breed">@r.DateDisplay</span></td>
                        <td class="num-cell" style="color:@r.WhenColor">@r.WhenDisplay</td></tr>
                }
            }
            else
            {
                <tr><td colspan="3" class="empty">No reminders set.</td></tr>
            }
            </tbody></table>
    </div>
</div>
