@model GoatFarm.Application.ViewModels.Goats.HerdPageViewModel
@using GoatFarm.Domain.Enums
@{
    var breeds = (string[])ViewBag.Breeds!;
    var herdFilter = Model.Filter ?? "all";
    var editGoatJson = ViewBag.EditGoatJson as string ?? "null";
    ViewBag.HerdFilter = herdFilter;
}

<div class="note"><b>Herd:</b> add a goat with its date and price. If you <b>bought</b> it, the price
    goes into Capital on the Finance tab automatically — because a bought goat is an asset you own.</div>

<div class="stats" id="stats">
    <div class="stat" data-filter="all"><div class="num">@Model.Stats.Total</div><div class="lbl"><span class="dot" style="background:var(--green)"></span>Total goats</div></div>
    <div class="stat" data-filter="st:kid"><div class="num">@Model.Stats.Kids</div><div class="lbl"><span class="dot" style="background:var(--amber)"></span>Kids</div></div>
    <div class="stat" data-filter="st:milking"><div class="num">@Model.Stats.Milking</div><div class="lbl"><span class="dot" style="background:var(--green)"></span>Milking</div></div>
    <div class="stat" data-filter="st:pregnant"><div class="num">@Model.Stats.Pregnant</div><div class="lbl"><span class="dot" style="background:var(--pink)"></span>Pregnant</div></div>
    <div class="stat" data-filter="st:dry"><div class="num">@Model.Stats.Dry</div><div class="lbl"><span class="dot" style="background:var(--ink-soft)"></span>Dry</div></div>
    <div class="stat" data-filter="st:buck"><div class="num">@Model.Stats.Bucks</div><div class="lbl"><span class="dot" style="background:var(--blue)"></span>Bucks</div></div>
</div>

<div class="panel" id="goatFormPanel">
    <div class="panel-head"><h2 id="goatFormTitle">Add a goat</h2></div>
    <div class="panel-body">
        <div class="add-grid goat-add-grid">
            <div class="field field-tag">
                <label for="f-tag">Tag / RFID ID</label>
                <input id="f-tag" class="herd-tag-input" placeholder="Scan or type tag, then press Enter" autocomplete="off" spellcheck="false">
            </div>
            <div class="field"><label>Name (optional)</label><input id="f-name" placeholder="optional"></div>
            <div class="field"><label>Breed</label><select id="f-breed" data-lookup="Lookup.Breeds">@foreach (var b in breeds){<option>@b</option>}</select></div>
            <div class="field"><label>Gender</label><select id="f-gender"><option value="Female">Female</option><option value="Male">Male</option></select></div>
            <div class="field"><label>Source</label><select id="f-source"><option value="Bought">Bought</option><option value="Born">Born on farm</option></select></div>
            <div class="field"><label>Price (Rs)</label><input type="number" id="f-price" min="0" placeholder="0"></div>
            <div class="field"><label>Status</label><select id="f-status">
                <option value="Kid">Kid</option><option value="Milking">Milking</option><option value="Pregnant">Pregnant</option>
                <option value="Dry">Dry</option><option value="Buck">Buck</option><option value="Sale">For sale</option></select></div>
            <div class="field"><label>Date (born / bought)</label><input type="date" id="f-date"></div>
            <div class="field field-comment-goat"><label>Comment</label><input id="f-note" placeholder="optional"></div>
        </div>
        <div class="goat-form-actions">
            <div class="goat-form-actions-left">
                <button type="button" class="btn btn-green" id="addBtn">+ Add goat</button>
                <button type="button" class="btn btn-ghost" id="cancelBtn" style="display:none">Cancel</button>
            </div>
            <button type="button" class="btn btn-danger" id="deleteBtn" style="display:none">Delete</button>
        </div>
    </div>
</div>

<div class="panel">
    <div class="panel-head"><h2>The herd</h2>
        <div class="filterbar"><div class="field"><label class="hide-sm">Show</label>
            <select id="filter">
                <optgroup label="By age">
                    <option value="all" selected="@(Model.Filter == "all")">All goats</option>
                    <option value="age:0:70">Kids 0–70 days</option>
                    <option value="age:70:90">Kids 70–90 days</option>
                    <option value="age:90:180">3–6 months</option>
                    <option value="age:180:365">6–12 months</option>
                    <option value="age:365:99999">Over 1 year</option>
                </optgroup>
                <optgroup label="By status">
                    <option value="st:kid">Kids</option><option value="st:pregnant">Pregnant</option>
                    <option value="st:milking">Milking</option><option value="st:dry">Dry</option>
                    <option value="st:buck">Bucks</option><option value="st:sale">For sale</option>
                </optgroup>
                <optgroup label="By breeding">
                    <option value="br:prep" selected="@(Model.Filter == "br:prep")">Ready for cross</option>
                    <option value="br:expecting" selected="@(Model.Filter == "br:expecting")">Expecting / in-kid</option>
                </optgroup>
                <optgroup label="By group" id="groupOpts">
                    @foreach (var g in Model.Groups){<option value="grp:@g">@g</option>}
                </optgroup>
            </select></div></div>
    </div>
    <div class="panel-body">
        <div class="bulkbar" id="bulkbar">
            <span class="sel" id="selCount">0 selected</span>
            <span style="color:var(--green-dark);font-weight:600">Move to:</span>
            <select id="moveTo">
                <optgroup label="Set status">
                    <option value="st:kid">Kid</option><option value="st:milking">Milking</option>
                    <option value="st:pregnant">Pregnant</option><option value="st:dry">Dry</option>
                    <option value="st:buck">Buck</option><option value="st:sale">For sale</option></optgroup>
                <optgroup label="Breeding">
                    <option value="br:prep">Ready for cross</option>
                    <option value="br:cross">Crossed / expecting</option>
                    <option value="br:kidded">Kidded → Milking</option></optgroup>
                <optgroup label="Group" id="moveGroupOpts">
                    @foreach (var g in Model.Groups){<option value="grp:@g">@g</option>}
                </optgroup>
            </select>
            <button type="button" class="btn btn-green" id="moveBtn">Move</button>
            <button type="button" class="btn btn-ghost" id="newGroupBtn">+ New group</button>
        </div>
        <table class="tbl"><thead><tr>
            <th style="width:34px"><input type="checkbox" id="checkAll"></th>
            <th>Tag</th><th class="hide-sm">Breed</th><th>Age</th><th>Status</th>
            <th class="hide-sm num-cell">Price</th><th class="hide-sm">Date</th>
        </tr></thead><tbody id="rows">
            @foreach (var g in Model.Goats)
            {
                <tr class="goat-row" data-id="@g.Id"
                    data-tag="@g.Tag"
                    data-name="@g.Name"
                    data-comment="@g.Comment"
                    data-breed="@g.Breed"
                    data-gender="@g.Gender"
                    data-source="@g.Source"
                    data-price="@g.PurchasePrice"
                    data-status="@g.Status"
                    data-date="@g.EventDateDisplay">
                    <td><input type="checkbox" data-id="@g.Id"></td>
                    <td><a class="tag tag-link" href="/Search?tag=@Uri.EscapeDataString(g.Tag)">@g.Tag</a>@if(!string.IsNullOrEmpty(g.Name)){<div class="name">@g.Name</div>}@if(!string.IsNullOrEmpty(g.Comment)){<div class="name" style="opacity:.75">@g.Comment</div>}</td>
                    <td class="hide-sm"><span class="breed">@g.Breed</span></td>
                    <td><span class="age-d">@g.AgeDays</span> <span class="age-m">days · @g.AgeLabel</span></td>
                    <td><span class="chip @g.StatusCssClass">@g.StatusDisplay</span>
                        @if (!string.IsNullOrEmpty(g.BreedingHint))
                        {<div class="name" style="color:@g.BreedingHintColor;font-weight:700">@g.BreedingHint</div>}</td>
                    <td class="hide-sm num-cell">@if(g.Source == GoatSource.Born){<span class="breed">home-bred</span>}else{<span class="breed">@DisplayHelper.FormatRs(g.PurchasePrice)</span>}</td>
                    <td class="hide-sm"><span class="breed">@g.EventDateDisplay</span></td>
                </tr>
            }
        </tbody></table>
        <div class="empty" id="empty" style="display:@(Model.Pagination.TotalItems > 0 ? "none" : "block")">No goats match this filter.</div>
        @await Html.PartialAsync("_HerdPagination", Model.Pagination)
    </div>
</div>

@section Scripts {
<script>GoatRecords.initHerd({ filter: '@herdFilter', page: @Model.Pagination.Page, editGoat: @Html.Raw(editGoatJson) });</script>
}
