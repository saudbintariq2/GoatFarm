@model GoatFarm.Application.ViewModels.Goats.HerdPageViewModel
@using GoatFarm.Domain.Enums
@{
    var breeds = (string[])ViewBag.Breeds!;
    var herdFilter = Model.Filter ?? "all";
    var editGoatJson = ViewBag.EditGoatJson as string ?? "null";
    ViewBag.HerdFilter = herdFilter;
    ViewBag.HerdSearch = Model.Search;
    var ownerOptions = new List<string> { "Farm" };
    foreach (var o in Model.OwnerFilters.OrderBy(x => x, StringComparer.OrdinalIgnoreCase))
    {
        var t = o?.Trim();
        if (string.IsNullOrEmpty(t) || t.Equals("Farm", StringComparison.OrdinalIgnoreCase)) continue;
        ownerOptions.Add(t);
    }
    var herdInitJson = System.Text.Json.JsonSerializer.Serialize(new
    {
        filter = herdFilter,
        search = Model.Search ?? "",
        page = Model.Pagination.Page,
        ownerSeed = ownerOptions.Where(o => !o.Equals("Farm", StringComparison.OrdinalIgnoreCase)).ToList()
    });
}

<div id="view-herd">
<div class="note"><b>One goat →</b> open her profile from the list (or use Search).
    <b>Many goats →</b> tick them in the list and use <b>Move to</b>.</div>

<div class="stats" id="stats">
    <div class="stat" data-filter="all" role="button" tabindex="0" title="Show all goats">
        <div class="num">@Model.Stats.Total</div>
        <div class="lbl"><span class="dot" style="background:var(--green)"></span>Total goats</div>
    </div>
    <div class="stat" data-filter="st:kid" role="button" tabindex="0" title="Filter: kids">
        <div class="num">@Model.Stats.Kids</div>
        <div class="lbl"><span class="dot" style="background:var(--amber)"></span>Kids</div>
    </div>
    <div class="stat" data-filter="st:milking" role="button" tabindex="0" title="Filter: milking">
        <div class="num">@Model.Stats.Milking</div>
        <div class="lbl"><span class="dot" style="background:var(--green)"></span>Milking</div>
    </div>
    <div class="stat" data-filter="st:pregnant" role="button" tabindex="0" title="Filter: pregnant">
        <div class="num">@Model.Stats.Pregnant</div>
        <div class="lbl"><span class="dot" style="background:var(--pink)"></span>Pregnant</div>
    </div>
    <div class="stat" data-filter="st:dry" role="button" tabindex="0" title="Filter: dry">
        <div class="num">@Model.Stats.Dry</div>
        <div class="lbl"><span class="dot" style="background:var(--ink-soft)"></span>Dry</div>
    </div>
    <div class="stat" data-filter="st:buck" role="button" tabindex="0" title="Filter: bucks">
        <div class="num">@Model.Stats.Bucks</div>
        <div class="lbl"><span class="dot" style="background:var(--blue)"></span>Bucks</div>
    </div>
    <div class="stat" data-filter="st:meat" role="button" tabindex="0" title="Filter: meat / finishing">
        <div class="num">@Model.Stats.Meat</div>
        <div class="lbl"><span class="dot" style="background:#9a3a1e"></span>Meat</div>
    </div>
</div>

<div class="panel" id="goatFormPanel" style="display:none">
    <div class="panel-head"><h2 id="goatFormTitle">Add a goat</h2>
        <button type="button" class="btn btn-ghost btn-sm" id="addGoatClose">Close</button></div>
    <div class="panel-body">
        <div class="add-grid goat-add-grid">
            <div class="field"><label for="f-tag">Tag / ID</label>
                <input id="f-tag" required placeholder="e.g. 245" autocomplete="off" spellcheck="false"></div>
            <div class="field"><label for="f-name">Name (optional)</label><input id="f-name" placeholder="optional"></div>
            <div class="field"><label for="f-breed">Breed</label><select id="f-breed" data-lookup="Lookup.Breeds">@foreach (var b in breeds){<option>@b</option>}</select></div>
            <div class="field"><label for="f-gender">Gender</label><select id="f-gender"><option value="Female">Female</option><option value="Male">Male</option></select></div>
            <div class="field"><label for="f-owner">Owner</label>
                <select id="f-owner"></select></div>
            <div class="field"><label for="f-health">Health</label>
                <select id="f-health"></select></div>
            <div class="field"><label for="f-source">Source</label><select id="f-source"><option value="Bought">Bought</option><option value="Born">Born on farm</option></select></div>
            <div class="field"><label for="f-price">Price (Rs)</label><input type="number" id="f-price" min="0" placeholder="0"></div>
            <div class="field"><label for="f-status">Status</label><select id="f-status">
                <option value="Kid">Kid</option><option value="Milking">Milking</option><option value="Pregnant">Pregnant</option>
                <option value="Dry">Dry</option><option value="Buck">Buck</option><option value="Sale">For sale</option></select></div>
            <div class="field"><label for="f-date">Date (born / bought)</label><input type="date" id="f-date" required></div>
            <div class="field"><label for="f-sire">Sire (buck)</label><select id="f-sire"><option value="">— none —</option></select></div>
            <div class="field"><label for="f-dam">Dam (mother) tag</label><input id="f-dam" maxlength="50" list="damOptions" autocomplete="off" placeholder="optional"></div>
            <div class="field field-comment"><label for="f-note">Comment</label>
                <input id="f-note" maxlength="500" placeholder="optional note" autocomplete="off"></div>
            <datalist id="damOptions"></datalist>
        </div>
        <div class="goat-form-actions">
            <div class="goat-form-actions-left">
                <button type="button" class="btn btn-green" id="addBtn">+ Add goat</button>
                <button type="button" class="btn btn-ghost" id="cancelBtn" style="display:none">Cancel</button>
                <button type="button" class="btn btn-ghost" id="herdCsvBtn" data-needs-herd-add>Import herd (CSV)</button>
                <input type="file" id="herdCsvFile" accept=".csv,text/csv" hidden>
            </div>
            <button type="button" class="btn btn-danger" id="deleteBtn" style="display:none">Delete</button>
        </div>
    </div>
</div>

<div class="panel herd-list-panel">
    <div class="panel-head herd-list-head">
        <h2>All goats <button type="button" class="btn btn-green btn-sm" id="addGoatOpen" data-needs-herd-add style="margin-left:10px;vertical-align:middle">+ Add goat</button></h2>
        <div class="filterbar"><div class="field"><label class="hide-sm">Show</label>
            <select id="filter">
                <optgroup label="By age">
                    <option value="all" @(Model.Filter == "all" ? "selected" : null)>All goats</option>
                    <option value="age:0:70">Kids 0–70 days</option>
                    <option value="age:70:90">Kids 70–90 days</option>
                    <option value="age:90:180">3–6 months</option>
                    <option value="age:180:365">6–12 months</option>
                    <option value="age:365:99999">Over 1 year</option>
                </optgroup>
                <optgroup label="By status">
                    <option value="st:kid" @(Model.Filter == "st:kid" ? "selected" : null)>Kids</option>
                    <option value="st:pregnant" @(Model.Filter == "st:pregnant" ? "selected" : null)>Pregnant</option>
                    <option value="st:milking" @(Model.Filter == "st:milking" ? "selected" : null)>Milking</option>
                    <option value="st:dry" @(Model.Filter == "st:dry" ? "selected" : null)>Dry</option>
                    <option value="st:buck" @(Model.Filter == "st:buck" ? "selected" : null)>Bucks</option>
                    <option value="st:sale" @(Model.Filter == "st:sale" ? "selected" : null)>For sale</option>
                    <option value="st:meat" @(Model.Filter == "st:meat" ? "selected" : null)>Meat / finishing</option>
                </optgroup>
                <optgroup label="By breeding">
                    <option value="untag" @(Model.Filter == "untag" ? "selected" : null)>Kids waiting for ear tags</option>
                    <option value="wean" @(Model.Filter == "wean" ? "selected" : null)>Ready to wean</option>
                    <option value="ageup" @(Model.Filter == "ageup" ? "selected" : null)>Kids over a year old</option>
                    <option value="heatdue" @(Model.Filter == "heatdue" ? "selected" : null)>Heat expected</option>
                    <option value="br:prep" @(Model.Filter == "br:prep" ? "selected" : null)>Ready for cross</option>
                    <option value="br:waiting" @(Model.Filter == "br:waiting" ? "selected" : null)>Crossed - awaiting scan</option>
                    <option value="br:scan" @(Model.Filter == "br:scan" ? "selected" : null)>Scan due now</option>
                    <option value="br:expecting" @(Model.Filter == "br:expecting" ? "selected" : null)>Confirmed pregnant</option>
                    <option value="br:due30" @(Model.Filter == "br:due30" ? "selected" : null)>Due within 30 days</option>
                    <option value="dryoff" @(Model.Filter == "dryoff" ? "selected" : null)>To dry off (before birth)</option>
                    <option value="buildup" @(Model.Filter == "buildup" ? "selected" : null)>On extra feed</option>
                    <option value="stopmilk" @(Model.Filter == "stopmilk" ? "selected" : null)>Stop milking (cross coming)</option>
                    <option value="crossdue" @(Model.Filter == "crossdue" ? "selected" : null)>Cross due within a week</option>
                </optgroup>
                <optgroup label="By health">
                    <option value="hl:sick" @(Model.Filter == "hl:sick" ? "selected" : null)>Sick / under treatment</option>
                    <option value="health:sick">Sick</option>
                    <option value="health:undertreatment">Under treatment</option>
                    <option value="health:recovering">Recovering</option>
                </optgroup>
                <optgroup label="By birth batch">
                    @foreach (var b in Model.BirthBatches){<option value="bat:@b" @(Model.Filter == "bat:" + b ? "selected" : null)>@b</option>}
                    <option value="bat:none" @(Model.Filter == "bat:none" ? "selected" : null)>No batch set</option>
                </optgroup>
                <optgroup label="By sire">
                    @foreach (var s in Model.SireFilterTags){<option value="sire:@s" @(Model.Filter == "sire:" + s ? "selected" : null)>@s</option>}
                </optgroup>
                <optgroup label="By owner">
                    @foreach (var o in Model.OwnerFilters){<option value="own:@o" @(Model.Filter == "own:" + o ? "selected" : null)>@o</option>}
                </optgroup>
                <optgroup label="By group" id="groupOpts">
                    @foreach (var g in Model.Groups){<option value="grp:@g" @(Model.Filter == "grp:" + g ? "selected" : null)>@g</option>}
                </optgroup>
                <optgroup label="Kiddings &amp; mothers">
                    <option value="kd:0" @(Model.Filter == "kd:0" ? "selected" : null)>First-timers (0 kiddings)</option>
                    <option value="kd:1" @(Model.Filter == "kd:1" ? "selected" : null)>1 kidding</option>
                    <option value="kd:2" @(Model.Filter == "kd:2" ? "selected" : null)>2 kiddings</option>
                    <option value="kd:3" @(Model.Filter == "kd:3" ? "selected" : null)>3 kiddings</option>
                    <option value="kd:4" @(Model.Filter == "kd:4" ? "selected" : null)>4 kiddings</option>
                    <option value="kd:5" @(Model.Filter == "kd:5" ? "selected" : null)>5+ kiddings</option>
                    <option value="ms:4" @(Model.Filter == "ms:4" ? "selected" : null)>Mother score ≥ 4</option>
                    <option value="ms:low" @(Model.Filter == "ms:low" ? "selected" : null)>Mother score &lt; 3</option>
                    <option value="dec:cull" @(Model.Filter == "dec:cull" ? "selected" : null)>Decision = Cull</option>
                    @foreach (var mg in Model.MotherGroups)
                    {
                        var mgf = "mg:" + mg.Id;
                        <option value="@mgf" @(Model.Filter == mgf ? "selected" : null)>Mother group: @mg.Name</option>
                    }
                </optgroup>
                <optgroup label="Kid milk">
                    <option value="kid:milk" @(Model.Filter == "kid:milk" ? "selected" : null)>Kids on milk</option>
                    <option value="kid:weaned" @(Model.Filter == "kid:weaned" ? "selected" : null)>Kids weaned</option>
                    <option value="milk:Mother" @(Model.Filter == "milk:Mother" ? "selected" : null)>On mother milk</option>
                    <option value="milk:Powder" @(Model.Filter == "milk:Powder" ? "selected" : null)>On powder milk</option>
                    <option value="milk:Mixed" @(Model.Filter == "milk:Mixed" ? "selected" : null)>On mixed milk</option>
                    <option value="milk:Foster" @(Model.Filter == "milk:Foster" ? "selected" : null)>On foster milk</option>
                </optgroup>
            </select></div></div>
    </div>
    <div class="panel-body">
        <div class="chipbar" id="herdChips">
            @foreach (var row in Model.FilterOptions.Rows)
            {
                <div class="chiprow">
                    <span class="chl">@row.Label</span>
                    <div class="chips">
                        @foreach (var chip in row.Chips)
                        {
                            var q = string.IsNullOrEmpty(Model.Search) ? "" : "&q=" + Uri.EscapeDataString(Model.Search);
                            <a class="fchip @(chip.Active ? "on" : "") @(chip.Count == 0 ? "zero" : "")"
                               href="/Goat?filter=@Uri.EscapeDataString(chip.Value)@q">
                                <span class="dot" style="background:@chip.Color"></span>@chip.Label <span class="n">@chip.Count</span>
                            </a>
                        }
                    </div>
                </div>
            }
        </div>
        <div class="young-stock-note"><b>Young-stock example:</b> Tag 245 · Female · 7m 12d · Weaned Kid → <b>Classification Due</b> → choose <b>Doeling</b>, <b>Buckling</b> or <b>Meat / Sale</b>. Choosing <b>Meat / Sale</b> immediately puts that animal on the <b>Meat / Finishing</b> Feed Plan. Doeling/Buckling can later use <b>Move classified young stock to adult herd</b> when ready. Previous milk, feed and health history stays with the animal.</div>
        <div class="bulkbar" id="bulkbar">
            <span class="sel" id="selCount">0 selected</span>
            <span style="color:var(--green-dark);font-weight:600">Move to:</span>
            <select id="moveTo">
                <optgroup label="Set status">
                    <option value="st:kid">Kid</option><option value="st:milking">Milking</option>
                    <option value="st:pregnant">Pregnant</option><option value="st:dry">Dry</option>
                    <option value="st:buck">Buck</option><option value="st:sale">For sale</option><option value="st:meat">Meat / finishing</option></optgroup>
                <optgroup label="Breeding">
                    <option value="br:plan">Plan next cross (date)</option>
                    <option value="br:prep">Ready for cross</option>
                    <option value="br:cross">Crossed (awaiting scan)</option>
                    <option value="br:kidded">Kidded → Milking</option>
                    <option value="br:dryoff">Dry off / stop milking</option></optgroup>
                <optgroup label="Kids / young stock">
                    <option value="k:wean">Wean</option>
                    <option value="k:class-doeling">Classify — Doeling</option>
                    <option value="k:class-buckling">Classify — Buckling</option>
                    <option value="k:class-meat">Classify — Meat / finishing</option>
                    <option value="k:graduate">Graduate to adult herd</option></optgroup>
                <optgroup label="Birth batch">
                    @foreach (var b in Model.BirthBatches){<option value="bat:@b">@b</option>}
                    <option value="bat:__new__">+ New birth batch…</option>
                    <option value="bat:none">Clear batch</option></optgroup>
                <optgroup label="Health">
                    <option value="hl:healthy">Healthy</option>
                    <option value="hl:sick">Sick</option>
                    <option value="hl:undertreatment">Under treatment</option>
                    <option value="hl:recovering">Recovering</option></optgroup>
                @if (Model.FeedingGroups.Count > 0)
                {
                <optgroup label="Feeding group">
                    @foreach (var fg in Model.FeedingGroups){<option value="fg:@fg.Id">@fg.Name</option>}
                </optgroup>
                }
                <optgroup label="Group" id="moveGroupOpts">
                    @foreach (var g in Model.Groups){<option value="grp:@g">@g</option>}
                </optgroup>
            </select>
            <button type="button" class="btn btn-green" id="moveBtn">Move</button>
            <button type="button" class="btn btn-ghost" id="newGroupBtn">+ New group</button>
        </div>
        <p class="breed muted small" style="margin:0 0 10px">Scroll sideways for breeding columns (does) and kid milk columns. Use the filter dropdown or chips for kiddings, mother score, cull, mother group, and milk type.</p>
        <div class="herd-table-scroll">
        <table class="tbl herd-breed-cols"><thead><tr>
            <th style="width:34px"><input type="checkbox" id="checkAll"></th>
            <th>Tag</th><th class="hide-sm">Breed</th><th>Age</th><th>Status</th>
            <th class="hide-sm herd-doe-col">Breeding</th>
            <th class="hide-sm herd-doe-col">Next job</th>
            <th class="hide-sm herd-doe-col num-cell">Pregnant</th>
            <th class="hide-sm herd-doe-col num-cell">Kiddings</th>
            <th class="hide-sm herd-doe-col">Last kidding</th>
            <th class="hide-sm herd-doe-col">Born / alive</th>
            <th class="hide-sm herd-doe-col">Mother score</th>
            <th class="hide-sm herd-doe-col num-cell">BCS</th>
            <th class="hide-sm herd-doe-col">Health</th>
            <th class="hide-sm herd-doe-col">Decision</th>
            <th class="hide-sm herd-doe-col">Mother grp</th>
            <th class="hide-sm herd-kid-col">Mother</th>
            <th class="hide-sm herd-kid-col">Milk type</th>
            <th class="hide-sm herd-kid-col">Milk</th>
            <th class="hide-sm herd-kid-col">Wean date</th>
            <th class="hide-sm num-cell">Price</th><th class="hide-sm">Date</th>
        </tr></thead><tbody id="rows">
            @foreach (var g in Model.Goats)
            {
                <tr class="goat-row" data-id="@g.Id"
                    data-tag="@g.Tag"
                    data-name="@g.Name"
                    data-comment="@g.Comment"
                    data-breed="@g.Breed"
                    data-gender="@g.Gender"
                    data-source="@g.Source"
                    data-price="@g.PurchasePrice"
                    data-status="@g.Status"
                    data-date="@g.EventDateDisplay"
                    data-dob="@g.DateOfBirthDisplay"
                    data-dob-est="@(g.DateOfBirthIsEstimated ? "1" : "")"
                    data-health="@g.HealthState"
                    data-owner="@g.Owner"
                    data-sire="@g.SireTag"
                    data-dam="@g.DamTag">
                    <td><input type="checkbox" data-id="@g.Id"></td>
                    <td>
                        <a class="tag tag-link" href="/Search?tag=@Uri.EscapeDataString(g.Tag)" title="Open full profile">@g.Tag</a>
                        <a href="#" class="breed" data-goatcard="@g.Id" title="Quick card" style="margin-left:4px;font-size:11px">card</a>
                        @if (g.IsTemporaryTag)
                        {
                            <button type="button" class="treebtn" title="Give this kid a permanent ear tag" data-goatcard="@g.Id">🏷 Tag</button>
                        }
                        else
                        {
                            <button type="button" class="treebtn" title="Family tree" data-goatcard="@g.Id">🌳 Tree</button>
                        }
                        @if(!string.IsNullOrEmpty(g.Name)){<div class="name">@g.Name</div>}
                        @if(g.IsTemporaryTag){<div class="name" style="color:#8a5b13;font-weight:700">temporary tag · needs ear tag</div>}
                        @if(!string.IsNullOrEmpty(g.Owner)){<div class="name">Owner: @g.Owner</div>}
                        @if(!string.IsNullOrEmpty(g.Comment)){<div class="name" style="opacity:.75">@g.Comment</div>}
                    </td>
                    <td class="hide-sm"><span class="breed">@g.Breed</span></td>
                    <td>@if (g.AgeDays is { } days)
                        {<span class="age-d">@(g.AgeIsEstimated ? "~" : "")@days</span> <span class="age-m">days · @g.AgeLabel@(g.AgeIsEstimated ? " · estimated" : "")</span>}
                        else
                        {<span class="age-m" title="Bought goat without a date of birth">age unknown</span>}</td>
                    <td><span class="chip @g.StatusCssClass">@g.StatusDisplay</span>
                        @if (g.HealthState != GoatHealthState.Healthy)
                        {<span class="chip chip-urgent">@g.HealthDisplay</span>}
                        @if (!string.IsNullOrEmpty(g.BreedingHint))
                        {<div class="name" style="color:@g.BreedingHintColor;font-weight:700">@g.BreedingHint</div>}
                        @if (!string.IsNullOrEmpty(g.KidStageLine))
                        {
                            <div class="name v207-stage" style="color:@(g.KidStageColor ?? "var(--ink-soft)");font-weight:700">
                                @g.KidStageLine
                                @if (g.KidStageWeanLink)
                                {
                                    <button type="button" class="linkish" data-herd-wean="@g.Id" data-tag="@g.Tag">wean now</button>
                                }
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(g.NextStepLabel) && !string.IsNullOrEmpty(g.NextStepAction))
                        {
                            <div class="herd-nextstep-wrap">
                                <button type="button" class="btn btn-green btn-sm herd-nextstep"
                                        data-herd-nextstep="@g.NextStepAction"
                                        data-id="@g.Id"
                                        data-tag="@g.Tag"
                                        data-kids="@(g.NextStepKidsCount?.ToString() ?? "")"
                                        data-perm-tab="@g.NextStepPermTab"
                                        data-perm-action="@g.NextStepPermAction">@g.NextStepLabel</button>
                            </div>
                        }
                    </td>
                    @{
                        var isKid = g.Status == GoatStatus.Kid;
                        var isDoe = g.Gender == GoatGender.Female && !isKid;
                    }
                    <td class="hide-sm herd-doe-col">@if (isDoe && !string.IsNullOrEmpty(g.HerdBreedingStatus))
                        {<span class="chip @g.HerdBreedingStatusCss">@g.HerdBreedingStatus</span>}
                        else if (!isKid) { <span class="breed">—</span> }</td>
                    <td class="hide-sm herd-doe-col">@if (isDoe) { <span class="breed">@(g.HerdNextJob ?? "—")</span> }</td>
                    <td class="hide-sm herd-doe-col num-cell">@if (isDoe) { @(g.TimesPregnant?.ToString() ?? "—") }</td>
                    <td class="hide-sm herd-doe-col num-cell">@if (isDoe)
                        {
                            var kdTot = g.KiddingsTotal ?? 0;
                            <span class="breed">@kdTot×</span>
                            @if (g.KiddingsBeforePurchase > 0)
                            {
                                <div class="name muted small">incl. @g.KiddingsBeforePurchase before farm</div>
                            }
                        }</td>
                    <td class="hide-sm herd-doe-col">@if (isDoe) { @(g.LastKiddingDate ?? "—") }</td>
                    <td class="hide-sm herd-doe-col">@if (isDoe)
                        {
                            if (g.KidsBornTotal is > 0){@($"{g.KidsBornTotal} / {g.KidsAliveTotal}")}
                            else{<span class="breed">—</span>}
                        }</td>
                    <td class="hide-sm herd-doe-col">@if (isDoe && !string.IsNullOrEmpty(g.MotherScoreHtml))
                        {@Html.Raw(g.MotherScoreHtml)}
                        else if (isDoe) { <span class="breed">—</span> }</td>
                    <td class="hide-sm herd-doe-col num-cell">@if (isDoe && g.LatestBcs is { } bcs) { @($"{bcs}/5") }</td>
                    <td class="hide-sm herd-doe-col">@if (isDoe)
                        {<span class="breed">@(g.DamAfterKiddingHealth ?? g.HealthDisplay)</span>}</td>
                    <td class="hide-sm herd-doe-col">@if (isDoe) { <span class="breed">@(g.KeepDecision ?? "—")</span> }</td>
                    <td class="hide-sm herd-doe-col">@if (isDoe && !string.IsNullOrEmpty(g.MotherGroupName))
                        {<span style="color:@(g.MotherGroupColor ?? "var(--green)");font-weight:700">● @g.MotherGroupName</span>}</td>
                    <td class="hide-sm herd-kid-col">@if (isKid) { <span class="breed">@(g.KidMotherTag ?? "—")</span> }</td>
                    <td class="hide-sm herd-kid-col">@if (isKid) { <span class="breed">@(g.KidMilkTypeDisplay ?? "—")</span> }</td>
                    <td class="hide-sm herd-kid-col">@if (isKid) { <span class="breed">@(g.KidMilkStatus ?? "—")</span> }</td>
                    <td class="hide-sm herd-kid-col">@if (isKid) { <span class="breed">@(g.KidWeanDateDisplay ?? "—")</span> }</td>
                    <td class="hide-sm num-cell">@if(g.Source == GoatSource.Born){<span class="breed">home-bred</span>}else{<span class="breed">@DisplayHelper.FormatRs(g.PurchasePrice)</span>}</td>
                    <td class="hide-sm"><span class="breed">@g.EventDateDisplay</span></td>
                </tr>
            }
        </tbody></table>
        </div>
        <div class="empty" id="empty" style="display:@(Model.Pagination.TotalItems > 0 ? "none" : "block")">@(string.IsNullOrEmpty(Model.Search) ? "No goats match this filter." : "No goats match this search and filter.")</div>
        @await Html.PartialAsync("_HerdPagination", Model.Pagination)
    </div>
</div>
</div>

@section Scripts {
<script>GoatRecords.initHerd(Object.assign(@Html.Raw(herdInitJson), { editGoat: @Html.Raw(editGoatJson) }));</script>
}
