@model GoatFarm.Application.ViewModels.Goats.PaginationViewModel
@{
    var filter = ViewBag.HerdFilter as string ?? "all";
    var current = Model.Page;
    var total = Model.TotalPages;

    var pages = new List<int>();
    if (total <= 7)
    {
        for (var i = 1; i <= total; i++) pages.Add(i);
    }
    else
    {
        pages.Add(1);
        var start = Math.Max(2, current - 1);
        var end = Math.Min(total - 1, current + 1);
        if (start > 2) pages.Add(-1);
        for (var i = start; i <= end; i++) pages.Add(i);
        if (end < total - 1) pages.Add(-1);
        pages.Add(total);
    }

    string PageUrl(int p) => Url.Action("Index", "Goat", new { filter, page = p }) ?? "#";
}

@if (Model.TotalItems > 0)
{
    <div class="pager">
        <div class="pager-info">
            Showing <b>@Model.StartItem&ndash;@Model.EndItem</b> of <b>@Model.TotalItems</b> goats
        </div>
        @if (Model.TotalPages > 1)
        {
            <nav class="pager-nav" aria-label="Herd pagination">
                @if (Model.HasPrevious)
                {
                    <a class="pager-btn" href="@PageUrl(current - 1)">← Prev</a>
                }
                else
                {
                    <span class="pager-btn disabled">← Prev</span>
                }

                @foreach (var p in pages)
                {
                    if (p == -1)
                    {
                        <span class="pager-ellipsis">…</span>
                    }
                    else if (p == current)
                    {
                        <span class="pager-btn active">@p</span>
                    }
                    else
                    {
                        <a class="pager-btn" href="@PageUrl(p)">@p</a>
                    }
                }

                @if (Model.HasNext)
                {
                    <a class="pager-btn" href="@PageUrl(current + 1)">Next →</a>
                }
                else
                {
                    <span class="pager-btn disabled">Next →</span>
                }
            </nav>
        }
    </div>
}
