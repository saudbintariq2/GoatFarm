@model GoatFarm.Application.ViewModels.Breeding.BreedingPageViewModel
@using GoatFarm.Application.Common
@using System.Text.Json

<nav class="breed-subnav" id="breedSubnav" aria-label="Breeding sections">
    <button type="button" class="breed-subnav-btn on" data-breed-view="today">
        Today
        @if (Model.NowJobs.Count > 0)
        {
            <span class="breed-subnav-count">@Model.NowJobs.Count</span>
        }
    </button>
    <button type="button" class="breed-subnav-btn" data-breed-view="plan">Season plan</button>
    <button type="button" class="breed-subnav-btn" data-breed-view="bucks">Bucks</button>
    <button type="button" class="breed-subnav-btn" data-breed-view="does">
        Does
        @if (Model.WaitingCount > 0)
        {
            <span class="breed-subnav-count">@Model.WaitingCount</span>
        }
    </button>
    <button type="button" class="breed-subnav-btn" data-breed-view="kidding">Kidding</button>
    <button type="button" class="breed-subnav-btn" data-breed-view="reports">Reports</button>
</nav>

<section class="breed-view on" data-breed-view="today" id="breedViewToday">
<div class="breed-ph">
    <div class="breed-eyebrow">Breeding</div>
    <h1 class="breed-ph-title">Today</h1>
    <p class="breed muted small">Here is what the herd needs from you in breeding.</p>
</div>
<div class="stats breed-today-stats" id="breedTodayStats">
    <div class="stat"><div class="v" id="breedExp">@Model.ExpectingCount</div><div class="l">Pregnant (scanned)</div></div>
    <div class="stat"><div class="v" id="breedWaitNum">@Model.WaitingCount</div><div class="l">Crossed · waiting scan</div></div>
    <div class="stat"><div class="v" id="breedPrep">@Model.GettingReadyCount</div><div class="l">Getting ready</div></div>
    <div class="stat"><div class="v">@Model.BuckCount<small> · @Model.ActiveBreedingGroupCount groups</small></div><div class="l">Bucks</div></div>
    <div class="stat"><div class="v">@Model.WeanedKgPerDoeText</div><div class="l">Weaned per doe crossed</div></div>
</div>
<p class="breed muted small" id="breedNext" style="margin:-6px 0 14px 0">@Model.NextDueText</p>

<div class="breed-today-grid">
    <div class="panel">
        <div class="panel-head"><h2>To do</h2><span class="sub" id="nowSub">soonest first</span></div>
        <div class="panel-body">
            @if (Model.NowJobs.Any())
            {
                <ul class="breed-todo" id="nowList">
                    @foreach (var j in Model.NowJobs)
                    {
                        var icClass = j.UrgencyKey switch { "no" => "no", "ok" => "ok", _ => "wt" };
                        var icSym = j.UrgencyKey switch { "no" => "!", "ok" => "✓", _ => "•" };
                        <li class="breed-todo-row">
                            <span class="breed-todo-ic @icClass" aria-hidden="true">@icSym</span>
                            <span class="breed-todo-when">
                                @j.WhenLabel
                                <small>@j.WhenSubtext</small>
                            </span>
                            <span class="breed-todo-what">
                                <b>@j.Icon @j.Text</b>
                                @if (!string.IsNullOrWhiteSpace(j.Subtext))
                                {
                                    <span class="breed breed-todo-sub">@j.Subtext</span>
                                }
                                @if (j.Tags.Count > 0)
                                {
                                    <span class="breed">@string.Join(", ", j.Tags.Take(8))@(j.Tags.Count > 8 ? " …" : "")</span>
                                }
                            </span>
                            @if (!string.IsNullOrEmpty(j.BreedView))
                            {
                                <button type="button" class="btn btn-ghost btn-sm breed-todo-act"
                                        data-breed-goto="@j.BreedView"
                                        data-breed-scan="@(j.OpenScan ? "1" : null)">@j.ActionLabel</button>
                            }
                            else if (j.ActionLabel == "Weigh")
                            {
                                <a class="btn btn-ghost btn-sm breed-todo-act" asp-controller="Goat" asp-action="Index">@j.ActionLabel</a>
                            }
                            else if (!string.IsNullOrEmpty(j.FilterLink))
                            {
                                <a class="btn btn-ghost btn-sm breed-todo-act" href="/Goat?filter=@Uri.EscapeDataString(j.FilterLink!)">@j.ActionLabel</a>
                            }
                        </li>
                    }
                </ul>
            }
            else
            {
                <div class="alldone" id="nowList">✓ Nothing scheduled in breeding. Open <button type="button" class="btn btn-ghost btn-sm" data-breed-goto="plan">Season plan</button> for the next job.</div>
            }
        </div>
    </div>
    <div class="panel">
        <div class="panel-head breed-season-head">
            <h2>This season</h2>
            <span class="sub">@Model.TodaySeasonName</span>
            <button type="button" class="btn btn-ghost btn-sm" data-breed-goto="plan">Open plan</button>
        </div>
        <div class="panel-body">
            <div class="breed-plan-tl breed-today-plan-tl" aria-hidden="true">
                <div class="breed-plan-tl-track">
                    <div class="breed-plan-tl-base"></div>
                    @foreach (var seg in Model.TodayPlanTimelineSegments)
                    {
                        <div class="breed-plan-tl-bar" style="left:@(seg.LeftPercent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%;width:@(seg.WidthPercent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%;background:@seg.Color" title="@seg.Title"></div>
                    }
                    <div class="breed-season-tl-today breed-plan-tl-today" style="left:@(Model.TodayPlanTimelineTodayPercent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%"><span>Today</span></div>
                </div>
                <div class="breed-today-tl-labels">
                    @foreach (var lab in Model.TodayTimelineLabels)
                    {
                        <div class="breed-today-tl-lab@(lab.AlignEnd ? " breed-today-tl-lab--end" : "")" style="left:@(lab.LeftPercent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%">@lab.DateText</div>
                    }
                </div>
            </div>
            <div class="breed-plan-legend breed-today-legend">
                <span><i style="background:#D8C38F"></i>Feeding</span>
                <span><i style="background:#A9BFCB"></i>Dry off / stop milking</span>
                <span><i style="background:#D9826B"></i>Crossing</span>
                <span><i style="background:#8C9BD0"></i>Scan</span>
                <span><i style="background:#6FB07C"></i>Births</span>
                <span><i style="background:#E5AE5C"></i>Weaning</span>
            </div>
            <ul class="breed-season-next">
                @foreach (var step in Model.TodaySeasonNext)
                {
                    <li>
                        <span class="breed-season-step-ico" aria-hidden="true">@step.Icon</span>
                        <b>@step.Label</b>
                        <span class="breed muted small" style="margin-left:auto">@step.WindowText · @step.DaysText</span>
                    </li>
                }
            </ul>
        </div>
    </div>
</div>

<div class="panel">
    <div class="panel-head"><h2>Buck workload</h2><span class="sub">do not overwork one buck</span></div>
    <div class="panel-body">
        <table class="tbl"><thead><tr><th>Buck</th><th class="num-cell">Does carrying now</th>
            <th class="num-cell hide-sm">Crosses this year</th><th class="num-cell">Conception</th>
            <th class="hide-sm">Last used</th><th>Load</th></tr></thead>
            <tbody id="buckRowsToday">
            @foreach (var b in Model.BuckRows)
            {
                <tr>
                    <td><a href="#" class="tag" data-goatcard="@b.Id">@b.Tag</a></td>
                    <td class="num-cell" style="font-weight:700">@b.Carrying</td>
                    <td class="num-cell hide-sm">@b.CrossesThisYear</td>
                    <td class="num-cell" style="@b.ConceptionStyle">@b.ConceptionText</td>
                    <td class="hide-sm"><span class="breed">@(b.LastUsed ?? "—")</span></td>
                    <td><span style="color:@b.LoadColor;font-weight:700">@b.LoadText</span></td>
                </tr>
            }
            @if (!Model.BuckRows.Any())
            {
                <tr><td colspan="6" class="empty">No bucks in the herd.</td></tr>
            }
            </tbody></table>
    </div>
</div>
</section>

<section class="breed-view" data-breed-view="plan" id="breedViewPlan" hidden>
<div class="breed-ph">
    <div class="breed-eyebrow">Planning</div>
    <h1 class="breed-ph-title">Season plan</h1>
    <p class="breed muted small">Birth groups and rules — each group has its own dates.</p>
</div>
<nav class="breed-plan-tabs" id="sePlanTabs" aria-label="Birth groups">
    @foreach (var b in Model.Season.Batches)
    {
        <button type="button" class="breed-plan-tab@(b.Id == Model.Season.SelectedBatchId ? " on" : "")" data-se-batch="@b.Id">
            <b>@b.Icon @b.Name</b>
            <span class="breed muted small">Kids @b.BirthWindowText</span>
        </button>
    }
    <button type="button" class="breed-plan-tab breed-plan-tab--add" id="se-add-chip" aria-label="Add birth group">＋ Add birth group</button>
</nav>
<div class="panel breed-new-batch-panel" id="se-new-batch-panel" hidden>
    <div class="panel-head">
        <h2>New birth group</h2>
        <button type="button" class="btn btn-ghost btn-sm" id="se-np-close">Close</button>
    </div>
    <div class="panel-body">
        <p class="breed" style="margin:0 0 12px">
            Call it <input type="text" id="se-np-name" class="breed-np-in" placeholder="e.g. December births" style="max-width:220px" autocomplete="off" />
            <select id="se-np-emo" class="breed-np-in" aria-label="Icon">
                @foreach (var ic in new[] { "🍂", "🌸", "❄️", "☀️", "🌧️", "⭐", "🌙", "🌾" })
                {
                    if (ic == "❄️")
                    {
                        <option value="@ic" selected>@ic</option>
                    }
                    else
                    {
                        <option value="@ic">@ic</option>
                    }
                }
            </select>
        </p>
        <p class="breed" style="margin:0 0 12px">
            Kids should be born between
            <input type="date" id="se-np-from" class="breed-np-in" />
            and <input type="date" id="se-np-to" class="breed-np-in" />
        </p>
        <p class="breed" style="margin:0 0 12px">
            Start with the same rules as
            <select id="se-np-copy" class="breed-np-in">
                @foreach (var b in Model.Season.Batches)
                {
                    if (b.Id == Model.Season.SelectedBatchId)
                    {
                        <option value="@b.Id" selected>@b.Icon @b.Name</option>
                    }
                    else
                    {
                        <option value="@b.Id">@b.Icon @b.Name</option>
                    }
                }
            </select>
            <span class="breed muted small">(season feed, scan, and wean rules are shared for now)</span>
        </p>
        <div class="breed-np-calc" id="se-np-calc" aria-live="polite"></div>
        <div style="display:flex;gap:10px;margin-top:16px;flex-wrap:wrap">
            <button type="button" class="btn btn-green btn-sm" id="se-np-save">Create group</button>
            <button type="button" class="btn btn-ghost btn-sm" id="se-np-cancel">Cancel</button>
        </div>
    </div>
</div>
<div id="breed-season-rules" hidden
     data-build="@Model.Season.BuildUp"
     data-scan="@Model.Season.ScanAfter"
     data-wean="@Model.Season.WeanDays"
     data-gest="@BreedingHelper.GestationDays"></div>
<div class="panel">
    <div class="panel-head"><h2>Season plan</h2><span class="sub" id="seasonSub">@Model.Season.SeasonSub</span></div>
    <div class="panel-body">
        <div class="note" style="margin:0 0 14px 0">A doe gives birth <b>once a year</b>, so a group crossed in
            April gives birth in September and is crossed again the following April. Run two groups six months apart
            and the farm has births twice a year. <b>The birth window is the one date you choose</b> — the green row;
            everything else is counted from it.</div>
        <div class="filterbar" style="margin-bottom:14px">
            <div class="field"><label class="hide-sm">Group</label><select id="se-batch">
                @foreach (var b in Model.Season.Batches)
                {
                    if (b.Id == Model.Season.SelectedBatchId)
                    {
                        <option value="@b.Id" selected>@b.Name</option>
                    }
                    else
                    {
                        <option value="@b.Id">@b.Name</option>
                    }
                }
            </select></div>
            <button type="button" class="btn btn-ghost btn-sm" id="se-rename">✎ Rename</button>
            <button type="button" class="btn btn-ghost btn-sm" id="se-copy">Duplicate</button>
            <button type="button" class="btn btn-ghost btn-sm" id="se-add">＋ Add birth group</button>
            <button type="button" class="btn btn-ghost btn-sm" id="se-del">× Remove</button>
            <span class="count-pill" id="se-count">@Model.Season.BatchCountText</span>
            <button type="button" class="btn btn-ghost btn-sm" id="br-reconcile" title="Fix herd status vs breeding records">Sync pregnancy status</button>
        </div>
        <table class="tbl"><thead><tr><th>Step</th><th>Rule — change any number</th>
            <th class="hide-sm">Date it happens</th><th class="num-cell">Days from today<div id="se-todayNote" style="font-weight:400;text-transform:none;font-size:10px"></div></th></tr></thead>
            <tbody id="seasonRows">
            @foreach (var step in Model.Season.Steps)
            {
                var rowStyle = step.Anchor ? "background:var(--green-tint)" : "";
                <tr style="@rowStyle">
                    <td><b>@step.Icon @step.Label</b></td>
                    <td><span style="font-size:13.5px">@Html.Raw(BreedingSeasonRuleRenderer.RuleHtml(step, Model.Season))</span></td>
                    <td class="hide-sm"><span class="breed">@step.WindowText</span></td>
                    <td class="num-cell" style="@step.DaysStyle">@step.DaysText</td>
                </tr>
            }
            </tbody></table>
        <div class="breed-plan-tl" id="planTimeline" aria-hidden="true">
            <div class="breed-plan-tl-track">
                <div class="breed-plan-tl-base"></div>
                @foreach (var seg in Model.PlanTimelineSegments)
                {
                    <div class="breed-plan-tl-bar" style="left:@(seg.LeftPercent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%;width:@(seg.WidthPercent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%;background:@seg.Color" title="@seg.Title"></div>
                }
                <div class="breed-season-tl-today breed-plan-tl-today" style="left:@(Model.PlanTimelineTodayPercent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%"><span>Today</span></div>
            </div>
        </div>
        <div class="breed-plan-legend">
            <span><i style="background:#D8C38F"></i>Feeding</span>
            <span><i style="background:#A9BFCB"></i>Dry off / stop milking</span>
            <span><i style="background:#D9826B"></i>Crossing</span>
            <span><i style="background:#8C9BD0"></i>Scan</span>
            <span><i style="background:#6FB07C"></i>Births</span>
            <span><i style="background:#E5AE5C"></i>Weaning</span>
        </div>
    </div>
</div>

<div class="panel">
    <div class="panel-head"><h2>All groups at a glance</h2><span class="sub">tap a row to open that group</span></div>
    <div class="panel-body"><table class="tbl"><thead><tr><th>Group</th><th>Kids born</th><th class="num-cell">Does</th>
        <th>Cross</th><th class="hide-sm">Scan</th><th class="hide-sm">Dry off</th><th class="hide-sm">Wean</th>
        <th class="num-cell">Buck groups</th><th class="num-cell">Next job</th></tr></thead>
        <tbody id="yearRows">
        @foreach (var y in Model.YearRows)
        {
            <tr class="breed-year-row@(y.Highlight ? " on" : "")" data-se-open="@y.BatchId" style="@(y.Highlight ? "background:var(--green-tint)" : null)">
                <td><b>@y.Icon @y.Name</b></td>
                <td><span class="breed">@y.BirthWindowText</span></td>
                <td class="num-cell">@y.DoeCount</td>
                <td>@Html.Raw(y.CrossText)</td>
                <td class="hide-sm"><span class="breed">@y.ScanText</span></td>
                <td class="hide-sm"><span class="breed">@y.DryText</span></td>
                <td class="hide-sm"><span class="breed">@y.WeanText</span></td>
                <td class="num-cell">@y.BuckGroupCount</td>
                <td class="num-cell" style="@y.NextJobStyle">@y.NextJobText</td>
            </tr>
        }
        </tbody></table></div>
</div>

<div class="panel breed-plan-cta">
    <div class="breed-plan-cta-text"><b>@Model.SelectedBatchBuckGroupCount buck group@(Model.SelectedBatchBuckGroupCount == 1 ? "" : "s")</b> in @Model.TodaySeasonName
        <div class="breed muted small">Put bucks with does for this group on the Bucks tab.</div></div>
    <button type="button" class="btn btn-green btn-sm" data-breed-goto="bucks" id="planToBucks">+ Add buck group</button>
</div>

<div class="panel">
    <div class="panel-head"><h2>Does against the plan</h2><span class="sub">who is on track for the window</span></div>
    <div class="panel-body"><table class="tbl"><thead><tr><th>Doe</th><th class="hide-sm">Status</th>
        <th class="hide-sm">Batch</th><th class="hide-sm">BCS</th><th>Where she stands</th></tr></thead>
        <tbody id="planRows">
        @foreach (var p in Model.PlanRows)
        {
            <tr>
                <td><a href="#" class="tag" data-goatcard="@p.Id">@p.Tag</a></td>
                <td class="hide-sm"><span class="chip @p.StatusCssClass">@p.StatusDisplay</span></td>
                <td class="hide-sm">@Html.Raw(p.BatchHtml)</td>
                <td class="hide-sm">@Html.Raw(p.BcsHtml)</td>
                <td style="color:@p.StandColor;font-weight:600">@p.StandText</td>
            </tr>
        }
        @if (!Model.PlanRows.Any())
        {
            <tr><td colspan="5" class="empty">No does yet.</td></tr>
        }
        </tbody></table></div>
</div>
</section>

<section class="breed-view" data-breed-view="bucks" id="breedViewBucks" hidden>
<div class="breed-ph breed-ph--row">
    <div>
        <div class="breed-eyebrow">Bucks &amp; breeding groups</div>
        <h1 class="breed-ph-title">Bucks</h1>
        <p class="breed muted small">Buck workload, breeding groups, and results.</p>
    </div>
    <div class="breed-ph-actions">
        <a class="btn btn-ghost btn-sm" asp-controller="Goat" asp-action="Index">Open herd to record buck data</a>
        <button type="button" class="btn btn-ghost btn-sm" id="bucksOpenCheck">🩺 Record buck check</button>
        <button type="button" class="btn btn-green btn-sm" id="bucksJumpCreate">＋ New breeding group</button>
    </div>
</div>
<div class="panel" id="buckCheckPanel" hidden>
    <div class="panel-head"><h2>Buck check</h2><button type="button" class="btn btn-ghost btn-sm" id="buckCheckClose">Close</button></div>
    <div class="panel-body">
        <div class="add-grid" style="grid-template-columns:repeat(auto-fit,minmax(180px,1fr))">
            <div class="field"><label for="bc-check-buck">Buck</label><select id="bc-check-buck">
                @foreach (var b in Model.BuckRows)
                {
                    <option value="@b.Id">@b.Tag</option>
                }
            </select></div>
            <div class="field"><label for="bc-check-date">Check date</label><input type="date" id="bc-check-date" value="@DateTime.Today.ToString("yyyy-MM-dd")"/></div>
            <div class="field"><label for="bc-check-kg">Weight (kg)</label><input type="number" id="bc-check-kg" step="0.1" min="0" placeholder="optional"/></div>
            <div class="field"><label for="bc-check-bcs">BCS / 5</label><select id="bc-check-bcs">
                <option value="">—</option>
                @for (var s = 1; s <= 5; s++)
                {
                    if (s == 3)
                    {
                        <option value="@s" selected>@s</option>
                    }
                    else
                    {
                        <option value="@s">@s</option>
                    }
                }
            </select></div>
            <div class="field"><label for="bc-check-feet">Feet</label><select id="bc-check-feet"><option value="good">Good</option><option value="needs trim">Needs trim</option><option value="problem">Problem</option></select></div>
            <div class="field"><label for="bc-check-teeth">Teeth</label><select id="bc-check-teeth"><option value="good">Good</option><option value="worn">Worn</option></select></div>
            <div class="field"><label for="bc-check-test">Testicles</label><select id="bc-check-test"><option value="normal">Normal</option><option value="small / uneven">Small / uneven</option><option value="problem">Problem</option></select></div>
        </div>
        <div class="field" style="margin-top:10px"><label for="bc-check-note">Note</label><textarea id="bc-check-note" rows="2" placeholder="Optional"></textarea></div>
        <button type="button" class="btn btn-green btn-sm" id="bc-check-save" style="margin-top:12px">Save check</button>
    </div>
</div>
@if (Model.BuckRows.Any())
{
    <div class="breed-buck-cards">
        @foreach (var b in Model.BuckRows)
        {
            <div class="breed-buck-card">
                <b><a href="#" class="tag" data-goatcard="@b.Id">@b.Tag</a></b>
                <span class="breed" style="color:@b.LoadColor">@b.Carrying does carrying · @b.ConceptionText conception · @b.LoadText</span>
                <span class="breed" style="font-size:12px;color:@(b.BuckCheckOk ? "var(--green-dark)" : "#8a261c");font-weight:600">
                    @(b.BuckCheckOk ? "✓" : "!") @b.BuckCheckLineHtml
                    @if (!b.BuckCheckOk)
                    {
                        <button type="button" class="btn btn-ghost btn-sm" data-buck-check="@b.Id" style="margin-left:6px">Check now</button>
                    }
                </span>
            </div>
        }
    </div>
}
<div class="panel" id="bgPanel">
    <div class="panel-head"><h2>Breeding groups (buck groups)</h2><span class="sub">put one buck with a set of does · every doe keeps her own record</span></div>
    <div class="panel-body">
        <div class="breed-bg-meter" id="bg-meter" hidden>
            <div class="breed-bg-meter-fill" id="bg-meter-fill"></div>
        </div>
        <div class="filterbar" style="margin-bottom:10px;flex-wrap:wrap">
            <div class="field" style="flex:1;min-width:180px"><label for="bg-find">Find a doe</label><input id="bg-find" placeholder="Type or scan a tag" autocomplete="off"/></div>
            <div class="field"><label for="bg-mother-group">Mother group</label>
                <select id="bg-mother-group" title="Filter does e.g. all 3 kids mothers for one buck">
                    <option value="all">Any (@Model.GroupCandidates.Count)</option>
                    @{
                        var bgNoMg = Model.GroupCandidates.Count(g => string.IsNullOrEmpty(g.MotherGroupId));
                    }
                    <option value="none">No group set (@bgNoMg)</option>
                    @foreach (var mg in Model.MotherGroups.OrderBy(x => x.Order))
                    {
                        var c = Model.GroupCandidates.Count(g => g.MotherGroupId == mg.Id);
                        <option value="@mg.Id">@mg.Name (@c)</option>
                    }
                </select>
            </div>
            <label class="checkline" style="display:flex;gap:8px;align-items:center;font-size:13px"><input type="checkbox" id="bg-ready-only"> Ready only</label>
            <button type="button" class="btn btn-ghost btn-sm" id="bg-all-shown">Select all shown</button>
            <button type="button" class="btn btn-ghost btn-sm" id="bg-all-ready">Select all ready</button>
            <button type="button" class="btn btn-ghost btn-sm" id="bg-clear">Clear</button>
        </div>
        <div class="add-grid" id="bgForm" style="grid-template-columns:repeat(auto-fit,minmax(160px,1fr))">
            <div class="field"><label for="bg-batch">Birth group (season)</label><select id="bg-batch">
                @foreach (var b in Model.Season.Batches)
                {
                    if (b.Id == Model.Season.SelectedBatchId)
                    {
                        <option value="@b.Id" selected>@b.Icon @b.Name</option>
                    }
                    else
                    {
                        <option value="@b.Id">@b.Icon @b.Name</option>
                    }
                }
            </select></div>
            <div class="field"><label for="bg-buck">Buck</label><select id="bg-buck">
                @foreach (var b in Model.BuckOptions)
                {
                    <option value="@b">@b</option>
                }
                @if (!Model.BuckOptions.Any())
                {
                    <option value="">No adult buck in herd</option>
                }
            </select></div>
            <div class="field"><label for="bg-date">Buck in</label><input id="bg-date" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")"></div>
            <div class="field"><label for="bg-stay">Days with does</label><input id="bg-stay" type="number" min="1" max="120" value="42"></div>
            <div class="field"><label for="bg-out">Buck out (planned)</label><input id="bg-out" type="date" readonly style="background:var(--green-tint)"></div>
            <div class="field"><label for="bg-max">Does per buck (max)</label><input id="bg-max" type="number" min="1" value="15"></div>
            <div class="field"><label for="bg-n">Select first</label><div style="display:flex;gap:6px"><input id="bg-n" type="number" min="1" placeholder="e.g. 15" style="min-width:0"/><button type="button" class="btn btn-ghost btn-sm" id="bg-pick">Pick</button></div></div>
        </div>
        <div class="sub" id="bg-count" style="margin:10px 0 6px;font-weight:700"></div>
        <div class="v206-bg-list" id="bg-does">
        @if (Model.GroupCandidates.Any())
        {
            foreach (var g in Model.GroupCandidates)
            {
                <label class="breed-bg-doe@(g.CanPick ? "" : " breed-bg-doe-no")" data-bg-ready="@(g.Ready ? "1" : "0")" data-bg-tag="@g.Tag.ToLowerInvariant()" data-bg-mg="@(g.MotherGroupId ?? "")" data-bg-can="@(g.CanPick ? "1" : "0")" data-bg-block="@(g.BlockReason ?? "")">
                    <input type="checkbox" data-bgdoe="@g.Id"@(g.CanPick ? "" : " disabled")>
                    <b>@g.Tag</b>
                    <span class="breed">@g.Breed@if (g.LatestWeightKg is { } wkg){<text> · @wkg.ToString("0.#") kg</text>}@if (!string.IsNullOrEmpty(g.MotherGroupName)){<text> · @g.MotherGroupName</text>}</span>
                    @if (g.Ready && g.CanPick)
                    {
                        <span class="chip chip-kid">ready</span>
                    }
                    @if (!string.IsNullOrEmpty(g.BlockReason))
                    {
                        <span class="breed-bg-block">✕ @g.BlockReason</span>
                    }
                </label>
            }
        }
        else
        {
            <div class="empty">No does in the herd to show.</div>
        }
        </div>
        <label class="checkline" for="bg-defer" style="display:flex;gap:10px;align-items:center;margin:12px 0;font-size:14px;cursor:pointer">
            <input type="checkbox" id="bg-defer">
            <span>Save group only — record crosses when you tap <strong>Put buck in today</strong> on the card</span>
        </label>
        <div style="margin-top:8px;display:flex;gap:8px;flex-wrap:wrap"><button type="button" class="btn btn-green" id="bg-create">Create breeding group</button></div>
        <div class="v206-bg-groups" id="bg-groups" style="margin-top:16px"
             data-batches='@Html.Raw(JsonSerializer.Serialize(Model.Season.Batches.Select(b => new { id = b.Id, name = b.Name, icon = b.Icon, birthWindowText = b.BirthWindowText })))'></div>
    </div>
</div>

<div class="panel">
    <div class="panel-head"><h2>Buck workload</h2><span class="sub">full detail</span></div>
    <div class="panel-body">
        <table class="tbl"><thead><tr><th>Buck</th><th class="num-cell">Does carrying now</th>
            <th class="num-cell hide-sm">Crosses this year</th><th class="num-cell">Conception</th>
            <th class="hide-sm">Last used</th><th>Load</th></tr></thead>
            <tbody id="buckRows">
            @foreach (var b in Model.BuckRows)
            {
                <tr>
                    <td><a href="#" class="tag" data-goatcard="@b.Id">@b.Tag</a></td>
                    <td class="num-cell" style="font-weight:700">@b.Carrying</td>
                    <td class="num-cell hide-sm">@b.CrossesThisYear</td>
                    <td class="num-cell" style="@b.ConceptionStyle">@b.ConceptionText</td>
                    <td class="hide-sm"><span class="breed">@(b.LastUsed ?? "—")</span></td>
                    <td><span style="color:@b.LoadColor;font-weight:700">@b.LoadText</span></td>
                </tr>
            }
            @if (!Model.BuckRows.Any())
            {
                <tr><td colspan="6" class="empty">No bucks in the herd.</td></tr>
            }
            </tbody></table>
    </div>
</div>

<div class="panel">
    <div class="panel-head"><h2>Buck ranking</h2><span class="sub">all seasons</span></div>
    <div class="panel-body">
        <table class="tbl"><thead><tr><th>Buck</th><th class="num-cell">Conception</th><th class="num-cell">Kids per kidding</th>
            <th class="num-cell">Avg birth kg</th><th class="num-cell">Avg 90-day kg</th><th class="num-cell">Kids sired</th></tr></thead>
            <tbody>
            @foreach (var b in Model.BuckRows.OrderByDescending(x => x.ConceptionPercent ?? -1).ThenByDescending(x => x.KidsSired))
            {
                <tr>
                    <td><a href="#" class="tag" data-goatcard="@b.Id">@b.Tag</a></td>
                    <td class="num-cell" style="@b.ConceptionStyle">@b.ConceptionText</td>
                    <td class="num-cell">@b.KidsPerKiddingText</td>
                    <td class="num-cell">@b.AvgBirthKgText</td>
                    <td class="num-cell">@b.Avg90DayKgText</td>
                    <td class="num-cell">@b.KidsSired</td>
                </tr>
            }
            @if (!Model.BuckRows.Any())
            {
                <tr><td colspan="6" class="empty">No bucks in the herd.</td></tr>
            }
            </tbody></table>
    </div>
</div>
</section>

<section class="breed-view" data-breed-view="does" id="breedViewDoes" hidden>
<div class="breed-ph breed-ph--row">
    <div>
        <div class="breed-eyebrow">Herd</div>
        <h1 class="breed-ph-title">Does</h1>
        <p class="breed muted small">Pipeline, heat, and ultrasound scans.</p>
    </div>
    <div class="breed-ph-actions">
        <button type="button" class="btn btn-green btn-sm" id="doesOpenScan">🔍 Record scan</button>
        <button type="button" class="btn btn-ghost btn-sm" id="scAllPregHead" hidden>Rest → 🤰 Pregnant</button>
    </div>
</div>
<div class="panel" id="scanPanel">
    <div class="panel-head breed-scan-head">
        <h2>Record scan</h2>
        <span class="sub">one buck group at a time · pregnant only after an ultrasound</span>
        <button type="button" class="btn btn-ghost btn-sm" id="scanClose">Close</button>
        <button type="button" class="btn btn-ghost btn-sm" id="scanReload">Refresh list</button>
    </div>
    <div class="panel-body">
        <div class="scan-top">
            <div class="scan-top-field scan-top-field--groups">
                <label class="small muted" for="scGroups">Buck group</label>
                <div class="scan-gtabs" id="scGroups" role="tablist" aria-label="Buck group"></div>
            </div>
            <div class="scan-top-field scan-top-field--date">
                <label class="small muted" for="scDate">Scan date</label>
                <input type="date" class="scan-date" id="scDate" value="@DateTime.Today.ToString("yyyy-MM-dd")">
            </div>
            <div class="scan-top-field scan-top-field--find">
                <label class="small muted" for="scFind">Find a doe</label>
                <input type="search" class="scan-find" id="scFind" placeholder="🔍 Type or scan a tag" autocomplete="off">
            </div>
        </div>
        <div class="scan-tbl-wrap" id="scTable"></div>
        <div class="scan-foot">
            <div id="scSum" class="small muted"></div>
            <div style="display:flex;gap:8px;flex-wrap:wrap;margin-left:auto;align-items:center">
                <button type="button" class="btn btn-ghost btn-sm" id="scAllPreg">Rest → 🤰 Pregnant</button>
                <button type="button" class="btn btn-ghost btn-sm" id="scClear">Clear choices</button>
                <button type="button" class="btn btn-green btn-sm" id="scSave" disabled>Save results</button>
            </div>
        </div>
    </div>
</div>

<div class="panel" id="doeFlowPanel">
    <div class="panel-head">
        <h2>How a doe moves</h2>
        <span class="sub">tap a stage to see those does</span>
    </div>
    <div class="panel-body">
        <div class="breed-flowline" id="doeFlowLine">
            @for (var i = 0; i < Model.DoeFlowSteps.Count; i++)
            {
                var step = Model.DoeFlowSteps[i];
                <button type="button" class="breed-fnode" data-flow="@step.Key" aria-pressed="false">
                    <b>@step.Count</b>
                    <span>@step.Label</span>
                </button>
                @if (!string.IsNullOrEmpty(step.ArrowLabel))
                {
                    <div class="breed-farrow" aria-hidden="true">@step.ArrowLabel</div>
                }
            }
        </div>
        <div class="breed-flow-branch">
            <span><b>If the scan is empty</b>, you choose:</span>
            <span class="breed-flow-pill breed-flow-pill--blue">back with the buck</span>
            <span class="breed-flow-pill breed-flow-pill--gold">next birth group</span>
            <span class="breed-flow-pill breed-flow-pill--gold">watch for heat</span>
            <span class="breed-flow-pill breed-flow-pill--red">cull list</span>
        </div>
    </div>
</div>

<div class="panel">
    <div class="panel-head"><h2>Breeding</h2>
        <div class="breed-kd-chips" id="brKdFilter" role="tablist" style="margin-bottom:12px">
            <button type="button" class="breed-kd-chip breed-on" data-br-kd="all">All</button>
            @for (var pk = 0; pk <= 4; pk++)
            {
                <button type="button" class="breed-kd-chip" data-br-kd="@pk">@pk×</button>
            }
            <button type="button" class="breed-kd-chip" data-br-kd="5">5+</button>
        </div>
        <div class="filterbar">
            <div class="field"><label class="hide-sm">Show</label>
                <select id="brFilter">
                    <option value="all">All in breeding</option>
                    <option value="plan">0 · Next cross planned</option>
                    <option value="prep">1 · Ready for cross</option>
                    <option value="wait">2 · Waiting for scan</option>
                    <option value="preg">3 · Confirmed pregnant</option>
                    <option value="due30">Due within 30 days</option>
                    <option value="scan">Scan due now</option>
                </select></div>
            <span class="count-pill" id="brCount">@Model.PipelineRows.Count doe(s)</span>
        </div>
    </div>
    <div class="panel-body">
        <table class="tbl"><thead><tr>
            <th>Doe</th><th class="num-cell">Kiddings</th><th class="num-cell">Mother score</th><th>Stage</th><th class="hide-sm">Mated</th><th class="hide-sm">Buck</th>
            <th>Kids</th><th>Key date</th><th class="num-cell">Days</th>
            <th style="width:150px">Change stage</th></tr></thead>
            <tbody id="brRows">
            @foreach (var r in Model.PipelineRows)
            {
                <tr data-br-stage="@r.StageKey" data-br-flow="@r.FlowStageKey" data-br-id="@r.Id" data-doe-profile="@r.Id" data-br-mated="@r.MatedDate" data-br-kids="@(r.KidsCount?.ToString() ?? "")" data-br-kiddings="@r.KiddingsTotal">
                    <td>
                        <a href="#" class="tag" data-doe-profile="@r.Id">@r.Tag</a>
                        @if (!string.IsNullOrEmpty(r.Name))
                        {
                            <div class="name">@r.Name</div>
                        }
                        @if (!string.IsNullOrEmpty(r.Owner))
                        {
                            <div class="name" style="color:var(--blue)">@r.Owner</div>
                        }
                    </td>
                    <td class="num-cell"><span class="breed">@r.KiddingsDisplay</span></td>
                    <td class="num-cell">@(r.MotherScoreHtml != null ? Html.Raw(r.MotherScoreHtml) : Html.Raw("<span class=\"muted\">—</span>"))</td>
                    <td><span class="chip @r.StageCssClass">@r.StageLabel</span></td>
                    <td class="hide-sm"><span class="breed">@(r.MatedDate ?? "—")</span></td>
                    <td class="hide-sm"><span class="breed">@(r.BuckTag ?? "—")</span></td>
                    <td>@Html.Raw(r.KidsHtml)</td>
                    <td>@Html.Raw(r.KeyDateHtml)</td>
                    <td class="num-cell" style="@r.DaysStyle">@r.DaysText</td>
                    <td><select data-bract="@r.Id" data-br-stage="@r.StageKey" style="font-family:inherit;font-size:13px;padding:5px 7px;border:1px solid var(--line);border-radius:7px;width:100%"></select></td>
                </tr>
            }
            @if (!Model.PipelineRows.Any())
            {
                <tr id="brEmpty"><td colspan="10" class="empty">No does in breeding. Add one below.</td></tr>
            }
            </tbody></table>
        <div class="rule" style="margin-top:12px"><b>Change stage</b> on any row to move her forward — each step asks
            for the date it happened. A <b>not pregnant</b> scan counts against conception rate; you choose her next step (back with buck, next birth group, watch for heat, or cull list).</div>
    </div>
</div>

<div class="panel" id="doeProfilePanel" hidden>
    <div class="panel-body" id="doeProfileMount" style="padding-top:20px"></div>
</div>

<div class="panel">
    <div class="panel-head"><h2>Heat &amp; cycles</h2><span class="sub">a doe returns to heat about every 21 days</span></div>
    <div class="panel-body">
        <div class="note" style="margin:0 0 14px 0">Tap <b>♡ Seen today</b> the moment you notice a doe in heat —
            that is the whole job. The app then expects her again in 21 days, which is when to put her to the buck.
            A crossed doe seen in heat did not take: tapping it here catches that three weeks before a scan would.</div>
        <div class="filterbar" style="margin-bottom:12px">
            <div class="field"><label class="hide-sm">Show</label>
                <select id="heatFilter">
                    <option value="active">Does that can cycle</option>
                    <option value="due">Expected in heat now</option>
                    <option value="seen">Only ones I have recorded</option>
                    <option value="all">Every doe</option>
                </select></div>
            <span class="count-pill" id="heatCount">@Model.HeatRows.Count doe(s)</span>
        </div>
        <table class="tbl"><thead><tr><th>Doe</th><th class="hide-sm">Status</th><th>Last seen</th>
            <th class="hide-sm">Next expected</th><th class="num-cell">In</th>
            <th class="num-cell hide-sm">Times</th><th style="width:120px"></th></tr></thead>
            <tbody id="heatRows">
            @foreach (var h in Model.HeatRows)
            {
                var canCycle = !(h.CrossedNote is not null);
                <tr data-heat-row data-doe-profile="@h.Id" data-can-cycle="@(canCycle ? "1" : "0")" data-times="@h.Times" data-in="@h.InText">
                    <td><a href="#" class="tag" data-doe-profile="@h.Id">@h.Tag</a></td>
                    <td class="hide-sm">
                        <span class="chip @h.StatusCssClass">@h.StatusDisplay</span>
                        @if (h.CrossedNote is not null)
                        {
                            <div class="name" style="color:var(--blue)">@h.CrossedNote</div>
                        }
                    </td>
                    <td>@Html.Raw(h.LastSeenHtml)</td>
                    <td class="hide-sm"><span class="breed">@(h.NextExpected ?? "—")</span></td>
                    <td class="num-cell" style="@h.InStyle">@h.InText</td>
                    <td class="num-cell hide-sm"><span class="breed">@h.Times</span></td>
                    <td><button type="button" class="btn btn-ghost btn-sm" data-heat="@h.Id" style="width:100%">♡ Seen today</button></td>
                </tr>
            }
            </tbody></table>
    </div>
</div>

<div class="panel">
    <div class="panel-head"><h2>Add a doe to breeding</h2><span class="sub">scan her tag, pick the stage</span></div>
    <div class="panel-body">
        <div class="add-grid" style="grid-template-columns:1.3fr 1.1fr 1fr 1fr auto">
            <div class="field"><label for="bc-tag">Doe — scan or type tag</label><input autocomplete="off" id="bc-tag" placeholder="scan or type tag"/></div>
            <div class="field"><label for="bc-stage">Stage</label><select id="bc-stage">
                <option value="prep">Getting ready for cross</option>
                <option value="cross">Already crossed</option></select></div>
            <div class="field" id="bc-datefield" style="display:none"><label for="bc-date" id="bc-datelbl">Mating date</label><input id="bc-date" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" max="@DateTime.Today.ToString("yyyy-MM-dd")"></div>
            <div class="field" id="bc-buckfield" style="display:none"><label for="bc-buck">Buck</label><select id="bc-buck"><option value="">—</option>
                @foreach (var bk in Model.BuckOptions)
                {
                    <option value="@bk">@bk</option>
                }
            </select></div>
            <div class="field"><label>&nbsp;</label><button type="button" class="btn btn-green" id="addCross">Add</button></div>
        </div>
        <div class="rule" id="bc-found" style="margin-top:8px"></div>
    </div>
</div>

<div class="panel">
    <div class="panel-head"><h2>Came back empty (not pregnant)</h2>
        <span class="sub" id="emptyRate">@Model.EmptyRateText</span></div>
    <div class="panel-body">
        <div class="note" style="margin:0 0 14px 0">These does were crossed but the scan showed no kids. Keeping
            this list is how you spot a problem — the same doe failing twice, or one buck's does failing often.</div>
        <table class="tbl"><thead><tr><th>Doe</th><th class="hide-sm">Was mated</th><th class="hide-sm">Buck</th>
            <th>Scan date</th><th class="num-cell">Times empty</th><th class="num-cell hide-sm">Now</th></tr></thead>
            <tbody id="emptyRows">
            @foreach (var row in Model.EmptyRows)
            {
                <tr>
                    <td>
                        <a href="#" class="tag" data-doe-profile="@row.Id">@row.Tag</a>
                        @if (!string.IsNullOrEmpty(row.Name))
                        {
                            <div class="name">@row.Name</div>
                        }
                    </td>
                    <td class="hide-sm"><span class="breed">@(row.MatedDate ?? "—")</span></td>
                    <td class="hide-sm"><span class="breed">@(row.BuckTag ?? "—")</span></td>
                    <td><span class="breed">@row.ScanDate</span></td>
                    <td class="num-cell" style="@(row.TimesEmpty > 1 ? "color:#8a261c;font-weight:700" : "")">@row.TimesEmpty@(row.TimesEmpty > 1 ? " ⚠" : "")</td>
                    <td class="num-cell hide-sm"><span class="chip @row.StatusCssClass">@row.StatusDisplay</span></td>
                </tr>
            }
            @if (!Model.EmptyRows.Any())
            {
                <tr><td colspan="6" class="empty">No empty scans recorded. Good sign.</td></tr>
            }
            </tbody></table>
    </div>
</div>
</section>

<section class="breed-view" data-breed-view="kidding" id="breedViewKidding" hidden>
<div class="breed-ph">
    <div class="breed-eyebrow">Births</div>
    <h1 class="breed-ph-title">Kidding &amp; kids</h1>
    <p class="breed muted small">Record a birth from the list, then review mothers and kids on the ground.</p>
</div>

<div class="stats breed-kidding-stats">
    <div class="stat"><div class="num">@Model.KiddingStats.DueTotal</div><div class="l">Pregnant / dry — waiting to kid</div></div>
    <div class="stat"><div class="num">@Model.KiddingStats.DueSoon30</div><div class="l">Due in the next 30 days</div></div>
    <div class="stat"><div class="num">@Model.KiddingStats.KiddedMothers</div><div class="l">Kidded (mothers with kids on milk)</div></div>
    <div class="stat"><div class="num">@Model.KiddingStats.KidsOnGround</div><div class="l">Kids on the ground</div></div>
    <div class="stat"><div class="num" style="@(Model.KiddingStats.MothersToWatch > 0 ? "color:var(--amber)" : "")">@Model.KiddingStats.MothersToWatch</div><div class="l">Mothers to watch</div></div>
</div>

<div class="panel">
    <div class="panel-head breed-kd-head">
        <h2>🍼 Due to kid</h2>
        <span class="sub">tap “Record kidding” on her row</span>
        <div class="breed-kd-chips" id="kdFilter" role="tablist">
            <button type="button" class="breed-kd-chip breed-on" data-kd-filter="all">All (@Model.KiddingStats.DueTotal)</button>
            <button type="button" class="breed-kd-chip" data-kd-filter="soon">Due in 30 days (@Model.KiddingStats.DueSoon30)</button>
            <button type="button" class="breed-kd-chip" data-kd-filter="dry">Dry</button>
        </div>
    </div>
    <div class="panel-body">
        <table class="tbl" id="kdTable"><thead><tr>
            <th>Doe</th><th>Kiddings</th><th class="hide-sm">Mother score</th><th class="hide-sm">Buck</th><th>Stage</th><th>Due</th><th class="num-cell">Kids seen</th><th style="width:140px"></th>
        </tr></thead>
        <tbody>
        @foreach (var e in Model.DueToKidRows)
        {
            <tr data-kd-row data-kd-tag="@e.Tag" data-kd-soon="@(e.DaysToDue <= 30 ? "1" : "0")" data-kd-dry="@(e.IsDry ? "1" : "0")">
                <td>
                    <a href="#" class="tag" data-doe-profile="@e.Id">@e.Tag</a>
                    @if (!string.IsNullOrEmpty(e.Name)) { <div class="name">@e.Name</div> }
                    <div class="name muted small">@e.Breed</div>
                </td>
                <td>
                    <span class="chip chip-kid">@e.KiddingsCount×</span>
                    <div class="name muted small">next is @e.NextKiddingOrdinal</div>
                </td>
                <td class="hide-sm">@(e.MotherScoreHtml != null ? Html.Raw(e.MotherScoreHtml) : Html.Raw("<span class=\"muted\">—</span>"))</td>
                <td class="hide-sm"><span class="breed">@(e.BuckTag ?? "—")</span></td>
                <td><span class="chip @e.FlowStageCssClass">@e.FlowStageLabel</span></td>
                <td>
                    <span class="breed">@e.DueWindow</span>
                    <div class="small" style="@e.DaysToDueStyle">@e.DaysToDueText</div>
                </td>
                <td class="num-cell"><span class="breed">@e.KidsSeenDisplay</span></td>
                <td><button type="button" class="btn btn-green btn-sm" data-birth-open="@e.Tag" data-birth-kids="@(e.KidsCount ?? 2)" data-birth-kiddings="@e.KiddingsCount" data-birth-ordinal="@e.NextKiddingOrdinal" data-birth-past-score="@(e.MotherScoreAverage?.ToString("0.0") ?? "")">🍼 Record kidding</button></td>
            </tr>
        }
        @if (!Model.DueToKidRows.Any())
        {
            <tr id="kdEmpty"><td colspan="8" class="empty">No does due to kid right now.</td></tr>
        }
        </tbody></table>
        <div id="birthPanelSlot" hidden aria-hidden="true"></div>
    </div>
</div>

<div class="panel perm-hidden" id="birthPanel">
    <div class="panel-head"><h2>Record a birth</h2><span class="sub">mother points, dam health, keep decision, and kid details (Sandeel v16)</span></div>
    <div class="panel-body">
        <input type="hidden" id="kb-doe" autocomplete="off">
        <div class="breed-kbirth">
            <div class="breed-kbirth-col">
                <div class="breed-kbirth-h">Birth</div>
                <div class="field"><label for="kb-date">Date</label><input type="date" id="kb-date" value="@DateTime.Today.ToString("yyyy-MM-dd")" max="@DateTime.Today.ToString("yyyy-MM-dd")"></div>
                <div class="add-grid" style="grid-template-columns:1fr 1fr;gap:10px">
                    <div class="field"><label for="kb-live">Born alive</label>
                        <select id="kb-live">
                            @for (var i = 0; i <= BreedingHelper.MaxKidsPerBirth; i++)
                            {
                                if (i == 1)
                                {
                                    <option value="@i" selected>@i</option>
                                }
                                else
                                {
                                    <option value="@i">@i</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="field"><label for="kb-still">Stillborn</label><input type="number" id="kb-still" min="0" max="@BreedingHelper.MaxKidsPerBirth" value="0"></div>
                </div>
                <div class="field"><label>Birth was</label>
                    <div class="breed-seg" id="kb-ease-seg" data-kb-seg="ease">
                        @foreach (var (opt, label) in new[] { ("Easy", "Easy"), ("SlightHelp", "Slight help"), ("HardPull", "Hard pull"), ("Caesarean", "Vet (caesarean)") })
                        {
                            <button type="button" class="breed-seg-btn@(opt == "Easy" ? " breed-on" : "")" data-val="@opt">@label</button>
                        }
                    </div>
                    <input type="hidden" id="kb-ease" value="Easy">
                </div>
                <div class="field"><label for="kb-notes">Note</label><input id="kb-notes" maxlength="1000" placeholder="e.g. second kid came backwards"></div>
            </div>
            <div class="breed-kbirth-col">
                <div class="breed-kbirth-h">Mother after kidding</div>
                <div id="kb-ordinal" class="breed-kordinal muted small" style="margin-bottom:10px"></div>
                <div class="field"><label for="kb-mothering">Mothering (1–5)</label><select id="kb-mothering"></select></div>
                <div class="field"><label for="kb-milk">Milk (1–5)</label><select id="kb-milk"></select></div>
                <div class="field"><label for="kb-bcs">Body condition (1–5)</label><select id="kb-bcs"></select></div>
                <div class="field"><label>Health</label>
                    <div class="breed-seg" id="kb-health-seg" data-kb-seg="health">
                        @foreach (var h in new[] { "Good", "Watch", "Sick" })
                        {
                            <button type="button" class="breed-seg-btn@(h == "Good" ? " breed-on" : "")" data-val="@h">@h</button>
                        }
                    </div>
                </div>
                <div class="field" id="kb-issues-wrap" hidden><label>Problem</label>
                    <div class="breed-ichips" id="kb-issues">
                        @foreach (var iss in MotherScoreHelper.DamIssueOptions)
                        {
                            <button type="button" class="breed-ichip" data-iss="@iss">@iss</button>
                        }
                    </div>
                </div>
                <div class="field"><label>Mother score</label><div id="kb-mscore" class="breed"></div></div>
                <div class="field"><label>Keep her?</label>
                    <div class="breed-seg" id="kb-keep-seg" data-kb-seg="keep">
                        @foreach (var k in new[] { "Keep", "Watch", "Cull" })
                        {
                            <button type="button" class="breed-seg-btn@(k == "Keep" ? " breed-on" : "")" data-val="@k">@k</button>
                        }
                    </div>
                </div>
                <div class="field" id="kb-why-wrap" hidden><label for="kb-why">Why</label>
                    <select id="kb-why">
                        <option value=""></option>
                        @foreach (var r in new[] { "Rejects kids", "Poor mother", "Hard birth", "Low milk", "Health", "Old age", "Other" })
                        {
                            <option value="@r">@r</option>
                        }
                    </select>
                </div>
            </div>
            <div class="breed-kbirth-col breed-kbirth-wide">
                <div class="breed-kbirth-h">Kids <span class="muted small">birth weight required for every live kid</span></div>
                <table class="tbl" style="margin-top:8px"><thead><tr>
                    <th>#</th><th>Gender</th><th>Tag</th><th>Name</th><th class="num-cell">Birth kg</th><th>Colostrum</th><th>Milk</th><th>Health</th>
                </tr></thead><tbody id="kb-kids"></tbody></table>
            </div>
        </div>
        <p class="muted small" id="kb-msg" style="margin-top:8px"></p>
        <div class="goat-form-actions" style="margin-top:12px">
            <button type="button" class="btn btn-green" id="kb-save">Save kidding</button>
            <button type="button" class="btn btn-ghost" id="kb-cancel">Cancel</button>
        </div>
    </div>
</div>

<div class="panel">
    <div class="panel-head"><h2>🩺 Mother check</h2><span class="sub">does that kidded in the last 200 days — change health or decision any time</span></div>
    <div class="panel-body" style="overflow-x:auto">
        <table class="tbl breed-km-tbl" id="kmTable"><thead><tr>
            <th>Mother</th><th>Kiddings</th><th>Kidded</th><th class="num-cell">Kids</th><th>Birth</th>
            <th>Mothering</th><th>Milk</th><th>Body cond.</th><th>Health</th><th>Score</th><th>Decision</th>
        </tr></thead>
        <tbody>
        @{
            var mothPts = new[] { (1, "1 — Poor"), (2, "2 — Weak"), (3, "3 — OK"), (4, "4 — Good"), (5, "5 — Excellent") };
        }
        @foreach (var m in Model.MotherCheckRows)
        {
            <tr class="@m.RowCssClass" data-km-row data-km-id="@m.KiddingRecordId" data-km-ease="@m.EaseKey">
                <td>
                    <a href="#" class="tag" data-doe-profile="@m.DoeId">@m.Tag</a>
                    <div class="name muted small">@m.Breed</div>
                </td>
                <td>
                    <span class="chip chip-kid">@m.KiddingsCount×</span>
                    <div class="name muted small">this was her @m.KiddingOrdinalText</div>
                </td>
                <td>
                    <span class="breed">@m.KiddedDate</span>
                    <div class="name muted small">@m.KiddedAgoText</div>
                </td>
                <td class="num-cell">@m.Alive alive@if (m.Born > m.Alive) { <span class="muted small"> / @m.Born born</span> }</td>
                <td><span class="chip @m.EaseCssClass">@m.EaseDisplay</span></td>
                <td>
                    <select class="breed-pt-sel" data-km-field="mothering" data-km-id="@m.KiddingRecordId">
                        @foreach (var (v, lab) in mothPts)
                        {
                            if ((m.Mothering ?? 3) == v) { <option value="@v" selected>@lab</option> }
                            else { <option value="@v">@lab</option> }
                        }
                    </select>
                </td>
                <td>
                    <select class="breed-pt-sel" data-km-field="milkProduction" data-km-id="@m.KiddingRecordId">
                        @foreach (var (v, lab) in mothPts)
                        {
                            if ((m.MilkProduction ?? 3) == v) { <option value="@v" selected>@lab</option> }
                            else { <option value="@v">@lab</option> }
                        }
                    </select>
                </td>
                <td>
                    <select class="breed-pt-sel" data-km-field="bodyCondition" data-km-id="@m.KiddingRecordId">
                        @foreach (var (v, lab) in mothPts)
                        {
                            if ((m.BodyCondition ?? 3) == v) { <option value="@v" selected>@lab</option> }
                            else { <option value="@v">@lab</option> }
                        }
                    </select>
                </td>
                <td>
                    <div class="breed-seg" data-km-field="damHealth" data-km-id="@m.KiddingRecordId">
                        @foreach (var h in new[] { "Good", "Watch", "Sick" })
                        {
                            <button type="button" class="breed-seg-btn@(m.DamHealth == h ? " breed-on" : "")" data-val="@h">@h</button>
                        }
                    </div>
                    @if (m.DamHealthIssues.Count > 0)
                    {
                        <div class="name" style="color:var(--red);margin-top:4px">@string.Join(", ", m.DamHealthIssues)</div>
                    }
                </td>
                <td class="breed-km-score">@Html.Raw(m.MotherScoreHtml)</td>
                <td>
                    <div class="breed-seg" data-km-field="keepDecision" data-km-id="@m.KiddingRecordId">
                        @foreach (var k in new[] { "Keep", "Watch", "Cull" })
                        {
                            <button type="button" class="breed-seg-btn@(m.KeepDecision == k ? " breed-on" : "")" data-val="@k">@k</button>
                        }
                    </div>
                    @if (!string.IsNullOrEmpty(m.KeepReason))
                    {
                        <div class="name muted small" style="margin-top:4px">@m.KeepReason</div>
                    }
                </td>
            </tr>
        }
        @if (!Model.MotherCheckRows.Any())
        {
            <tr><td colspan="11" class="empty">No kiddings in the last 200 days.</td></tr>
        }
        </tbody></table>
    </div>
</div>

<div class="panel">
    <div class="panel-head breed-kd-head">
        <h2>👪 Mother groups</h2>
        <span class="sub">group mothers by litter size, then pick a group at buck assignment</span>
        <button type="button" class="btn btn-ghost btn-sm" id="mgAuto" style="margin-left:8px">⚡ Group by kids born</button>
    </div>
    <div class="panel-body">
        @{
            var mgAll = Model.MotherGroupRows.Count;
            var mgNone = Model.MotherGroupRows.Count(r => string.IsNullOrEmpty(r.MotherGroupId));
        }
        <div class="breed-kd-chips" id="mgFilter" role="tablist">
            <button type="button" class="breed-kd-chip breed-on" data-mg-filter="all">All mothers (@mgAll)</button>
            @foreach (var g in Model.MotherGroups.OrderBy(x => x.Order))
            {
                var c = Model.MotherGroupRows.Count(r => r.MotherGroupId == g.Id);
                <button type="button" class="breed-kd-chip" data-mg-filter="@g.Id" style="--mgc:@g.Color">@g.Name (@c)</button>
            }
            <button type="button" class="breed-kd-chip" data-mg-filter="none">No group (@mgNone)</button>
            <button type="button" class="breed-kd-chip" id="mgPlus">＋ New group</button>
        </div>
        <div class="breed-mgbar" id="mgBar">
            <b id="mgCount">0 selected</b>
            <span class="muted small">→ move to</span>
            <select id="mgMoveTo" class="breed-pt-sel">
                @foreach (var g in Model.MotherGroups.OrderBy(x => x.Order))
                {
                    <option value="@g.Id">@g.Name</option>
                }
                <option value="">— remove from group</option>
            </select>
            <button type="button" class="btn btn-green btn-sm" id="mgMove" disabled>Move</button>
            <button type="button" class="btn btn-ghost btn-sm" id="mgClearSel">Clear</button>
        </div>
        <div id="mgNewWrap" class="breed-mgnew" hidden>
            <input id="mgName" class="t" maxlength="80" placeholder="Group name" style="width:180px">
            <button type="button" class="btn btn-green btn-sm" id="mgAdd">Add</button>
        </div>
        <table class="tbl" id="mgTable" style="margin-top:12px"><thead><tr>
            <th style="width:40px"><input type="checkbox" id="mgHead" aria-label="Select all mothers"></th>
            <th>Mother</th><th>Kiddings</th><th>Last litter</th><th>Score</th><th>Group</th>
        </tr></thead>
        <tbody>
        @foreach (var r in Model.MotherGroupRows)
        {
            <tr data-mg-row data-mg-id="@r.DoeId" data-mg-group="@(r.MotherGroupId ?? "")">
                <td><input type="checkbox" class="breed-mg-sel" data-mg-sel="@r.DoeId" aria-label="Select @r.Tag"></td>
                <td>
                    <a href="#" class="tag" data-doe-profile="@r.DoeId">@r.Tag</a>
                    <div class="name muted small">@r.Breed</div>
                </td>
                <td><span class="chip chip-kid">@r.KiddingsCount×</span></td>
                <td>@r.LastLitterText</td>
                <td>@Html.Raw(r.MotherScoreHtml)</td>
                <td>
                    <select class="breed-mg-selone" data-mg-doe="@r.DoeId" style="@(r.MotherGroupId != null && Model.MotherGroups.FirstOrDefault(g => g.Id == r.MotherGroupId) is { } mg ? $"border-color:{mg.Color}" : "")">
                        <option value="">— no group</option>
                        @foreach (var g in Model.MotherGroups.OrderBy(x => x.Order))
                        {
                            if (r.MotherGroupId == g.Id) { <option value="@g.Id" selected>@g.Name</option> }
                            else { <option value="@g.Id">@g.Name</option> }
                        }
                    </select>
                    @if (r.SuggestedGroupId != null && Model.MotherGroups.FirstOrDefault(g => g.Id == r.SuggestedGroupId) is { } sug)
                    {
                        <div class="name small" style="color:var(--amber);margin-top:3px">suggested: @sug.Name</div>
                    }
                </td>
            </tr>
        }
        @if (!Model.MotherGroupRows.Any())
        {
            <tr><td colspan="6" class="empty">No mothers yet — record a kidding first.</td></tr>
        }
        </tbody></table>
    </div>
</div>

<div class="panel">
    <div class="panel-head breed-kd-head">
        <h2>🐐 Kids</h2>
        <span class="sub">every kid is a normal herd animal from birth</span>
        <div class="breed-kd-chips" id="kkFilter" role="tablist">
            @{
                var onMilk = Model.KidGroundRows.Count(k => k.OnMilk);
                var weaned = Model.KidGroundRows.Count(k => !k.OnMilk);
                var week = Model.KidGroundRows.Count(k => k.WeaningSoon);
                var weak = Model.KidGroundRows.Count(k => k.IsWeak);
                var milkTypes = new[] { "Mother", "Powder", "Mixed", "Foster" };
                var healthTags = new[] { "Good", "Weak", "Sick" };
            }
            <button type="button" class="breed-kd-chip breed-on" data-kk-filter="all">All (@Model.KidGroundRows.Count)</button>
            <button type="button" class="breed-kd-chip" data-kk-filter="milk">🍼 On milk (@onMilk)</button>
            <button type="button" class="breed-kd-chip" data-kk-filter="week">Weaning this week (@week)</button>
            <button type="button" class="breed-kd-chip" data-kk-filter="weaned">Weaned (@weaned)</button>
            <button type="button" class="breed-kd-chip" data-kk-filter="weak">Weak (@weak)</button>
        </div>
        <button type="button" class="btn btn-ghost btn-sm" id="kkWeanEarly" disabled style="margin-left:8px">Wean early</button>
    </div>
  <div class="panel-body">
        <div class="breed-wsetbar">
            <span class="breed-wlab">🔁 Auto-wean</span>
            @if (Model.KidAutoWeanBars.Any())
            {
                @foreach (var bar in Model.KidAutoWeanBars)
                {
                    <span class="breed-wset@(bar.AutoWean ? "" : " breed-wset-off")">
                        <b>@bar.Icon @bar.Name</b> kids move to <b>Weaned</b> at
                        <input type="number" class="breed-wd-input" data-kk-wd min="1" max="365" value="@bar.WeanDays" aria-label="Wean days for @bar.Name">
                        days
                        <label class="breed-sw">
                            <input type="checkbox" data-kk-wa @(bar.AutoWean ? "checked" : "")>
                            <span>auto</span>
                        </label>
                    </span>
                }
            }
            else
            {
                <span class="breed-wset@(Model.SeasonAutoWean ? "" : " breed-wset-off")">
                    <b>Season default</b> · wean at
                    <input type="number" class="breed-wd-input" data-kk-wd min="1" max="365" value="@Model.SeasonWeanDays">
                    days
                    <label class="breed-sw">
                        <input type="checkbox" data-kk-wa @(Model.SeasonAutoWean ? "checked" : "")>
                        <span>auto</span>
                    </label>
                </span>
            }
            <span class="muted small">same number as Season plan › “Wean the kids”</span>
        </div>
        <table class="tbl breed-kk-tbl" id="kkTable"><thead><tr>
            <th style="width:40px"></th><th>Kid</th><th>Mother</th><th>Sex</th><th class="num-cell">Age</th>
            <th>Milk</th><th>Health</th><th class="num-cell">Birth kg</th><th class="num-cell">Wean kg</th><th class="num-cell hide-sm">90-day kg</th><th>Status</th>
        </tr></thead>
        <tbody>
        @foreach (var k in Model.KidGroundRows)
        {
            <tr data-kk-row data-kk-id="@k.Id" data-kk-milk="@(k.OnMilk ? "1" : "0")" data-kk-week="@(k.WeaningSoon ? "1" : "0")" data-kk-weaned="@(k.OnMilk ? "0" : "1")" data-kk-weak="@(k.IsWeak ? "1" : "0")" class="@(k.OnMilk ? "" : "breed-kk-weaned")">
                <td>
                    @if (k.OnMilk)
                    {
                        <input type="checkbox" class="breed-kk-sel" data-kk-sel="@k.Id" aria-label="Select @k.Tag">
                    }
                </td>
                <td>
                    <a href="#" class="tag" data-goatcard="@k.Id">@k.Tag</a>
                    @if (k.IsTemporaryTag) { <div class="name muted small">temp tag</div> }
                </td>
                <td><span class="breed">@(k.DamTag ?? "—")</span></td>
                <td>@k.SexDisplay</td>
                <td class="num-cell">@k.AgeDays d</td>
                <td>
                    @if (k.OnMilk)
                    {
                        <div class="breed-seg" data-kk-field="milk" data-kk-id="@k.Id">
                            @foreach (var opt in milkTypes)
                            {
                                <button type="button" class="breed-seg-btn@(k.MilkType == opt ? " breed-on" : "")" data-val="@opt">@opt</button>
                            }
                        </div>
                    }
                    else
                    {
                        <span class="muted small">was @k.MilkType.ToLowerInvariant()</span>
                    }
                </td>
                <td>
                    <div class="breed-seg" data-kk-field="health" data-kk-id="@k.Id">
                        @foreach (var opt in healthTags)
                        {
                            <button type="button" class="breed-seg-btn@(k.HealthTag == opt ? " breed-on" : "")" data-val="@opt">@opt</button>
                        }
                    </div>
                </td>
                <td class="num-cell">@(k.BirthKg?.ToString("0.1") ?? "—")</td>
                <td class="num-cell">
                    @if (k.OnMilk)
                    {
                        <span class="muted">—</span>
                    }
                    else
                    {
                        <input type="number" class="breed-weankg @(k.NeedsWeanWeight ? "breed-need" : "")" data-kk-weankg="@k.Id" min="0" max="80" step="0.1" placeholder="kg" value="@(k.WeanKg?.ToString("0.0") ?? "")">
                    }
                </td>
                <td class="num-cell hide-sm">@(k.Kg90Text ?? "—")</td>
                <td>
                    <span class="chip @k.StatusCssClass">@(k.OnMilk ? "🍼 On milk" : "✓ Weaned")</span>
                    <div class="small" style="@k.StatusSubStyle">@k.StatusSubText</div>
                    @if (k.NeedsWeanWeight)
                    {
                        <div class="small" style="color:var(--amber);font-weight:600">add wean weight</div>
                    }
                </td>
            </tr>
        }
        @if (!Model.KidGroundRows.Any())
        {
            <tr><td colspan="11" class="empty">No kids on the ground yet.</td></tr>
        }
        </tbody></table>
    </div>
</div>

<div class="panel">
    <div class="panel-head"><h2>📋 In the main herd</h2>
        <a href="/Goat" class="btn btn-ghost btn-sm" style="margin-left:auto">Open herd</a></div>
    <div class="panel-body">
        <p class="breed muted small" style="margin:0">After you save a birth here, does and kids update on the Herd screen — breeding status, due dates, mother links, birth weights, and weaning. Mother scores and groups are maintained in <b>Mother check</b> and <b>Mother groups</b> above.</p>
    </div>
</div>

<div class="panel">
    <div class="panel-head"><h2>What to feed these does</h2><span class="sub">daily ration by breeding stage</span></div>
    <div class="panel-body">
        <div class="note" style="margin:0 0 14px 0">Ration comes from your Feed tab settings. Does carrying
            <b>twins or more</b> are flagged — they need extra in the last 6 weeks.</div>
        <table class="tbl"><thead><tr><th>Doe</th><th>Stage</th>
            <th class="num-cell">Mix kg/day</th><th class="num-cell hide-sm">Fodder kg/day</th>
            <th class="num-cell hide-sm">Cost/day</th><th>Note</th></tr></thead>
            <tbody id="rationRows">
            @foreach (var row in Model.RationRows)
            {
                <tr>
                    <td>
                        <a href="#" class="tag" data-goatcard="@row.Id">@row.Tag</a>
                        @if (!string.IsNullOrEmpty(row.Name))
                        {
                            <div class="name">@row.Name</div>
                        }
                    </td>
                    <td><span class="breed">@row.Stage</span></td>
                    <td class="num-cell" style="font-weight:700">@row.MixKgPerDay.ToString("F2")</td>
                    <td class="num-cell hide-sm">@row.FodderKgPerDay.ToString("F1")</td>
                    <td class="num-cell hide-sm">@DisplayHelper.FormatRs(row.DailyCost)</td>
                    <td>
                        @if (!string.IsNullOrEmpty(row.Note))
                        {
                            <span class="breed">@row.Note</span>
                        }
                    </td>
                </tr>
            }
            @if (!Model.RationRows.Any())
            {
                <tr><td colspan="6" class="empty">No does in a breeding stage right now.</td></tr>
            }
            </tbody></table>
    </div>
</div>
</section>

<section class="breed-view" data-breed-view="reports" id="breedViewReports" hidden>
    <partial name="_ReportsSection" for="Reports" />
</section>

@section Scripts {
<script src="~/js/breeding-page.js" asp-append-version="true"></script>
<script>GoatRecords.initBreeding();</script>
}
