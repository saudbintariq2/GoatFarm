@model GoatFarm.Application.ViewModels.Breeding.BreedingPageViewModel
@using GoatFarm.Application.Common

<div class="bignum">
    <div><div class="lbl">Confirmed pregnant</div><div class="big" id="breedExp">@Model.ExpectingCount</div>
        <div class="lbl" id="breedNext">@Model.NextDueText</div></div>
    <div class="side"><span class="lbl">Ready for cross</span><b id="breedPrep">@Model.PrepCount</b>
        <span class="lbl" id="breedWait">@Model.BreedWaitText</span></div>
</div>

<div class="panel" id="bgPanel">
    <div class="panel-head"><h2>Breeding groups (buck groups)</h2><span class="sub">put one buck with a set of does · every doe keeps her own record</span></div>
    <div class="panel-body">
        <div class="add-grid" id="bgForm" style="grid-template-columns:repeat(auto-fit,minmax(160px,1fr))">
            <div class="field"><label for="bg-buck">Buck</label><select id="bg-buck">
                @foreach (var b in Model.BuckOptions) { <option value="@b">@b</option> }
                @if (!Model.BuckOptions.Any()) { <option value="">No adult buck in herd</option> }
            </select></div>
            <div class="field"><label for="bg-date">Date buck put in</label><input id="bg-date" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")"></div>
            <div class="field"><label for="bg-max">Does per buck (max)</label><input id="bg-max" type="number" min="1" value="15"></div>
            <div class="field"><label for="bg-n">Select first</label><div style="display:flex;gap:6px"><input id="bg-n" type="number" min="1" placeholder="e.g. 15" style="min-width:0"/><button type="button" class="btn btn-ghost btn-sm" id="bg-pick">Pick</button></div></div>
        </div>
        <div class="sub" id="bg-count" style="margin:10px 0 6px;font-weight:700"></div>
        <div class="v206-bg-list" id="bg-does">
        @if (Model.GroupCandidates.Any())
        {
            foreach (var g in Model.GroupCandidates)
            {
                <label><input type="checkbox" data-bgdoe="@g.Id"> <b>@g.Tag</b> <span class="breed">@g.Breed</span>
                @if (g.Ready) {<span class="chip chip-kid">ready</span>}</label>
            }
        }
        else
        {
            <div class="empty">No eligible does free. Does must be female, not kids, old enough, and not already crossed.</div>
        }
        </div>
        <div style="margin-top:12px;display:flex;gap:8px;flex-wrap:wrap"><button type="button" class="btn btn-green" id="bg-create">Create group &amp; record cross</button></div>
        <div class="v206-bg-groups" id="bg-groups" style="margin-top:16px"></div>
    </div>
</div>

<div class="panel">
    <div class="panel-head"><h2>What needs doing</h2><span class="sub" id="nowSub">@(Model.NowJobs.Count > 0 ? Model.NowJobs.Count + " thing(s) today" : "nothing today")</span></div>
    <div class="panel-body"><div id="nowList">
        @if (Model.NowJobs.Any())
        {
            foreach (var j in Model.NowJobs)
            {
                <div class="breeding-now-row" style="display:flex;gap:10px;align-items:flex-start;padding:10px 0;border-bottom:1px solid var(--line)">
                    <span style="font-size:17px">@j.Icon</span>
                    <div style="flex:1;min-width:0"><div style="font-weight:700;color:@j.Tone">@j.Text</div>
                        <div class="breed">@string.Join(" · ", j.Tags.Take(10))@(j.Tags.Count > 10 ? " …" : "")</div></div>
                    @if (!string.IsNullOrEmpty(j.FilterLink))
                    {<a class="btn btn-ghost btn-sm" href="/Goat?filter=@Uri.EscapeDataString(j.FilterLink!)">Show them</a>}
                </div>
            }
        }
        else
        {
            <div class="alldone">✓ Nothing to do in breeding today. The next job is in the season plan below.</div>
        }
    </div></div>
</div>

<div class="panel">
    <div class="panel-head"><h2>Season plan</h2><span class="sub" id="seasonSub">@Model.Season.SeasonSub</span></div>
    <div class="panel-body">
        <div class="note" style="margin:0 0 14px 0">A doe gives birth <b>once a year</b>, so a group crossed in
            April gives birth in September and is crossed again the following April. Run two groups six months apart
            and the farm has births twice a year. <b>The birth window is the one date you choose</b> — the green row;
            everything else is counted from it.</div>
        <div class="filterbar" style="margin-bottom:14px">
            <div class="field"><label class="hide-sm">Group</label><select id="se-batch">
                @foreach (var b in Model.Season.Batches)
                {<option value="@b.Id" @(b.Id == Model.Season.SelectedBatchId ? "selected" : null)>@b.Name</option>}
            </select></div>
            <button type="button" class="btn btn-ghost btn-sm" id="se-rename">✎ Rename</button>
            <button type="button" class="btn btn-ghost btn-sm" id="se-add">+ Add a group</button>
            <button type="button" class="btn btn-ghost btn-sm" id="se-del">× Remove</button>
            <span class="count-pill" id="se-count">@Model.Season.BatchCountText</span>
        </div>
        <table class="tbl"><thead><tr><th>Step</th><th>Rule — change any number</th>
            <th class="hide-sm">Date it happens</th><th class="num-cell">Days from today<div id="se-todayNote" style="font-weight:400;text-transform:none;font-size:10px"></div></th></tr></thead>
            <tbody id="seasonRows">
            @foreach (var step in Model.Season.Steps)
            {
                var rowStyle = step.Anchor ? "background:var(--green-tint)" : "";
                <tr style="@rowStyle">
                    <td><b>@step.Icon @step.Label</b></td>
                    <td><span style="font-size:13.5px">@Html.Raw(SeasonRuleHtml(step, Model.Season))</span></td>
                    <td class="hide-sm"><span class="breed">@step.WindowText</span></td>
                    <td class="num-cell" style="@step.DaysStyle">@step.DaysText</td>
                </tr>
            }
            </tbody></table>
    </div>
</div>

@functions {
    string SeasonRuleHtml(GoatFarm.Application.ViewModels.Breeding.BreedingSeasonStepViewModel step, GoatFarm.Application.ViewModels.Breeding.BreedingSeasonPanelViewModel season)
    {
        if (step.Label == "Start extra feed")
            return $"<input type=\"number\" id=\"se-build\" min=\"0\" value=\"{season.BuildUp}\" style=\"width:62px;padding:5px 7px;border:1px solid var(--line);border-radius:7px;text-align:right;font-family:inherit;font-size:14px\"> days <b>before crossing</b>";
        if (step.Label == "Stop milking")
            return $"<input type=\"number\" id=\"se-drycross\" min=\"0\" value=\"{season.DryBeforeCross}\" style=\"width:62px;padding:5px 7px;border:1px solid var(--line);border-radius:7px;text-align:right;font-family:inherit;font-size:14px\"> days <b>before crossing</b>";
        if (step.Label == "Cross the does")
            return $"<span class=\"breed\">{BreedingHelper.GestationDays} days <b>before birth</b> — a goat's pregnancy</span>";
        if (step.Label == "Ultrasound scan")
            return $"<input type=\"number\" id=\"se-scan\" min=\"0\" value=\"{season.ScanAfter}\" style=\"width:62px;padding:5px 7px;border:1px solid var(--line);border-radius:7px;text-align:right;font-family:inherit;font-size:14px\"> days <b>after crossing</b>";
        if (step.Label == "Dry off the milkers")
            return $"<input type=\"number\" id=\"se-dry\" min=\"0\" value=\"{season.DryOff}\" style=\"width:62px;padding:5px 7px;border:1px solid var(--line);border-radius:7px;text-align:right;font-family:inherit;font-size:14px\"> days <b>before birth</b>";
        if (step.Label == "Birth window")
        {
            var b = season.Batches.FirstOrDefault(x => x.Id == season.SelectedBatchId) ?? season.Batches.First();
            var kidY = DateTime.Today.Year;
            var from = $"{kidY}-{b.From}";
            var to = $"{kidY}-{b.To}";
            return $"<b>you choose this</b> — <input type=\"date\" id=\"se-from\" value=\"{from}\" style=\"padding:5px 7px;border:1px solid var(--line);border-radius:7px;font-family:inherit;font-size:14px\"> to <input type=\"date\" id=\"se-to\" value=\"{to}\" style=\"padding:5px 7px;border:1px solid var(--line);border-radius:7px;font-family:inherit;font-size:14px\">";
        }
        if (step.Label == "Wean the kids")
            return $"<input type=\"number\" id=\"se-wean\" min=\"0\" value=\"{season.WeanDays}\" style=\"width:62px;padding:5px 7px;border:1px solid var(--line);border-radius:7px;text-align:right;font-family:inherit;font-size:14px\"> days <b>after birth</b>, or once they reach <input type=\"number\" id=\"se-weankg\" min=\"0\" step=\"0.1\" value=\"{season.WeanKg}\" style=\"width:58px;padding:5px 7px;border:1px solid var(--line);border-radius:7px;text-align:right;font-family:inherit;font-size:14px\"> kg";
        return step.RuleHtml;
    }
}

<div class="panel">
    <div class="panel-head"><h2>The farm's year</h2><span class="sub">both groups side by side</span></div>
    <div class="panel-body"><table class="tbl"><thead><tr><th>Group</th><th class="num-cell">Does</th>
        <th>Cross</th><th class="hide-sm">Scan</th><th class="hide-sm">Dry off</th>
        <th>Births</th><th class="num-cell">Next job</th></tr></thead>
        <tbody id="yearRows">
        @foreach (var y in Model.YearRows)
        {
            <tr @(y.Highlight ? Html.Raw("style=\"background:var(--green-tint)\"") : null)>
                <td><b>@y.Name</b></td>
                <td class="num-cell">@y.DoeCount</td>
                <td>@Html.Raw(y.CrossText)</td>
                <td class="hide-sm"><span class="breed">@y.ScanText</span></td>
                <td class="hide-sm"><span class="breed">@y.DryText</span></td>
                <td>@Html.Raw(y.BirthText)</td>
                <td class="num-cell" style="@y.NextJobStyle">@y.NextJobText</td>
            </tr>
        }
        </tbody></table></div>
</div>

<div class="panel">
    <div class="panel-head"><h2>Does against the plan</h2><span class="sub">who is on track for the window</span></div>
    <div class="panel-body"><table class="tbl"><thead><tr><th>Doe</th><th class="hide-sm">Status</th>
        <th class="hide-sm">Batch</th><th class="hide-sm">BCS</th><th>Where she stands</th></tr></thead>
        <tbody id="planRows">
        @foreach (var p in Model.PlanRows)
        {
            <tr>
                <td><a href="#" class="tag" data-goatcard="@p.Id">@p.Tag</a></td>
                <td class="hide-sm"><span class="chip @p.StatusCssClass">@p.StatusDisplay</span></td>
                <td class="hide-sm">@Html.Raw(p.BatchHtml)</td>
                <td class="hide-sm">@Html.Raw(p.BcsHtml)</td>
                <td style="color:@p.StandColor;font-weight:600">@p.StandText</td>
            </tr>
        }
        @if (!Model.PlanRows.Any()) {<tr><td colspan="5" class="empty">No does yet.</td></tr>}
        </tbody></table></div>
</div>

<div class="panel">
    <div class="panel-head"><h2>Breeding</h2>
        <div class="filterbar">
            <div class="field"><label class="hide-sm">Show</label>
                <select id="brFilter">
                    <option value="all">All in breeding</option>
                    <option value="plan">0 · Next cross planned</option>
                    <option value="prep">1 · Ready for cross</option>
                    <option value="wait">2 · Waiting for scan</option>
                    <option value="preg">3 · Confirmed pregnant</option>
                    <option value="due30">Due within 30 days</option>
                    <option value="scan">Scan due now</option>
                </select></div>
            <span class="count-pill" id="brCount">@Model.PipelineRows.Count doe(s)</span>
        </div>
    </div>
    <div class="panel-body">
        <table class="tbl"><thead><tr>
            <th>Doe</th><th>Stage</th><th class="hide-sm">Mated</th><th class="hide-sm">Buck</th>
            <th>Kids</th><th>Key date</th><th class="num-cell">Days</th>
            <th style="width:150px">Change stage</th></tr></thead>
            <tbody id="brRows">
            @foreach (var r in Model.PipelineRows)
            {
                <tr data-br-stage="@r.StageKey" data-br-id="@r.Id" data-br-mated="@r.MatedDate" data-br-kids="@(r.KidsCount?.ToString() ?? "")">
                    <td><a href="#" class="tag" data-goatcard="@r.Id">@r.Tag</a>
                        @if (!string.IsNullOrEmpty(r.Name)) {<div class="name">@r.Name</div>}
                        @if (!string.IsNullOrEmpty(r.Owner)) {<div class="name" style="color:var(--blue)">@r.Owner</div>}</td>
                    <td><span class="chip @r.StageCssClass">@r.StageLabel</span></td>
                    <td class="hide-sm"><span class="breed">@(r.MatedDate ?? "—")</span></td>
                    <td class="hide-sm"><span class="breed">@(r.BuckTag ?? "—")</span></td>
                    <td>@Html.Raw(r.KidsHtml)</td>
                    <td>@Html.Raw(r.KeyDateHtml)</td>
                    <td class="num-cell" style="@r.DaysStyle">@r.DaysText</td>
                    <td><select data-bract="@r.Id" data-br-stage="@r.StageKey" style="font-family:inherit;font-size:13px;padding:5px 7px;border:1px solid var(--line);border-radius:7px;width:100%"></select></td>
                </tr>
            }
            @if (!Model.PipelineRows.Any()) {<tr id="brEmpty"><td colspan="8" class="empty">No does in breeding. Add one below.</td></tr>}
            </tbody></table>
        <div class="rule" style="margin-top:12px"><b>Change stage</b> on any row to move her forward — each step asks
            for the date it happened. A <b>not pregnant</b> scan returns her to Dry and counts against your conception rate.</div>
    </div>
</div>

<div class="panel">
    <div class="panel-head"><h2>Heat &amp; cycles</h2><span class="sub">a doe returns to heat about every 21 days</span></div>
    <div class="panel-body">
        <div class="note" style="margin:0 0 14px 0">Tap <b>♡ Seen today</b> the moment you notice a doe in heat —
            that is the whole job. The app then expects her again in 21 days, which is when to put her to the buck.
            A crossed doe seen in heat did not take: tapping it here catches that three weeks before a scan would.</div>
        <div class="filterbar" style="margin-bottom:12px">
            <div class="field"><label class="hide-sm">Show</label>
                <select id="heatFilter">
                    <option value="active">Does that can cycle</option>
                    <option value="due">Expected in heat now</option>
                    <option value="seen">Only ones I have recorded</option>
                    <option value="all">Every doe</option>
                </select></div>
            <span class="count-pill" id="heatCount">@Model.HeatRows.Count doe(s)</span>
        </div>
        <table class="tbl"><thead><tr><th>Doe</th><th class="hide-sm">Status</th><th>Last seen</th>
            <th class="hide-sm">Next expected</th><th class="num-cell">In</th>
            <th class="num-cell hide-sm">Times</th><th style="width:120px"></th></tr></thead>
            <tbody id="heatRows">
            @foreach (var h in Model.HeatRows)
            {
                var canCycle = !(h.CrossedNote is not null);
                <tr data-heat-row data-can-cycle="@(canCycle ? "1" : "0")" data-times="@h.Times" data-in="@h.InText">
                    <td><a href="#" class="tag" data-goatcard="@h.Id">@h.Tag</a></td>
                    <td class="hide-sm"><span class="chip @h.StatusCssClass">@h.StatusDisplay</span>
                        @if (h.CrossedNote is not null) {<div class="name" style="color:var(--blue)">@h.CrossedNote</div>}</td>
                    <td>@Html.Raw(h.LastSeenHtml)</td>
                    <td class="hide-sm"><span class="breed">@(h.NextExpected ?? "—")</span></td>
                    <td class="num-cell" style="@h.InStyle">@h.InText</td>
                    <td class="num-cell hide-sm"><span class="breed">@h.Times</span></td>
                    <td><button type="button" class="btn btn-ghost btn-sm" data-heat="@h.Id" style="width:100%">♡ Seen today</button></td>
                </tr>
            }
            </tbody></table>
    </div>
</div>

<div class="panel">
    <div class="panel-head"><h2>Buck workload</h2><span class="sub">do not overwork one buck</span></div>
    <div class="panel-body">
        <table class="tbl"><thead><tr><th>Buck</th><th class="num-cell">Does carrying now</th>
            <th class="num-cell hide-sm">Crosses this year</th><th class="num-cell">Conception</th>
            <th class="hide-sm">Last used</th><th>Load</th></tr></thead>
            <tbody id="buckRows">
            @foreach (var b in Model.BuckRows)
            {
                <tr>
                    <td><a href="#" class="tag" data-goatcard="@b.Id">@b.Tag</a></td>
                    <td class="num-cell" style="font-weight:700">@b.Carrying</td>
                    <td class="num-cell hide-sm">@b.CrossesThisYear</td>
                    <td class="num-cell" style="@b.ConceptionStyle">@b.ConceptionText</td>
                    <td class="hide-sm"><span class="breed">@(b.LastUsed ?? "—")</span></td>
                    <td><span style="color:@b.LoadColor;font-weight:700">@b.LoadText</span></td>
                </tr>
            }
            @if (!Model.BuckRows.Any()) {<tr><td colspan="6" class="empty">No bucks in the herd.</td></tr>}
            </tbody></table>
    </div>
</div>

<div class="panel">
    <div class="panel-head"><h2>Add a doe to breeding</h2><span class="sub">scan her tag, pick the stage</span></div>
    <div class="panel-body">
        <div class="add-grid" style="grid-template-columns:1.3fr 1.1fr 1fr 1fr auto">
            <div class="field"><label for="bc-tag">Doe — scan or type tag</label><input autocomplete="off" id="bc-tag" placeholder="scan or type tag"/></div>
            <div class="field"><label for="bc-stage">Stage</label><select id="bc-stage">
                <option value="prep">Getting ready for cross</option>
                <option value="cross">Already crossed</option></select></div>
            <div class="field" id="bc-datefield" style="display:none"><label id="bc-datelbl">Mating date</label><input id="bc-date" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" max="@DateTime.Today.ToString("yyyy-MM-dd")"></div>
            <div class="field" id="bc-buckfield" style="display:none"><label for="bc-buck">Buck</label><select id="bc-buck"><option value="">—</option>
                @foreach (var bk in Model.BuckOptions) { <option value="@bk">@bk</option> }</select></div>
            <div class="field"><label>&nbsp;</label><button type="button" class="btn btn-green" id="addCross">Add</button></div>
        </div>
        <div class="rule" id="bc-found" style="margin-top:8px"></div>
    </div>
</div>

<div class="panel">
    <div class="panel-head"><h2>Came back empty (not pregnant)</h2>
        <span class="sub" id="emptyRate">@Model.EmptyRateText</span></div>
    <div class="panel-body">
        <div class="note" style="margin:0 0 14px 0">These does were crossed but the scan showed no kids. Keeping
            this list is how you spot a problem — the same doe failing twice, or one buck's does failing often.</div>
        <table class="tbl"><thead><tr><th>Doe</th><th class="hide-sm">Was mated</th><th class="hide-sm">Buck</th>
            <th>Scan date</th><th class="num-cell">Times empty</th><th class="num-cell hide-sm">Now</th></tr></thead>
            <tbody id="emptyRows">
            @foreach (var row in Model.EmptyRows)
            {
                <tr>
                    <td><a href="#" class="tag" data-goatcard="@row.Id">@row.Tag</a>@if (!string.IsNullOrEmpty(row.Name)) {<div class="name">@row.Name</div>}</td>
                    <td class="hide-sm"><span class="breed">@(row.MatedDate ?? "—")</span></td>
                    <td class="hide-sm"><span class="breed">@(row.BuckTag ?? "—")</span></td>
                    <td><span class="breed">@row.ScanDate</span></td>
                    <td class="num-cell" style="@(row.TimesEmpty > 1 ? "color:#8a261c;font-weight:700" : "")">@row.TimesEmpty@(row.TimesEmpty > 1 ? " ⚠" : "")</td>
                    <td class="num-cell hide-sm"><span class="chip @row.StatusCssClass">@row.StatusDisplay</span></td>
                </tr>
            }
            @if (!Model.EmptyRows.Any()) {<tr><td colspan="6" class="empty">No empty scans recorded. Good sign.</td></tr>}
            </tbody></table>
    </div>
</div>

<div class="panel">
    <div class="panel-head"><h2>What to feed these does</h2><span class="sub">daily ration by breeding stage</span></div>
    <div class="panel-body">
        <div class="note" style="margin:0 0 14px 0">Ration comes from your Feed tab settings. Does carrying
            <b>twins or more</b> are flagged — they need extra in the last 6 weeks.</div>
        <table class="tbl"><thead><tr><th>Doe</th><th>Stage</th>
            <th class="num-cell">Mix kg/day</th><th class="num-cell hide-sm">Fodder kg/day</th>
            <th class="num-cell hide-sm">Cost/day</th><th>Note</th></tr></thead>
            <tbody id="rationRows">
            @foreach (var row in Model.RationRows)
            {
                <tr>
                    <td><a href="#" class="tag" data-goatcard="@row.Id">@row.Tag</a>@if (!string.IsNullOrEmpty(row.Name)) {<div class="name">@row.Name</div>}</td>
                    <td><span class="breed">@row.Stage</span></td>
                    <td class="num-cell" style="font-weight:700">@row.MixKgPerDay.ToString("F2")</td>
                    <td class="num-cell hide-sm">@row.FodderKgPerDay.ToString("F1")</td>
                    <td class="num-cell hide-sm">@DisplayHelper.FormatRs(row.DailyCost)</td>
                    <td>@if (!string.IsNullOrEmpty(row.Note)) {<span class="breed">@row.Note</span>}</td>
                </tr>
            }
            @if (!Model.RationRows.Any()) {<tr><td colspan="6" class="empty">No does in a breeding stage right now.</td></tr>}
            </tbody></table>
    </div>
</div>

<div class="panel perm-hidden" id="birthPanel">
    <div class="panel-head"><h2>Record a birth</h2><span class="sub">kids are added to the herd with their dam and sire</span></div>
    <div class="panel-body">
        <div class="add-grid" style="grid-template-columns:1.3fr 1fr 1fr 1fr 1fr">
            <div class="field"><label for="kb-doe">Doe tag</label><input id="kb-doe" autocomplete="off"></div>
            <div class="field"><label for="kb-date">Birth date</label><input type="date" id="kb-date" value="@DateTime.Today.ToString("yyyy-MM-dd")" max="@DateTime.Today.ToString("yyyy-MM-dd")"></div>
            <div class="field"><label for="kb-live">Live kids</label><select id="kb-live">
                @for (var i = 0; i <= BreedingHelper.MaxKidsPerBirth; i++) { <option value="@i" @(i == 1 ? "selected" : null)>@i</option> }</select></div>
            <div class="field"><label for="kb-still">Stillborn</label><input type="number" id="kb-still" min="0" max="@BreedingHelper.MaxKidsPerBirth" value="0"></div>
            <div class="field"><label for="kb-ease">Birth</label><select id="kb-ease">
                <option value="Normal">Normal</option><option value="Assisted">Assisted</option><option value="Difficult">Difficult</option></select></div>
        </div>
        <table class="tbl" style="margin-top:12px"><thead><tr><th>#</th><th>Gender</th><th>Tag (blank = temporary)</th><th>Name</th><th class="num-cell">Birth weight kg</th></tr></thead>
            <tbody id="kb-kids"></tbody></table>
        <div class="field" style="margin-top:10px"><label for="kb-notes">Notes</label><input id="kb-notes" maxlength="1000" placeholder="optional"></div>
        <div class="goat-form-actions" style="margin-top:12px">
            <button type="button" class="btn btn-green" id="kb-save">Save birth</button>
            <button type="button" class="btn btn-ghost" id="kb-cancel">Cancel</button>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/js/breeding-page.js" asp-append-version="true"></script>
<script>GoatRecords.initBreeding();</script>
}
