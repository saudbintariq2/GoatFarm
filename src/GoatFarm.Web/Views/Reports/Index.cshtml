@model GoatFarm.Application.ViewModels.Reports.ReportsPageViewModel
@using GoatFarm.Application.Common

<div class="filterbar" style="margin-bottom:14px">
    <div class="field"><label class="hide-sm">Period</label>
        <select id="rep-period">
            <option value="month" selected="@(Model.Period == "month")">This month</option>
            <option value="year" selected="@(Model.Period == "year")">This year</option>
            <option value="all" selected="@(Model.Period == "all")">All time</option>
            <option value="custom" selected="@(Model.Period == "custom")">Pick dates…</option>
        </select></div>
    <div class="field" id="rep-custom" style="display:@(Model.Period == "custom" ? "flex" : "none")">
        <label class="hide-sm">From</label><input type="date" id="rep-from" value="@Model.CustomFrom">
        <label class="hide-sm">To</label><input type="date" id="rep-to" value="@Model.CustomTo">
    </div>
    <span class="count-pill" id="rep-range">@Model.RangeLabel · @Model.MonthCount month@(Model.MonthCount == 1 ? "" : "s")</span>
</div>

<div class="rep3">
    <div class="fincard"><div class="v" id="rep-expense">@DisplayHelper.FormatRs(Model.TotalExpense)</div>
        <div class="k"><span class="dot" style="background:var(--red)"></span>Total spent</div></div>
    <div class="fincard"><div class="v" id="rep-owner">@DisplayHelper.FormatRs(Model.TotalOwnerInvestment)</div>
        <div class="k"><span class="dot" style="background:var(--amber)"></span>Money you put in</div></div>
    <div class="fincard"><div class="v" id="rep-income">@DisplayHelper.FormatRs(Model.TotalIncome)</div>
        <div class="k"><span class="dot" style="background:var(--green)"></span>Income (sales)</div></div>
    <div class="fincard"><div class="v" id="rep-profit" style="color:@(Model.PreRevenue ? "var(--green-dark)" : Model.ProfitLabel == "Profit" && Model.TotalIncome - Model.TotalExpense < 0 ? "#8a261c" : "var(--green-dark)")">@DisplayHelper.FormatRs(Model.Profit)</div>
        <div class="k"><span class="dot" style="background:var(--blue)"></span><span id="rep-profit-lbl">@Model.ProfitLabel</span></div></div>
</div>

<div class="note" id="rep-note">@Html.Raw(Model.NoteHtml)</div>

<div class="panel">
    <div class="panel-head"><h2>Money you put in</h2><span class="sub">your own funding for this period</span></div>
    <div class="panel-body"><table class="tbl"><thead><tr><th>Date</th><th>Note</th>
        <th class="num-cell">Amount</th></tr></thead>
        <tbody id="repOwnRows">
        @foreach (var row in Model.OwnerRows)
        {
            <tr><td><span class="breed">@row.Date</span></td><td><b>@row.Note</b></td>
                <td class="num-cell" style="color:#8a5b13">@DisplayHelper.FormatRs(row.Amount)</td></tr>
        }
        @if (!Model.OwnerRows.Any()) {<tr><td colspan="3" class="empty">No money added in this period.</td></tr>}
        <tr style="background:var(--amber-tint)"><td style="font-weight:800">TOTAL PUT IN</td><td></td>
            <td class="num-cell" style="font-weight:800;color:#8a5b13">@DisplayHelper.FormatRs(Model.TotalOwnerInvestment)</td></tr>
        </tbody></table></div>
</div>

<div class="panel">
    <div class="panel-head"><h2>Month by month</h2><span class="sub">income, cost and profit each month</span></div>
    <div class="panel-body"><table class="tbl"><thead><tr><th>Month</th>
        <th class="num-cell hide-sm">Income</th><th class="num-cell">Total cost</th>
        <th class="num-cell">Profit</th></tr></thead>
        <tbody id="repMonthRows">
        @foreach (var row in Model.MonthRows)
        {
            <tr><td><b>@row.Month</b></td>
                <td class="num-cell hide-sm" style="color:var(--green-dark)">@DisplayHelper.FormatRs(row.Income)</td>
                <td class="num-cell" style="color:#8a261c">@DisplayHelper.FormatRs(row.Expense)</td>
                <td class="num-cell" style="font-weight:700;color:@(row.Profit < 0 ? "#8a261c" : "var(--green-dark)")">@DisplayHelper.FormatRs(row.Profit)</td></tr>
        }
        </tbody></table></div>
</div>

<div class="panel">
    <div class="panel-head"><h2>Day by day</h2><span class="sub">every day something was recorded</span></div>
    <div class="panel-body"><table class="tbl"><thead><tr><th>Date</th><th class="hide-sm">What happened</th>
        <th class="num-cell hide-sm">In</th><th class="num-cell">Spent</th>
        <th class="num-cell">You put in</th></tr></thead>
        <tbody id="repDayRows">
        @foreach (var row in Model.DayRows)
        {
            <tr><td><span class="breed">@row.Date</span></td><td class="hide-sm">@row.Summary</td>
                <td class="num-cell hide-sm" style="color:var(--green-dark)">@(row.Income > 0 ? DisplayHelper.FormatRs(row.Income) : "—")</td>
                <td class="num-cell" style="color:#8a261c">@(row.Expense > 0 ? DisplayHelper.FormatRs(row.Expense) : "—")</td>
                <td class="num-cell" style="color:#8a5b13">@(row.OwnerInvestment > 0 ? DisplayHelper.FormatRs(row.OwnerInvestment) : "—")</td></tr>
        }
        @if (!Model.DayRows.Any()) {<tr><td colspan="5" class="empty">No dated entries in this period.</td></tr>}
        </tbody></table></div>
</div>

<div class="panel">
    <div class="panel-head"><h2>Expenses by category</h2><span class="sub">where the money went</span></div>
    <div class="panel-body"><table class="tbl"><thead><tr><th>Category</th>
        <th class="hide-sm"></th><th class="num-cell">Amount</th></tr></thead>
        <tbody id="repExpRows">
        @foreach (var row in Model.ExpenseCategories)
        {
            <tr><td><b>@row.Name</b><div class="name">@row.Percent% of costs@(row.Extra)</div></td>
                <td class="hide-sm barcell"><div class="bar" style="width:@(row.BarWidth)%;background:var(--red)"></div></td>
                <td class="num-cell" style="color:#8a261c">@DisplayHelper.FormatRs(row.Amount)</td></tr>
        }
        </tbody></table></div>
</div>

<div class="panel">
    <div class="panel-head"><h2>Income by source</h2><span class="sub">where the money came from</span></div>
    <div class="panel-body"><table class="tbl"><thead><tr><th>Source</th>
        <th class="hide-sm"></th><th class="num-cell">Amount</th></tr></thead>
        <tbody id="repIncRows">
        @foreach (var row in Model.IncomeSources)
        {
            <tr><td><b>@row.Name</b><div class="name">@row.Percent% of income@(row.Extra)</div></td>
                <td class="hide-sm barcell"><div class="bar" style="width:@(row.BarWidth)%"></div></td>
                <td class="num-cell" style="color:var(--green-dark)">@DisplayHelper.FormatRs(row.Amount)</td></tr>
        }
        </tbody></table></div>
</div>

<div class="panel">
    <div class="panel-head"><h2>Expense entries you added</h2><span class="sub">every cost you logged</span></div>
    <div class="panel-body"><table class="tbl"><thead><tr><th>Date</th><th>Type</th>
        <th class="hide-sm">Comment</th><th class="num-cell">Amount</th></tr></thead>
        <tbody id="repExpList">
        @foreach (var row in Model.ExpenseEntries)
        {
            <tr><td><span class="breed">@row.Date</span></td><td>@row.Type</td>
                <td class="hide-sm"><span class="name">@row.Comment</span></td>
                <td class="num-cell" style="color:#8a261c">@DisplayHelper.FormatRs(row.Amount)</td></tr>
        }
        @if (!Model.ExpenseEntries.Any()) {<tr><td colspan="4" class="empty">No manual costs in this period.</td></tr>}
        </tbody></table></div>
</div>

@section Scripts {<script>GoatRecords.initReports();</script>}
