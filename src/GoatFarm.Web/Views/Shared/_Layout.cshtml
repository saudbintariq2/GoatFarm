@inject IConfiguration Configuration

@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery



@using GoatFarm.Domain.Constants

@using System.Security.Claims



@{

    var activeTab = ViewData["ActiveTab"]?.ToString() ?? "";

    var farmName = Configuration["ApplicationSettings:FarmName"] ?? "Goat Records";

    var farmLocation = Configuration["ApplicationSettings:FarmLocation"] ?? "";

    var isAuthenticated = User.Identity?.IsAuthenticated == true;

    var visibleTabs = ViewData["VisibleTabKeys"] as IList<string> ?? Array.Empty<string>();

    var farmPermissionsJson = ViewData["FarmPermissionsJson"]?.ToString() ?? "{}";

    var farmUserRole = ViewData["FarmUserRole"]?.ToString() ?? "";
    var farmUserFullName = ViewData["FarmUserFullName"]?.ToString() ?? "";

    var bodyClass = ViewData["BodyClass"]?.ToString() ?? "";

    var useShell = isAuthenticated && !bodyClass.Contains("auth-page");
    var assistantUiEnabled = Configuration.GetValue<bool>("Features:AssistantEnabled");



    var navItems = new (string Tab, string Controller, string Label, string ActiveKey)[]

    {

        (FarmTabs.Dashboard, "Dashboard", "Dashboard", "dashboard"),

        (FarmTabs.Herd, "Goat", "Herd", "herd"),

        (FarmTabs.Breeding, "Breeding", "Breeding", "breeding"),

        (FarmTabs.Products, "Products", "Products", "products"),

        (FarmTabs.Feed, "Feed", "Feed & Inventory", "feed"),

        (FarmTabs.Trading, "Trading", "Trading", "trading"),

        (FarmTabs.Vaccines, "Vaccine", "Health", "health"),

        (FarmTabs.Finance, "Finance", "Accounting", "finance"),

        (FarmTabs.Projects, "Projects", "Projects & Assets", "projects"),

        (FarmTabs.Reports, "Reports", "Reports", "reports"),

        (FarmTabs.Tasks, "Tasks", "Tasks", "tasks"),

        (FarmTabs.Admin, "Admin", "Users & Audit", "admin"),

        (FarmTabs.Search, "Search", "Search", "search")

    };



    var pageTitles = new Dictionary<string, (string Title, string Sub, string Icon)>(StringComparer.OrdinalIgnoreCase)

    {

        ["dashboard"] = ("Dashboard", "Today at the farm, at a glance", "🏠"),

        ["tasks"] = ("Tasks", "Assign work and follow it through", "✅"),

        ["herd"] = ("The herd", "Manage and track all your goats", "🐐"),

        ["breeding"] = ("Breeding", "Ready → crossed → scan → birth", "💞"),

        ["health"] = ("Vaccines & health", "Schedules, due lists and purchases", "💉"),

        ["products"] = ("Products", "Milk, meat, stock and sales", "🥛"),
        ["trading"] = ("Trading", "Separate buy/sell books", "📦"),
        ["projects"] = ("Projects & assets", "CAPEX, fixed assets, solar", "🏗"),
        ["admin"] = ("Users & audit", "Approvals, audit log, profile", "👥"),
        ["backup"] = ("Backup center", "Export and restore your farm", "💾"),
        ["milk"] = ("Milk", "Collect, sell and account for waste", "🥛"),

        ["feed"] = ("Feed & stock", "Store, usage, plans and recipes", "🌾"),

        ["finance"] = ("Finance", "Money in, money out, salaries", "💰"),

        ["reports"] = ("Reports", "Figures you can export", "📊"),

        ["search"] = ("Search", "Open a goat by tag or RFID", "🔎"),

        ["settings"] = ("Settings", "People, roles and password rules", "⚙️")

    };

    pageTitles.TryGetValue(activeTab, out var pageMeta);



    var displayName = !string.IsNullOrWhiteSpace(farmUserFullName)
        ? farmUserFullName.Trim()
        : User.FindFirst("FullName")?.Value
            ?? User.FindFirst(ClaimTypes.GivenName)?.Value
            ?? (User.Identity?.Name?.Contains('@') == true
                ? User.Identity.Name.Split('@')[0].Replace('.', ' ')
                : User.Identity?.Name ?? "User");

    displayName = System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(displayName.Trim());
    var roleLabel = string.IsNullOrWhiteSpace(farmUserRole) ? "Team member" : farmUserRole.Trim();

    var initials = string.Concat(displayName.Split(' ', StringSplitOptions.RemoveEmptyEntries)

        .Take(2).Select(p => char.ToUpperInvariant(p[0])));

    if (string.IsNullOrEmpty(initials) && !string.IsNullOrEmpty(User.Identity?.Name))

        initials = User.Identity.Name[..Math.Min(2, User.Identity.Name.Length)].ToUpperInvariant();



    var heroTitle = string.IsNullOrEmpty(pageMeta.Title) || activeTab == "dashboard"

        ? farmName

        : pageMeta.Title;

    var heroEyebrow = activeTab == "dashboard" ? "Welcome Back," : farmName;

    var heroTag = activeTab == "dashboard"

        ? "Manage your herd, milk, feed, health and operations — all in one place."

        : (pageMeta.Sub ?? "Goat farm management");

    var brandUpper = farmName.ToUpperInvariant();

}



<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <meta name="csrf-token" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken">

    <title>@farmName — Farm Software</title>

    <link rel="icon" href="~/images/goat-logo.png" type="image/png" asp-append-version="true" />

    <link rel="alternate icon" href="~/images/goat-logo.png" type="image/png" asp-append-version="true" />

    <link rel="preconnect" href="https://fonts.googleapis.com">

    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/css/farm-pro.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/css/goat-records.css" asp-append-version="true" />

    @await RenderSectionAsync("Head", required: false)

</head>

<body class="farm-pro @bodyClass @(useShell ? "has-shell" : "")">

    @if (useShell)

    {

        <a class="skip-link" href="#mainContent">Skip to content</a>

        <div class="shell">

            <aside class="side-nav" id="sideNav" aria-label="Main navigation">

                <div class="side-brand">

                    <div class="logo" aria-hidden="true">
                        @await Html.PartialAsync("_GoatLogoMark")
                    </div>

                    <div class="side-brand-text">

                        <b>@brandUpper</b>

                        <span>GOAT FARM MANAGEMENT</span>

                    </div>

                </div>

                <nav class="side-nav-primary">

                    @foreach (var item in navItems)

                    {

                        if (!visibleTabs.Contains(item.Tab)) { continue; }

                        var isActive = activeTab == item.ActiveKey;

                        <a class="nav-link @(isActive ? "active" : "")" asp-controller="@item.Controller" asp-action="Index"

                           aria-current="@(isActive ? "page" : null)" title="@item.Label">

                            <span class="nav-ico" aria-hidden="true">@await Html.PartialAsync("_NavIcon", item.ActiveKey)</span>

                            <span class="nav-label">@item.Label</span>

                        </a>

                    }

                </nav>

                <div class="side-footer">

                    @if (assistantUiEnabled && visibleTabs.Contains(FarmTabs.Assistant))
                    {
                        <button type="button" class="side-ai-assistant" id="sideAiAssistantBtn" title="AI Assistant" aria-haspopup="dialog" aria-controls="aiAssistantPanel" aria-expanded="false">
                            <span class="side-ai-spark" aria-hidden="true">✦</span>
                            <span class="side-ai-label">AI Assistant</span>
                        </button>
                    }

                    @if (visibleTabs.Contains(FarmTabs.Settings))

                    {

                        <a class="side-footer-link" asp-controller="Settings" asp-action="Index">

                            <span aria-hidden="true">⚙</span> Settings

                        </a>

                    }

                    @if (visibleTabs.Contains(FarmTabs.Backup))

                    {

                        <a class="side-footer-link" asp-controller="BackupCenter" asp-action="Index">

                            <span aria-hidden="true">💾</span> Backup

                        </a>

                    }

                    <a class="side-footer-link" href="#" title="Help documentation coming soon">

                        <span aria-hidden="true">?</span> Help

                    </a>

                    <div class="side-user">

                        <div class="side-user-avatar" aria-hidden="true">@initials</div>

                        <div class="side-user-text">

                            <b class="side-user-name" title="@displayName">@displayName</b>

                            <span class="side-user-role" title="@roleLabel">@roleLabel</span>

                        </div>

                        <form asp-controller="Account" asp-action="Logout" method="post" class="side-user-out">

                            @Html.AntiForgeryToken()

                            <button type="submit" class="side-user-chevron" aria-label="Sign out">›</button>

                        </form>

                    </div>

                </div>

            </aside>

            <div class="nav-scrim" id="navScrim" hidden></div>



            <div class="shell-main">

                <header class="farm-header topbar">

                    <button type="button" class="nav-toggle" id="navToggle" aria-controls="sideNav" aria-expanded="false" aria-label="Show or hide navigation">☰</button>

                    <div class="farm-header-inner">

                        <div class="farm-header-welcome">

                            <p class="farm-header-eyebrow">@heroEyebrow</p>

                            <h1 class="farm-header-title">@heroTitle <span class="farm-header-sun" aria-hidden="true">☀</span></h1>

                            <p class="farm-header-tag">@heroTag</p>

                        </div>

                        <div class="farm-header-tools">

                            @if (visibleTabs.Contains(FarmTabs.Search))

                            {

                                <form class="top-search scanbar farm-header-search" id="globalSearchForm" method="get" asp-controller="Search" asp-action="Index" role="search">

                                    <label for="globalTag" class="sr-only">Scan or enter tag / RFID ID</label>

                                    <span class="scanico" aria-hidden="true">⌕</span>

                                    <input id="globalTag" name="tag" placeholder="Scan or enter tag / RFID ID…" autocomplete="off" spellcheck="false" maxlength="64">

                                    <button type="submit" class="btn btn-green btn-sm global-search-btn">Search</button>

                                </form>

                            }

                            @if (visibleTabs.Contains(FarmTabs.Tasks))

                            {

                                <a class="farm-header-bell" asp-controller="Tasks" asp-action="Index" asp-route-filter="mine" title="My open tasks">

                                    <span aria-hidden="true">🔔</span>

                                    <span class="farm-header-bell-badge" id="headerTaskBadge" hidden>0</span>

                                </a>

                            }

                            @if (visibleTabs.Contains(FarmTabs.Admin))

                            {

                                <a class="farm-header-bell" asp-controller="Admin" asp-action="Index" title="Pending approvals" id="headerNoticesLink">

                                    <span aria-hidden="true">📋</span>

                                    <span class="farm-header-bell-badge" id="headerNotifBadge" hidden>0</span>

                                </a>

                            }

                            <div class="farm-header-datetime" aria-live="polite">

                                <span class="farm-header-cal" aria-hidden="true">📅</span>

                                <div>

                                    <b id="headerClockDate">@DateTime.Now.ToString("ddd, d MMM yyyy")</b>

                                    <span id="headerClockTime">@DateTime.Now.ToString("hh:mm tt")</span>

                                </div>

                            </div>

                        </div>

                    </div>

                </header>

                <main id="mainContent" class="wrap" tabindex="-1">

                    @RenderBody()

                </main>

            </div>

        </div>

    }

    else

    {

        <div class="wrap">

            @RenderBody()

        </div>

    }



    @if (useShell && assistantUiEnabled && visibleTabs.Contains(FarmTabs.Assistant))
    {
        @await Html.PartialAsync("_AssistantPanel")
    }

    <div id="toastHost" class="toast-host" aria-live="polite" aria-atomic="true"></div>



    <div id="appModal" class="modal-overlay" aria-hidden="true">

        <div class="modal-box" role="dialog" aria-modal="true" aria-labelledby="appModalMsg">

            <p class="modal-msg" id="appModalMsg"></p>

            <input type="text" id="appModalInput" class="modal-input" autocomplete="off" />

            <div class="modal-actions">

                <button type="button" class="btn btn-ghost" id="appModalCancel">Cancel</button>

                <button type="button" class="btn btn-green" id="appModalOk">OK</button>

            </div>

        </div>

    </div>



    @if (isAuthenticated)

    {

        <script>

            window.FarmPermissions = @Html.Raw(farmPermissionsJson);

            window.FarmUserRole = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(farmUserRole));

        </script>

    }

    <script src="~/js/goat-records.js" asp-append-version="true"></script>

    @if (useShell)

    {

        <script>

            (() => {

                const tick = () => {

                    const d = new Date();

                    const dateEl = document.getElementById('headerClockDate');

                    const timeEl = document.getElementById('headerClockTime');

                    if (!dateEl || !timeEl) return;

                    dateEl.textContent = d.toLocaleDateString(undefined, { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' });

                    timeEl.textContent = d.toLocaleTimeString(undefined, { hour: '2-digit', minute: '2-digit' });

                };

                tick();

                setInterval(tick, 30000);

            })();

            fetch('/Admin/PendingApprovalCount').then(r => r.ok ? r.json() : null).then(data => {
              const badge = document.getElementById('headerNotifBadge');
              if (!badge || !data || typeof data.count !== 'number') return;
              const n = data.count;
              if (n > 0) { badge.hidden = false; badge.textContent = String(n); }
            }).catch(() => {});

        </script>

    }

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>

