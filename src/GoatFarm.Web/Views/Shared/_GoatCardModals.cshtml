<div class="goat-card-modal modal" id="goatModal" aria-hidden="true">
    <div class="modal-box goat-card-box">
        <div class="modal-head goat-card-head">
            <div id="gmTitle">Goat</div>
            <button type="button" id="gmClose" class="goat-card-close" title="Close">✕</button>
        </div>
        <div class="modal-body goat-card-body" id="gmBody"></div>
        <div class="modal-foot goat-card-foot">
            <div class="gm-actions" id="gmActions"></div>
        </div>
    </div>
</div>
<div class="goat-card-modal modal" id="askModal" aria-hidden="true">
    <div class="modal-box">
        <div class="modal-head" id="askTitle">Enter details</div>
        <div class="modal-body" id="askBody"></div>
        <div class="modal-foot">
            <button type="button" class="btn btn-ghost" id="askCancel">Cancel</button>
            <button type="button" class="btn btn-green" id="askOk">Save</button>
        </div>
    </div>
</div>
