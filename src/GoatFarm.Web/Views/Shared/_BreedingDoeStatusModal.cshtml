<div class="goat-card-modal modal breed-st-modal" id="doeStatusModal" aria-hidden="true">
    <div class="modal-box breed-st-sheet" role="dialog" aria-modal="true" aria-labelledby="doeStTitle">
        <div class="modal-head breed-st-head">
            <h2 id="doeStTitle">Change status</h2>
            <button type="button" class="btn btn-ghost btn-sm" data-doe-st-close>Close</button>
        </div>
        <div class="modal-body breed-st-body">
            <div id="doeStFrom" class="breed-st-from"></div>
            <div class="breed-eyebrow">Move her to</div>
            <div class="breed-st-opts" id="doeStPick"></div>
            <div id="doeStFields"></div>
        </div>
        <div class="modal-foot breed-st-foot">
            <button type="button" class="btn btn-green" id="doeStSave" disabled>Save</button>
            <button type="button" class="btn btn-ghost" data-doe-st-close>Cancel</button>
        </div>
    </div>
</div>