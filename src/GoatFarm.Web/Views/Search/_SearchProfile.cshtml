@model GoatFarm.Application.ViewModels.Search.GoatCardViewModel
@using GoatFarm.Domain.Enums

@{
    var g = Model.Goat;
    var gender = g.Gender == GoatGender.Male ? "Male" : "Female";
    var source = g.Source == GoatSource.Born ? "Born on farm" : "Bought";
}

<div class="panel">
    <div class="panel-body">
        <div class="search-hero">
            <div class="search-hero-main">
                <h2><a href="#" class="tag" data-goatcard="@g.Id">@g.Tag</a></h2>
                @if (!string.IsNullOrEmpty(g.Name))
                {
                    <div class="name">@g.Name</div>
                }
                <span class="chip @g.StatusCssClass">@g.StatusDisplay</span>
                @if (g.IsArchived)
                {
                    <div class="note" style="margin-top:10px">Record closed — @(g.ArchivedReason ?? "archived")@(g.ArchivedDateDisplay is not null ? $" on {g.ArchivedDateDisplay}" : "").</div>
                }
                @if (!string.IsNullOrEmpty(g.KidStageLine))
                {
                    <div class="name" style="color:@(g.KidStageColor ?? "var(--ink-soft)");font-weight:700;margin-top:6px">@g.KidStageLine</div>
                }
                @if (!string.IsNullOrEmpty(g.BreedingHint))
                {
                    <div class="breed" style="color:@(g.BreedingHintColor ?? "var(--ink-soft)");font-weight:600;margin-top:4px">@g.BreedingHint</div>
                }
                <div class="search-hero-meta">
                    <div class="search-meta-item">Breed<b>@g.Breed</b></div>
                    <div class="search-meta-item">Gender<b>@gender</b></div>
                    <div class="search-meta-item">Age<b>@g.AgeLabel</b></div>
                    <div class="search-meta-item">Health<b>@g.HealthDisplay</b></div>
                    <div class="search-meta-item">Group<b>@(g.GroupName ?? "—")</b></div>
                    @if (!string.IsNullOrEmpty(g.FeedingGroupName))
                    {
                        <div class="search-meta-item">Feed group<b>@g.FeedingGroupName</b></div>
                    }
                    <div class="search-meta-item">Source<b>@source</b></div>
                    <div class="search-meta-item">Price<b>@g.PriceDisplay</b></div>
                    <div class="search-meta-item">@(g.Source == GoatSource.Born ? "Born" : "Bought on")<b>@g.EventDateDisplay</b></div>
                    @if (g.DateOfBirth.HasValue)
                    {
                        <div class="search-meta-item">Date of birth<b>@g.DateOfBirthDisplay@(g.DateOfBirthIsEstimated ? " (estimated)" : "")</b></div>
                    }
                    @if (!string.IsNullOrEmpty(g.SireTag) || !string.IsNullOrEmpty(g.DamTag))
                    {
                        <div class="search-meta-item">Parents<b>@(g.SireTag is not null ? "♂ " + g.SireTag : "—") · @(g.DamTag is not null ? "♀ " + g.DamTag : "—")</b></div>
                    }
                    @if (!string.IsNullOrEmpty(g.Owner))
                    {
                        <div class="search-meta-item">Owner<b>@g.Owner</b></div>
                    }
                    @if (Model.LatestWeightKg is not null)
                    {
                        <div class="search-meta-item">Latest weight<b>@Model.LatestWeightKg.Value.ToString("F1") kg</b></div>
                    }
                    @if (Model.LatestBcsScore is not null)
                    {
                        <div class="search-meta-item">Body condition<b>@Model.LatestBcsScore/5@(Model.LatestBcsDateDisplay is not null ? $" ({Model.LatestBcsDateDisplay})" : "")</b></div>
                    }
                    @if (g.MatedDate.HasValue)
                    {
                        <div class="search-meta-item">Last cross<b>@g.MatedDateDisplay@(g.BuckTag is not null ? " · " + g.BuckTag : "")</b></div>
                    }
                    @if (g.KidsCount is not null)
                    {
                        <div class="search-meta-item">Scan<b>@g.KidsCount kid(s)@(g.UltrasoundDateDisplay is not null ? " · " + g.UltrasoundDateDisplay : "")</b></div>
                    }
                </div>
                @if (!string.IsNullOrEmpty(g.Comment))
                {
                    <div class="breed" style="margin-top:10px"><b>Note:</b> @g.Comment</div>
                }
            </div>
            <div style="display:flex;flex-direction:column;gap:8px;align-items:flex-start">
                <a class="btn btn-green" href="#" data-goatcard="@g.Id">Open goat card</a>
                <a class="btn btn-ghost" asp-controller="Goat" asp-action="Index" asp-route-editId="@g.Id">Edit in Herd</a>
            </div>
        </div>
    </div>
</div>

@if (Model.Siblings.Count > 0)
{
<div class="panel">
    <div class="panel-head"><h2>Siblings</h2></div>
    <div class="panel-body">
        <div style="display:flex;gap:6px;flex-wrap:wrap">
            @foreach (var s in Model.Siblings)
            {
                <span style="background:var(--green-tint);border-radius:8px;padding:4px 9px;font-size:13px">
                    <a href="/Search?tag=@Uri.EscapeDataString(s.Tag)" class="tag tag-link">@s.Tag</a>
                    <span class="breed">@(s.Gender == "Male" ? "♂" : "♀") @s.BirthDateDisplay@(s.Twin ? " · twin" : "")</span>
                </span>
            }
        </div>
    </div>
</div>
}

@if (g.Gender == GoatGender.Female && g.Status != GoatStatus.Kid)
{
<div class="panel">
    <div class="panel-head"><h2>Breeding record</h2></div>
    <div class="panel-body">
        @{
            var liveKids = Model.Kiddings.Sum(k => k.LiveKids);
        }
        <div class="breed" style="margin-bottom:8px">@Model.Kiddings.Count birth(s) · @liveKids kids born alive · @Model.EmptyScanCount empty scan(s) · @Model.AbortionCount abortion(s)</div>
        @if (Model.Kiddings.Count == 0)
        {
            <div class="search-empty">No kiddings recorded yet.</div>
        }
        else
        {
            <table class="tbl">
                <thead><tr><th>Date</th><th>Sire</th><th class="num-cell">Alive</th><th class="num-cell">Stillborn</th></tr></thead>
                <tbody>
                @foreach (var k in Model.Kiddings)
                {
                    <tr>
                        <td>@k.DateDisplay</td>
                        <td>@if (k.SireGoatId is not null && !string.IsNullOrEmpty(k.SireTag)){<a class="tag tag-link" href="/Search?tag=@Uri.EscapeDataString(k.SireTag!)">@k.SireTag</a>}else{@(k.SireTag ?? "—")}</td>
                        <td class="num-cell">@k.LiveKids</td>
                        <td class="num-cell">@k.Stillborn</td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>
</div>
}
else if (g.Gender == GoatGender.Male)
{
<div class="panel">
    <div class="panel-head"><h2>As a sire</h2></div>
    <div class="panel-body"><div class="breed">@Model.SiredKidsCount kid(s) sired on this farm.</div></div>
</div>
}

@if (Model.Weights.Count > 0)
{
<div class="panel">
    <div class="panel-head"><h2>Weight history</h2></div>
    <div class="panel-body">
        <table class="tbl">
            <thead><tr><th>Date</th><th class="num-cell">kg</th></tr></thead>
            <tbody>
            @foreach (var w in Model.Weights)
            {
                <tr><td>@w.DateDisplay</td><td class="num-cell">@w.Kg.ToString("F1")</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
}

@if (Model.Pedigree.Count > 1)
{
<div class="panel" id="family-tree">
    <div class="panel-head"><h2>Family tree</h2><span class="sub">ancestors (up to 4 generations)</span></div>
    <div class="panel-body">
        <table class="tbl">
            <thead><tr><th>Gen</th><th>Tag</th><th class="hide-sm">Sire</th><th class="hide-sm">Dam</th></tr></thead>
            <tbody>
            @foreach (var p in Model.Pedigree)
            {
                <tr>
                    <td>@p.Generation</td>
                    <td>@if (p.Generation == 0){<span class="tag">@p.Tag</span>}else if (!string.IsNullOrEmpty(p.SearchTag)){<a class="tag tag-link" href="/Search?tag=@Uri.EscapeDataString(p.SearchTag)">@p.Tag</a>}else{@p.Tag}</td>
                    <td class="hide-sm">@(p.SireTag ?? "—")</td>
                    <td class="hide-sm">@(p.DamTag ?? "—")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
}

@if (Model.BreedingHistory.Count > 0)
{
<div class="panel">
    <div class="panel-head"><h2>Breeding history</h2></div>
    <div class="panel-body">
        <table class="tbl">
            <thead><tr><th>Mated</th><th>Buck</th><th>Outcome</th></tr></thead>
            <tbody>
            @foreach (var b in Model.BreedingHistory)
            {
                <tr><td>@b.MatedDisplay</td><td>@(b.BuckTag ?? "—")</td><td>@b.Outcome</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
}

<div class="panel">
    <div class="panel-head"><h2>Treatment history</h2></div>
    <div class="panel-body">
        @if (Model.Treatments.Count == 0)
        {
            <div class="search-empty">No treatments recorded for this goat.</div>
        }
        else
        {
            <table class="tbl">
                <thead><tr><th>Start</th><th>End</th><th>Problem</th><th class="hide-sm">Medicine</th><th class="num-cell hide-sm">Cost</th><th>Status</th></tr></thead>
                <tbody>
                @foreach (var t in Model.Treatments)
                {
                    <tr>
                        <td>@t.StartDateDisplay</td>
                        <td>@t.EndDateDisplay</td>
                        <td>@t.Diagnosis</td>
                        <td class="hide-sm">@t.Medicine</td>
                        <td class="num-cell hide-sm">@(t.Cost > 0 ? "Rs " + Math.Round(t.Cost).ToString("N0") : "—")</td>
                        <td><span class="chip @(t.IsActive ? "chip-exp" : "chip-milk")">@(t.IsActive ? "Active" : "Ended")</span></td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>
</div>

<div class="panel">
    <div class="panel-head"><h2>Vaccine schedule</h2></div>
    <div class="panel-body">
        @if (Model.VaccineSchedule.Count == 0)
        {
            <div class="search-empty">No vaccines apply to this goat's status.</div>
        }
        else
        {
            <table class="tbl">
                <thead><tr><th>Vaccine</th><th class="hide-sm">Rule</th><th>Status</th><th class="hide-sm">Last</th><th class="hide-sm">Next</th></tr></thead>
                <tbody>
                @foreach (var v in Model.VaccineSchedule)
                {
                    <tr>
                        <td>@v.VaccineName</td>
                        <td class="hide-sm">@v.RuleDisplay</td>
                        <td><span class="chip @v.StatusCss">@v.Status</span></td>
                        <td class="hide-sm">@(v.LastDate ?? "—")</td>
                        <td class="hide-sm">@(v.DueDate ?? "—")</td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>
</div>

<div class="panel">
    <div class="panel-head"><h2>Vaccination history</h2></div>
    <div class="panel-body">
        @if (Model.VaccinationHistory.Count == 0)
        {
            <div class="search-empty">No vaccinations recorded yet for this goat.</div>
        }
        else
        {
            <table class="tbl">
                <thead><tr><th>Date</th><th>Vaccine</th><th class="hide-sm">Scope</th></tr></thead>
                <tbody>
                @foreach (var h in Model.VaccinationHistory)
                {
                    <tr>
                        <td>@h.DateDisplay</td>
                        <td>@h.VaccineName</td>
                        <td class="hide-sm">@h.ScopeDisplay</td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>
</div>

<div class="panel">
    <div class="panel-head"><h2>Feed plan</h2></div>
    <div class="panel-body">
        @if (Model.FeedPlan is null)
        {
            <div class="search-empty">No feed plan set for this status.</div>
        }
        else
        {
            var plan = Model.FeedPlan;
            <div class="note" style="margin-bottom:12px">Based on the <b>@plan.StatusDisplay</b> feed plan (farm-level ration per goat).</div>
            <table class="tbl">
                <thead><tr><th>Feed</th><th class="num-cell">Daily</th><th class="num-cell hide-sm">Cost/day</th></tr></thead>
                <tbody>
                @if (plan.MixKgPerDay <= 0 && plan.FodderKgPerDay <= 0)
                {
                    <tr><td colspan="3" class="search-empty">No rations configured.</td></tr>
                }
                else
                {
                    @if (plan.MixKgPerDay > 0)
                    {
                        <tr><td>Mix (concentrate)</td><td class="num-cell">@plan.MixKgPerDay.ToString("F2") kg</td>
                            <td class="num-cell hide-sm">Rs @Math.Round(plan.DailyFeedCost).ToString("N0")</td></tr>
                    }
                    @if (plan.FodderKgPerDay > 0)
                    {
                        <tr><td>Green fodder (own)</td><td class="num-cell">@plan.FodderKgPerDay.ToString("F1") kg</td>
                            <td class="num-cell hide-sm"><span class="breed">not costed</span></td></tr>
                    }
                }
                </tbody>
            </table>
            <div style="margin-top:12px;font-size:14px">
                <span><b>Daily feed:</b> Rs @Math.Round(plan.DailyFeedCost).ToString("N0")</span> ·
                <span><b>Medicine/mo:</b> Rs @Math.Round(plan.MedicineCostPerGoatPerMonth).ToString("N0")</span> ·
                <span><b>Est. monthly:</b> Rs @Math.Round(plan.MonthlyTotalCost).ToString("N0")</span>
            </div>
        }
    </div>
</div>

<div class="panel">
    <div class="panel-head"><h2>Reminders</h2></div>
    <div class="panel-body">
        @if (Model.Reminders.Count == 0)
        {
            <div class="search-empty">No reminders for this goat.</div>
        }
        else
        {
            <ul style="margin:0;padding-left:18px;line-height:1.7">
                @foreach (var r in Model.Reminders)
                {
                    <li>
                        <span style="color:@r.WhenColor;font-weight:600">@r.WhenDisplay</span> — @r.Title
                        @if (!string.IsNullOrEmpty(r.ScopeDisplay))
                        {
                            <span class="breed">(@r.ScopeDisplay)</span>
                        }
                        <span class="breed">· @r.DateDisplay</span>
                    </li>
                }
            </ul>
        }
    </div>
</div>

<div class="note">Milk production is tracked at farm level on the Milk tab, not per individual goat.</div>
