@model GoatFarm.Web.Models.LoginViewModel
@inject IConfiguration Configuration
@inject IWebHostEnvironment Env
@using GoatFarm.Infrastructure.Identity
@{
    ViewData["Title"] = "Login";
    ViewData["BodyClass"] = "auth-page";
    Layout = "_Layout";
    var farmName = Configuration["ApplicationSettings:FarmName"] ?? "Goat Records";
    var farmLocation = Configuration["ApplicationSettings:FarmLocation"] ?? "";
}

<div class="login-page">
    <aside class="login-hero" aria-hidden="true">
        <div class="logo">@await Html.PartialAsync("_GoatLogoMark")</div>
        <h2>@farmName — farm management, simplified</h2>
        <p>Track herd, breeding, milk, feed, tasks and finances in one place built for goat farms.</p>
    </aside>
    <div class="login-side">
    <div class="login-card panel">
        <div class="login-brand login-brand-mobile">
            <div class="logo">@await Html.PartialAsync("_GoatLogoMark")</div>
            <div>
                <h1>@farmName</h1>
                @if (!string.IsNullOrWhiteSpace(farmLocation))
                {
                    <p>@farmLocation</p>
                }
            </div>
        </div>
        <div class="panel-body">
            <h2 class="login-title">Sign in</h2>
            @if (Env.IsDevelopment())
            {
                <p class="note login-hint">Local dev accounts (passwords reset on app startup):<br/>
                    <b>@IdentitySeedHelper.DefaultAdminEmail</b> / @IdentitySeedHelper.DefaultAdminPassword<br/>
                    <b>@IdentitySeedHelper.DevUserEmail</b> / @IdentitySeedHelper.DevUserPassword</p>
            }
            <form asp-action="Login" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ReturnUrl" />
                <div asp-validation-summary="ModelOnly" class="login-error"></div>
                <div class="login-fields">
                    <div class="field">
                        <label asp-for="Email">Email</label>
                        <input asp-for="Email" type="email" autocomplete="username" placeholder="admin@goatfarm.local" />
                    </div>
                    <div class="field">
                        <label asp-for="Password">Password</label>
                        <div class="pw-wrap">
                            <input asp-for="Password" type="password" autocomplete="current-password" />
                            <button type="button" class="btn btn-ghost btn-sm pw-toggle" id="pwToggle"
                                    aria-controls="Password" aria-pressed="false">Show</button>
                        </div>
                    </div>
                    <label class="login-remember">
                        <input asp-for="RememberMe" type="checkbox" /> Keep me signed in on this device
                    </label>
                </div>
                <div class="goat-form-actions login-actions">
                    <button type="submit" class="btn btn-green login-submit">Sign in</button>
                </div>
            </form>
        </div>
    </div>
    </div>
</div>

@section Scripts {
<script>
    (() => {
        const btn = document.getElementById('pwToggle');
        const input = document.getElementById('Password');
        btn?.addEventListener('click', () => {
            const show = input.type === 'password';
            input.type = show ? 'text' : 'password';
            btn.textContent = show ? 'Hide' : 'Show';
            btn.setAttribute('aria-pressed', String(show));
        });
    })();
</script>
}
