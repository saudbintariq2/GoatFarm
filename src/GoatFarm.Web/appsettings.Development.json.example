{
  "ConnectionStrings": {
    "DefaultConnection": "Host=127.0.0.1;Port=55432;Database=GoatFarmDb;Username=postgres",
    "DemoConnection": "Host=127.0.0.1;Port=55432;Database=GoatFarmDemo;Username=postgres"
  },
  "Seed": {
    "ResetAdminPassword": true,
    "EnsureDevUser": true,
    "DemoData": true,
    "ReloadDemoData": false,
    "ClearFarmData": false
  },
  "LocalDev": {
    "DisablePermissionChecks": true
  },
  "Demo": {
    "Enabled": false
  },
  "OpenAI": {
    "Model": "gpt-4.1-mini",
    "TimeoutSeconds": 60,
    "MaxOutputTokens": 2048
  },
  "_comment": "Option A: run scripts/start-local-postgres.ps1 (trust auth, port 55432). Option B: use PostgreSQL on 5432 with Password=YOUR_PASSWORD. Turn off LocalDev:DisablePermissionChecks after permissions are fixed. Set OpenAI__ApiKey in the environment; never commit a real key."
}
