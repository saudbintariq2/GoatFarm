{
  "ConnectionStrings": {
    "DefaultConnection": "Host=127.0.0.1;Port=55432;Database=GoatFarmDb;Username=postgres"
  },
  "Seed": {
    "ResetAdminPassword": true,
    "EnsureDevUser": true
  },
  "LocalDev": {
    "DisablePermissionChecks": true
  },
  "_comment": "Option A: run scripts/start-local-postgres.ps1 (trust auth, port 55432). Option B: use PostgreSQL on 5432 with Password=YOUR_PASSWORD. Turn off LocalDev:DisablePermissionChecks after permissions are fixed."
}
